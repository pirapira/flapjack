fun 1 add1(1 a, 1 b) { return a + b; }
fun {1,1} pair(1 a, 1 b) { return <a, b>; }
fun 1 byte_dec(1 n) {
  var 1 y = (ld8 1008);
  var {1,1} p = pair(1, 2);
  while (n > 0) { if (1 >= p.1) { } }
  return add1(p.1, y);
}
fun 1 word32_dec(1 n) {
  var 1 y = (ld32 1008);
  var {1,1} p = pair(3, 4);
  while (n > 0) { if (1 >= p.1) { } }
  return add1(p.1, y);
}
fun 1 compare_dec(1 n) {
  var 1 y = ((lds 1 1008) < (lds 1 1016));
  var {1,1} p = pair(5, 6);
  while (n > 0) { if (1 >= p.1) { } }
  return add1(p.1, y);
}
fun 1 multiply_dec(1 n) {
  var 1 y = ((lds 1 1008) * (n + 7));
  var {1,1} p = pair(7, 8);
  while (n > 0) { if (1 >= p.1) { } }
  return add1(p.1, y);
}
fun 1 main() {
  var 1 a = byte_dec(1);
  var 1 b = word32_dec(1);
  var 1 c = compare_dec(1);
  var 1 d = multiply_dec(1);
  @halt(@base, 0, @base, 0);
  return a + b + c + d;
}
