fun 1 bit_test(1 n, 1 k) { return ((n >>> k) & 1) + 1; }
fun 1 or_immediate(1 n, 1 k) { return ((n >>> k) | 7) + 1; }
fun 1 xor_immediate(1 n, 1 k) { return ((n >>> k) ^ 255) + 1; }
fun 1 wide_mask(1 n, 1 k) { return ((n & 72057594037927935) << 8) + 1; }
fun 1 wide_or(1 n, 1 k) { return ((n | 72057594037927935) << 8) + 1; }
fun 1 sub_immediate(1 n, 1 k) { return ((n >>> k) - 3) + 1; }
fun 1 main() {
  var 1 a = bit_test(1024, 3);
  var 1 b = or_immediate(1024, 3);
  var 1 c = xor_immediate(1024, 3);
  var 1 d = wide_mask(1024, 3);
  var 1 e = wide_or(1024, 3);
  var 1 f = sub_immediate(1024, 3);
  @halt(@base, 0, @base, 0);
  return a + b + c + d + e + f;
}
