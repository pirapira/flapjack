  t = __add_with_carry__(acc, p22.1, 0); acc = t.0; hi = hi + t.1;
  t = __add_with_carry__(acc, p31.1, 0); acc = t.0; hi = hi + t.1;
  t = __add_with_carry__(acc, p23.0, 0); acc = t.0; hi = hi + t.1;
