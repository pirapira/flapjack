  t = __add_with_carry__(acc, p20.0, 0); acc = t.0; hi = hi + t.1;
  var r2 = acc;
  acc = hi; hi = 0;
  t = __add_with_carry__(acc, p02.1, 0); acc = t.0; hi = hi + t.1;
  t = __add_with_carry__(acc, p11.1, 0); acc = t.0; hi = hi + t.1;
  t = __add_with_carry__(acc, p20.1, 0); acc = t.0; hi = hi + t.1;
  t = __add_with_carry__(acc, p03.0, 0); acc = t.0; hi = hi + t.1;
  t = __add_with_carry__(acc, p12.0, 0); acc = t.0; hi = hi + t.1;
  t = __add_with_carry__(acc, p21.0, 0); acc = t.0; hi = hi + t.1;
  t = __add_with_carry__(acc, p30.0, 0); acc = t.0; hi = hi + t.1;
  var r3 = acc;
  acc = hi; hi = 0;
  t = __add_with_carry__(acc, p03.1, 0); acc = t.0; hi = hi + t.1;
  t = __add_with_carry__(acc, p12.1, 0); acc = t.0; hi = hi + t.1;
  t = __add_with_carry__(acc, p21.1, 0); acc = t.0; hi = hi + t.1;
  t = __add_with_carry__(acc, p30.1, 0); acc = t.0; hi = hi + t.1;
