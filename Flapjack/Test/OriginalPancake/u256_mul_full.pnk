  var {1,1} t = <0, 0>;
  var acc = 0;
  var hi = 0;
  var r0 = p00.0;
  acc = p00.1;
  t = __add_with_carry__(acc, p01.0, 0); acc = t.0; hi = hi + t.1;
  t = __add_with_carry__(acc, p10.0, 0); acc = t.0; hi = hi + t.1;
  var r1 = acc;
  acc = hi; hi = 0;
  t = __add_with_carry__(acc, p01.1, 0); acc = t.0; hi = hi + t.1;
