def consInfo : StructInfo := { fields := [("f", Shape.one)], size := 1 }

example : structInfosOk ((("S" : StructName), consInfo) :: ([] : StructContext)) :=
  structInfosOk_cons [] "S" consInfo
    (by unfold structInfosOk; refine ⟨?_, ?_, ?_, ?_⟩ <;> simp)
