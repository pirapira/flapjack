  (afindi "a" ([ ("a", 10), ("b", 20) ] : List (String × Nat)) == some 0) &&
    (0 < ([ ("a", 10), ("b", 20) ] : List (String × Nat)).length) &&
  (afindi "c" entries == some 2) && (2 < entries.length)

#eval holAfIndiLengthGuard
#guard holAfIndiLengthGuard

