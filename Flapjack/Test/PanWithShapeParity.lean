import Flapjack.Language

/-!
# Original-domain parity for `panLang$with_shape`

The source definition is `cakeml/pancake/panLangScript.sml:216-219`.
Expected observations are generated by
`scripts/hol-probes/pan_lang_with_shape_probeScript.sml`.
-/

namespace Flapjack.Test.PanWithShapeParity

open Flapjack

def emptyShapes : List (List Nat) := []
def oneCombNamed : List Shape := [.one, .comb [.one, .one], .named "n"]
def shortShapes : List Shape := [.comb [.one, .one], .one]

#guard withShape ([] : List Shape) [1, 2, 3] == emptyShapes
#guard withShape oneCombNamed [1, 2, 3, 4, 5] ==
  [[1], [2, 3], [4]]
#guard withShape shortShapes [7] == [[7], []]

def check (name : String) (actual expected : List (List Nat)) : IO Bool := do
  if actual == expected then
    IO.println s!"PASS {name}"
    pure true
  else
    IO.println s!"FAIL {name}: expected {repr expected}, got {repr actual}"
    pure false

def runChecks : IO Bool := do
  let results ← [
    check "pan with_shape empty" (withShape [] [1, 2, 3]) [],
    check "pan with_shape one/comb/named"
      (withShape oneCombNamed [1, 2, 3, 4, 5]) [[1], [2, 3], [4]],
    check "pan with_shape short input"
      (withShape shortShapes [7]) [[7], []] ].mapM id
  pure (results.all id)

end Flapjack.Test.PanWithShapeParity
