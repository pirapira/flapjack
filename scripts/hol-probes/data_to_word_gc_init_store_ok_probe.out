init_store_ok_def_statement=∀c store m dm code_buffer data_buffer. init_store_ok c store m dm code_buffer data_buffer ⇔ ∃limit curr. limit ≤ max_heap_limit (:α) c ∧ FLOOKUP store Globals = SOME (Word 0w) ∧ FLOOKUP store GlobReal = SOME (Word curr) ∧ FLOOKUP store GenStart = SOME (Word 0w) ∧ FLOOKUP store CurrHeap = SOME (Word curr) ∧ FLOOKUP store OtherHeap = FLOOKUP store EndOfHeap ∧ FLOOKUP store NextFree = SOME (Word curr) ∧ FLOOKUP store EndOfHeap = SOME (Word (curr + bytes_in_word * n2w limit)) ∧ FLOOKUP store TriggerGC = SOME (Word (case c.gc_kind of None => curr + bytes_in_word * n2w limit | Simple => curr + bytes_in_word * n2w limit | Generational v1 => curr)) ∧ FLOOKUP store HeapLength = SOME (Word (bytes_in_word * n2w limit)) ∧ FLOOKUP store CodeBuffer = SOME (Word code_buffer.position) ∧ FLOOKUP store CodeBufferEnd = SOME (Word (code_buffer.position + n2w code_buffer.space_left)) ∧ FLOOKUP store BitmapBuffer = SOME (Word data_buffer.position) ∧ FLOOKUP store BitmapBufferEnd = SOME (Word (data_buffer.position + bytes_in_word * n2w data_buffer.space_left)) ∧ code_buffer.buffer = [] ∧ data_buffer.buffer = [] ∧ word_list_exists curr (limit + limit) (fun2set (m,dm)) ∧ byte_aligned curr
init_store_ok_def_statement_typed=∀(c :data_to_word$config) (store :store_name |-> α word_loc) (m :α word -> β) (dm :α word -> bool) (code_buffer :(α, γ) buffer) (data_buffer :(α, δ) buffer). init_store_ok c store m dm code_buffer data_buffer ⇔ ∃(limit :num) (curr :α word). limit ≤ max_heap_limit (:α) c ∧ FLOOKUP store Globals = SOME (Word (0w :α word)) ∧ FLOOKUP store GlobReal = SOME (Word curr) ∧ FLOOKUP store GenStart = SOME (Word (0w :α word)) ∧ FLOOKUP store CurrHeap = SOME (Word curr) ∧ FLOOKUP store OtherHeap = FLOOKUP store EndOfHeap ∧ FLOOKUP store NextFree = SOME (Word curr) ∧ FLOOKUP store EndOfHeap = SOME (Word (curr + (bytes_in_word :α word) * (n2w limit :α word))) ∧ FLOOKUP store TriggerGC = SOME (Word (case c.gc_kind of None => curr + (bytes_in_word :α word) * (n2w limit :α word) | Simple => curr + (bytes_in_word :α word) * (n2w limit :α word) | Generational v1 => curr)) ∧ FLOOKUP store HeapLength = SOME (Word ((bytes_in_word :α word) * (n2w limit :α word))) ∧ FLOOKUP store CodeBuffer = SOME (Word code_buffer.position) ∧ FLOOKUP store CodeBufferEnd = SOME (Word (code_buffer.position + (n2w code_buffer.space_left :α word))) ∧ FLOOKUP store BitmapBuffer = SOME (Word data_buffer.position) ∧ FLOOKUP store BitmapBufferEnd = SOME (Word (data_buffer.position + (bytes_in_word :α word) * (n2w data_buffer.space_left :α word))) ∧ code_buffer.buffer = ([] :γ word list) ∧ data_buffer.buffer = ([] :δ word list) ∧ word_list_exists curr (limit + limit) (fun2set (m,dm)) ∧ byte_aligned curr
init_store_ok_def_statement_types=(c :data_to_word$config)::data_to_word$config;(store :store_name |-> α word_loc)::store_name |-> α word_loc;(m :α word -> β)::α word -> β;(dm :α word -> bool)::α word -> bool;(code_buffer :(α, γ) buffer)::(α, γ) buffer;(data_buffer :(α, δ) buffer)::(α, δ) buffer;
gc_fun_ok_word_gc_fun_statement=gc_fun_ok (word_gc_fun c1)
gc_fun_ok_word_gc_fun_statement_typed=gc_fun_ok (word_gc_fun (c1 :data_to_word$config) :α word_loc list # (α word -> α word_loc) # (α word -> bool) # (store_name |-> α word_loc) -> (α word_loc list # (α word -> α word_loc) # (store_name |-> α word_loc)) option)
gc_fun_ok_word_gc_fun_statement_types=(c1 :data_to_word$config)::data_to_word$config;
