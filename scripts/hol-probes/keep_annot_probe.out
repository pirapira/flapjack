annotation=tok
  (λt.
       case t of
         AndT => F
       | OrT => F
       | BoolAndT => F
       | BoolOrT => F
       | XorT => F
       | NotT => F
       | ArrowT => F
       | EqT => F
       | NeqT => F
       | LessT => F
       | GreaterT => F
       | GeqT => F
       | LeqT => F
       | LowerT => F
       | HigherT => F
       | HigheqT => F
       | LoweqT => F
       | PlusT => F
       | MinusT => F
       | DotT => F
       | StarT => F
       | LslT => F
       | LsrT => F
       | AsrT => F
       | RorT => F
       | IntT v6 => F
       | IdentT v7 => F
       | ForeignIdent v8 => F
       | LParT => F
       | RParT => F
       | CommaT => F
       | SemiT => F
       | ColonT => F
       | AddrT => F
       | LBrakT => F
       | RBrakT => F
       | LCurT => F
       | RCurT => F
       | AssignT => F
       | StaticT => F
       | NoinlineT => F
       | DefaultShT => F
       | KeywordT v9 => F
       | AnnotCommentT v10 => T
       | LexErrorT v11 => F) mkleaf
