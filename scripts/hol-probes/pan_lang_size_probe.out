mlstring_size_def : ⊢ ∀a. mlstring_size (implode a) = 1 + list_size char_size a
shape_size_def : ⊢ shape_size One = 0 ∧ (∀a. shape_size (Comb a) = 1 + shape1_size a) ∧
  (∀a. shape_size (Named a) = 1 + mlstring_size a) ∧ shape1_size [] = 0 ∧
  ∀a0 a1. shape1_size (a0::a1) = 1 + (shape_size a0 + shape1_size a1)
exp_size_def : ⊢ (∀f a. exp_size f (Const a) = 1 + w2n a) ∧
  (∀f a0 a1.
     exp_size f (Var a0 a1) = 1 + (varkind_size a0 + mlstring_size a1)) ∧
  (∀f a. exp_size f (RStruct a) = 1 + exp3_size f a) ∧
  (∀f a0 a1. exp_size f (RField a0 a1) = 1 + (a0 + exp_size f a1)) ∧
  (∀f a0 a1.
     exp_size f (NStruct a0 a1) = 1 + (mlstring_size a0 + exp1_size f a1)) ∧
  (∀f a0 a1.
     exp_size f (NField a0 a1) = 1 + (mlstring_size a0 + exp_size f a1)) ∧
  (∀f a0 a1. exp_size f (Load a0 a1) = 1 + (shape_size a0 + exp_size f a1)) ∧
  (∀f a. exp_size f (Load32 a) = 1 + exp_size f a) ∧
  (∀f a. exp_size f (LoadByte a) = 1 + exp_size f a) ∧
  (∀f a0 a1. exp_size f (Op a0 a1) = 1 + (binop_size a0 + exp3_size f a1)) ∧
  (∀f a0 a1. exp_size f (Panop a0 a1) = 1 + (panop_size a0 + exp3_size f a1)) ∧
  (∀f a0 a1 a2.
     exp_size f (Cmp a0 a1 a2) =
     1 + (cmp_size a0 + (exp_size f a1 + exp_size f a2))) ∧
  (∀f a0 a1 a2.
     exp_size f (Shift a0 a1 a2) =
     1 + (shift_size a0 + (exp_size f a1 + exp_size f a2))) ∧
  (∀f. exp_size f BaseAddr = 0) ∧ (∀f. exp_size f TopAddr = 0) ∧
  (∀f. exp_size f BytesInWord = 0) ∧ (∀f. exp1_size f [] = 0) ∧
  (∀f a0 a1. exp1_size f (a0::a1) = 1 + (exp2_size f a0 + exp1_size f a1)) ∧
  (∀f a0 a1. exp2_size f (a0,a1) = 1 + (mlstring_size a0 + exp_size f a1)) ∧
  (∀f. exp3_size f [] = 0) ∧
  ∀f a0 a1. exp3_size f (a0::a1) = 1 + (exp_size f a0 + exp3_size f a1)
DONE
