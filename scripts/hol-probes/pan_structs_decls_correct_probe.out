compile_decls_correct_statement=∀s' s decs ctxt decs' ctxt'. evaluate_decls s decs = SOME s' ∧ ctxt.structs = MAP (λ(nm,info). (nm,info.fields)) s.structs ∧ ctxt.locals = [] ∧ struct_infos_ok s.structs ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s.globals ∧ FEVERY (λ(nm,v). is_wf_shape_v s.structs v) s.globals ∧ alist_to_fmap ctxt.globals = FMAP_MAP2 (shape_of ∘ SND) s.globals ∧ compile_decs ctxt decs = (decs',ctxt') ⇒ evaluate_decls (convert_s ctxt' s) decs' = SOME (convert_s ctxt' s') ∧ ∃gb. ctxt' = ctxt with globals := gb ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s'.globals ∧ FEVERY (λ(nm,v). is_wf_shape_v s.structs v) s'.globals ∧ s'.structs = s.structs ∧ s'.locals = s.locals ∧ alist_to_fmap gb = FMAP_MAP2 (shape_of ∘ SND) s'.globals
compile_decls_correct_proved=T
compile_decls_correct_types=s'::(α, β) state;s::(α, β) state;decs::α decl list;ctxt::context;decs'::α decl list;ctxt'::context
