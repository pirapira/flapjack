compile_decls_correct_full_statement=∀s' s decs ctxt decs' ctxt'. evaluate_decls s decs = SOME s' ∧ ctxt.structs = MAP (λ(nm,info). (nm,info.fields)) s.structs ∧ ctxt.locals = [] ∧ struct_infos_ok s.structs ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s.globals ∧ FEVERY (λ(nm,v). is_wf_shape_v s.structs v) s.globals ∧ alist_to_fmap ctxt.globals = FMAP_MAP2 (shape_of ∘ SND) s.globals ∧ compile_decs ctxt decs = (decs',ctxt') ⇒ evaluate_decls (convert_s ctxt' s) decs' = SOME (convert_s ctxt' s') ∧ ∃gb. ctxt' = ctxt with globals := gb ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s'.globals ∧ FEVERY (λ(nm,v). is_wf_shape_v s.structs v) s'.globals ∧ s'.structs = s.structs ∧ s'.locals = s.locals ∧ alist_to_fmap gb = FMAP_MAP2 (shape_of ∘ SND) s'.globals
compile_decls_correct_full_proved=T
compile_decls_correct_full_types=s'::(α, β) state;s::(α, β) state;decs::α decl list;ctxt::context;decs'::α decl list;ctxt'::context
compile_decls_correct_decl_statement=∀v sh s' s e ds ctxt decs' ctxt'. evaluate_decls s (Decl sh v e::ds) = SOME s' ∧ ctxt.structs = MAP (λ(nm,info). (nm,info.fields)) s.structs ∧ ctxt.locals = [] ∧ struct_infos_ok s.structs ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s.globals ∧ FEVERY (λ(nm,v). is_wf_shape_v s.structs v) s.globals ∧ alist_to_fmap ctxt.globals = FMAP_MAP2 (shape_of ∘ SND) s.globals ∧ compile_decs ctxt (Decl sh v e::ds) = (decs',ctxt') ⇒ evaluate_decls (convert_s ctxt' s) decs' = SOME (convert_s ctxt' s') ∧ ∃gb. ctxt' = ctxt with globals := gb ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s'.globals ∧ FEVERY (λ(nm,v). is_wf_shape_v s.structs v) s'.globals ∧ s'.structs = s.structs ∧ s'.locals = s.locals ∧ alist_to_fmap gb = FMAP_MAP2 (shape_of ∘ SND) s'.globals
compile_decls_correct_decl_proved=T
compile_decls_correct_decl_types=v::mlstring;sh::shape;s'::(α, β) state;s::(α, β) state;e::α panLang$exp;ds::α decl list;ctxt::context;decs'::α decl list;ctxt'::context
evaluate_decls_ind_statement=∀P. (∀s. P s []) ∧ (∀s nm flds ds. P s ds ⇒ P s (Name nm flds::ds)) ∧ (∀s sh v e ds. (∀res. eval (s with locals := FEMPTY) e = SOME res ∧ sh = shape_of res ⇒ P (s with globals := s.globals⟨v ↦ res⟩) ds) ⇒ P s (Decl sh v e::ds)) ∧ (∀s fi ds. (EVERY (is_wf_shape s.structs ∘ SND) fi.params ∧ is_wf_shape s.structs fi.return ⇒ P (s with code := s.code⟨fi.name ↦ (fi.params,fi.body,fi.return)⟩) ds) ⇒ P s (Function fi::ds)) ∧ (∀s eid sh ds. (FLOOKUP s.eshapes eid = NONE ∧ is_wf_shape s.structs sh ⇒ P (s with eshapes := s.eshapes⟨eid ↦ sh⟩) ds) ⇒ P s (ExnDecl eid sh::ds)) ⇒ ∀v v1. P v v1
evaluate_decls_ind_proved=T
evaluate_decls_ind_types=P::(α, 'ffi) state -> α decl list -> bool
