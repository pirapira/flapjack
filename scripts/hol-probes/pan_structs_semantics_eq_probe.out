semantics_eq_statement=∀start s ctxt. semantics s start ≠ Fail ∧ ctxt.structs = MAP (λ(nm,info). (nm,info.fields)) s.structs ∧ s.locals = FEMPTY ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s.globals ∧ FEVERY (λ(nm,v). is_wf_shape_v s.structs v) s.globals ∧ ctxt.locals = [] ∧ alist_to_fmap ctxt.globals = FMAP_MAP2 (shape_of ∘ SND) s.globals ∧ struct_infos_ok s.structs ⇒ semantics (convert_s ctxt s) start = semantics s start
semantics_eq_proved=T
semantics_eq_types=start::mlstring;s::(α, β) state;ctxt::context
