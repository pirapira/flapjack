fun2set_update_eq_typed=fun2set ((m :α -> β),(md :α -> bool)) = fun2set ((m' :α -> β),md) ⇒ fun2set (m⦇(x :α) ↦ (a :β)⦈,md) = fun2set (m'⦇x ↦ a⦈,md)
get_var_const_memory_typed=(get_var (x :num) ((y :(α, β, γ) state) with memory := (m :α word -> α word_loc)) :α word_loc option) = (get_var x y :α word_loc option)
set_var_const_memory_typed=set_var (v :num) (x :α word_loc) ((y :(α, β, γ) state) with memory := (m :α word -> α word_loc)) = set_var v x y with memory := m
unset_var_const_memory_typed=unset_var (v :num) ((y :(α, β, γ) state) with memory := (m :α word -> α word_loc)) = unset_var v y with memory := m
get_vars_const_memory_typed=(get_vars (x :num list) ((y :(α, β, γ) state) with memory := (m :α word -> α word_loc)) :α word_loc list option) = (get_vars x y :α word_loc list option)
set_vars_const_memory_typed=set_vars (vs :num list) (xs :α word_loc list) ((y :(α, β, γ) state) with memory := (m :α word -> α word_loc)) = set_vars vs xs y with memory := m
get_var_imm_const_memory_typed=get_var_imm (ri :α reg_imm) ((s :(α, β, γ) state) with memory := (m :α word -> α word_loc)) = get_var_imm ri s
mem_load_const_memory_typed=fun2set ((s :(α, β, γ) state).memory,s.mdomain) = fun2set ((m :α word -> α word_loc),s.mdomain) ⇒ mem_load (ad :α word) (s with memory := m) = mem_load ad s
mem_store_const_memory_typed=fun2set ((s :(α, β, γ) state).memory,s.mdomain) = fun2set ((m :α word -> α word_loc),s.mdomain) ⇒ (mem_store (ad :α word) (w :α word_loc) s = (NONE :(α, β, γ) state option) ⇔ mem_store ad w (s with memory := m) = (NONE :(α, β, γ) state option)) ∧ (mem_store ad w s = SOME (s with memory := s.memory⦇ad ↦ w⦈) ⇔ mem_store ad w (s with memory := m) = SOME (s with memory := m⦇ad ↦ w⦈))
mem_load_32_const_memory_typed=fun2set ((m :α word -> α word_loc),(dm :α word -> bool)) = fun2set ((m' :α word -> α word_loc),dm) ⇒ mem_load_32 m dm (be :bool) (ad :α word) = mem_load_32 m' dm be ad
mem_store_32_const_memory_typed=fun2set ((m :α word -> α word_loc),(dm :α word -> bool)) = fun2set ((m' :α word -> α word_loc),dm) ⇒ (mem_store_32 m dm (be :bool) (ad :α word) (hw :word32) = (NONE :(α word -> α word_loc) option) ⇔ mem_store_32 m' dm be ad hw = (NONE :(α word -> α word_loc) option)) ∧ fun2set (THE (mem_store_32 m dm be ad hw),dm) = fun2set (THE (mem_store_32 m' dm be ad hw),dm)
word_exp_const_memory_typed=∀(s :(α, β, γ) state) (exp :α exp) (m :α word -> α word_loc). fun2set (s.memory,s.mdomain) = fun2set (m,s.mdomain) ⇒ (word_exp (s with memory := m) exp :α word_loc option) = (word_exp s exp :α word_loc option)
mem_load_byte_aux_const_memory_typed=fun2set ((m :α word -> α word_loc),(dm :α word -> bool)) = fun2set ((m' :α word -> α word_loc),dm) ⇒ mem_load_byte_aux m' dm (be :bool) (w :α word) = mem_load_byte_aux m dm be w
mem_store_byte_aux_const_memory_typed=fun2set ((m :α word -> α word_loc),(dm :α word -> bool)) = fun2set ((m' :α word -> α word_loc),dm) ⇒ (mem_store_byte_aux m dm (be :bool) (w :α word) (b :word8) = (NONE :(α word -> α word_loc) option) ⇔ mem_store_byte_aux m' dm be w b = (NONE :(α word -> α word_loc) option)) ∧ fun2set (THE (mem_store_byte_aux m' dm be w b),dm) = fun2set (THE (mem_store_byte_aux m dm be w b),dm)
read_bytearray_const_memory_typed=fun2set ((m :α word -> α word_loc),(dm :α word -> bool)) = fun2set ((m' :α word -> α word_loc),dm) ⇒ read_bytearray (ptr :α word) (len :num) (mem_load_byte_aux m dm (be :bool)) = read_bytearray ptr len (mem_load_byte_aux m' dm be)
write_bytearray_const_memory_typed=∀(ls :word8 list) (ptr :α word) (m :α word -> α word_loc). fun2set (m,(dm :α word -> bool)) = fun2set ((m' :α word -> α word_loc),dm) ⇒ fun2set (write_bytearray ptr ls m dm (be :bool),dm) = fun2set (write_bytearray ptr ls m' dm be,dm)
inst_const_memory_typed=fun2set ((s :(α, β, γ) state).memory,s.mdomain) = fun2set ((m :α word -> α word_loc),s.mdomain) ⇒ (inst (i :α inst) s = (NONE :(α, β, γ) state option) ⇔ inst i (s with memory := m) = (NONE :(α, β, γ) state option)) ∧ (inst i s ≠ (NONE :(α, β, γ) state option) ⇒ ∃(m' :α word -> α word_loc). THE (inst i (s with memory := m)) = THE (inst i s) with memory := m' ∧ (let (x :(α, β, γ) state) = THE (inst i s) in fun2set (x.memory,x.mdomain) = fun2set (m',x.mdomain)))
const_writes_const_memory_typed=∀(c' :α word) (c :α word) (words :(bool # α word) list) (m :α word -> α word_loc) (m' :α word -> α word_loc) (md :α word -> bool). fun2set (m,md) = fun2set (m',md) ⇒ fun2set (const_writes c' c words m,md) = fun2set (const_writes c' c words m',md)
share_inst_const_memory_typed=∀(s :(α, β, γ) state) (op :memop) (v :num) (c :α word) (m :α word -> α word_loc). fun2set (s.memory,s.mdomain) = fun2set (m,s.mdomain) ∧ (share_inst op v c s :δ wordSem$result option # (α, β, γ) state) = ((res :δ wordSem$result option),(t :(α, β, γ) state)) ⇒ t.memory = s.memory ∧ t.mdomain = s.mdomain ∧ (share_inst op v c (s with memory := m) :δ wordSem$result option # (α, β, γ) state) = (res,t with memory := m)
mem_upd_lemma_typed=(s :(α, β, γ) state) with memory := (ARB :α word -> α word_loc) = (t :(α, β, γ) state) with memory := (ARB :α word -> α word_loc) ⇒ ∃(m :α word -> α word_loc). s = t with memory := m
push_env_mem_upd_typed=∀(env :α word_loc sptree$num_map # α word_loc sptree$num_map) (params :(num # α prog # num # num) option) (s :(α, β, γ) state). push_env env params (s with memory := (m :α word -> α word_loc)) = push_env env params s with memory := m
push_env_mem_const_typed=∀(env :α word_loc sptree$num_map # α word_loc sptree$num_map) (params :(num # α prog # num # num) option) (s :(α, β, γ) state). (push_env env params s).memory = s.memory ∧ (push_env env params s).mdomain = s.mdomain
cut_state_with_mem_const_typed=cut_state (x :sptree$num_set # sptree$num_set) ((s :(α, β, γ) state) with memory := (m :α word -> α word_loc)) = OPTION_MAP (λ(s' :(α, β, γ) state). s' with memory := m) (cut_state x s)
