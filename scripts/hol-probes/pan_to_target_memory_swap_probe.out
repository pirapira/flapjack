memory_swap_lemma1_typed=∀(prog :α prog) (st :(α, β, γ) state) (res :α wordSem$result option) (rst :(α, β, γ) state) (m :α word -> α word_loc). (evaluate (prog,st) :α wordSem$result option # (α, β, γ) state) = (res,rst) ∧ fun2set (st.memory,st.mdomain) = fun2set (m,st.mdomain) ∧ no_alloc_code st.code ∧ no_install_code st.code ∧ no_alloc prog ∧ no_install prog ⇒ ∃(st' :(α, β, γ) state). (evaluate (prog,st with memory := m) :α wordSem$result option # (α, β, γ) state) = (res,st') ∧ st' with memory := (ARB :α word -> α word_loc) = rst with memory := (ARB :α word -> α word_loc) ∧ fun2set (rst.memory,rst.mdomain) = fun2set (st'.memory,rst.mdomain)
memory_swap_lemma_typed=∀(prog :α prog) (st :(α, β, γ) state) (res :α wordSem$result option) (rst :(α, β, γ) state) (m :α word -> α word_loc). (evaluate (prog,st) :α wordSem$result option # (α, β, γ) state) = (res,rst) ∧ fun2set (st.memory,st.mdomain) = fun2set (m,st.mdomain) ∧ no_alloc_code st.code ∧ no_install_code st.code ∧ no_alloc prog ∧ no_install prog ⇒ ∃(m' :α word -> α word_loc). (evaluate (prog,st with memory := m) :α wordSem$result option # (α, β, γ) state) = (res,rst with memory := m') ∧ fun2set (rst.memory,rst.mdomain) = fun2set (m',rst.mdomain)
word_semantics_memory_update_typed=fun2set ((s :(α, β, 'ffi) state).memory,s.mdomain) = fun2set ((m :α word -> α word_loc),s.mdomain) ∧ no_alloc_code s.code ∧ no_install_code s.code ⇒ (semantics (s with memory := m) (start :num) :behaviour) ≠ Fail ⇒ (semantics s start :behaviour) = (semantics (s with memory := m) start :behaviour)
