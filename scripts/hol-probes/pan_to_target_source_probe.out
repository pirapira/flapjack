exports_def=(∀(fi :α fun_decl) (ds :α decl list). exports (Function fi::ds) = if fi.export then fi.name::exports ds else exports ds) ∧ (∀(v5 :α panLang$exp) (v4 :mlstring) (v3 :shape) (ds :α decl list). exports (Decl v3 v4 v5::ds) = exports ds) ∧ (∀(v7 :shape) (v6 :mlstring) (ds :α decl list). exports ((ExnDecl v6 v7 :α decl)::ds) = exports ds) ∧ (∀(v9 :(mlstring # shape) list) (v8 :mlstring) (ds :α decl list). exports ((Name v8 v9 :α decl)::ds) = exports ds) ∧ exports ([] :α decl list) = ([] :mlstring list)
compile_prog_def=∀(asm_conf :α asm_config) (c :config) (prog :α decl list). (compile_prog asm_conf c prog :(word8 list # α word list # config) option) = (let (prog1 :α decl list) = case SPLITP (λ(x :α decl). case x of Function fi => fi.name = «main» | Decl v9 v10 v11 => F | (ExnDecl v12 v13 :α decl) => F | (Name v14 v15 :α decl) => F) prog of (([] :α decl list),ys) => ys | (v6::v7,([] :α decl list)) => Function <|name := «main»; inline := F; export := F; params := ([] :(mlstring # shape) list); body := (Return (Const (0w :α word) :α panLang$exp) :α panLang$prog); return := One|> ::v6::v7 | (v6::v7,v8::v9) => v8::v6::v7 ++ v9; (prog2 :(num # num # α wordLang$prog) list) = (compile_prog asm_conf.ISA prog1 :(num # num # α wordLang$prog) list); ((col :num sptree$num_map option list),(prog3 :(num # num # α wordLang$prog) list)) = (compile c.word_to_word_conf asm_conf prog2 :num sptree$num_map option list # (num # num # α wordLang$prog) list); (c :config) = c with word_to_word_conf updated_by (λ(c :word_to_word$config). c with col_oracle := col); (names :mlstring sptree$num_map) = fromAList (ZIP (sort $< (MAP (FST :num # num # α wordLang$prog -> num) prog2),«generated_main»::MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions prog1))); (names :mlstring sptree$num_map) = (union (fromAList (stub_names () ++ stub_names () ++ stub_names ())) names :mlstring sptree$num_map); (c :config) = c with exported := exports prog in from_word asm_conf c names prog3)
exports_type=:α decl list -> mlstring list
compile_prog_type=:α asm_config -> config -> α decl list -> (word8 list # α word list # config) option
zip_def=(∀(l2 :β list). ZIP (([] :α list),l2) = ([] :(α # β) list)) ∧ (∀(l1 :α list). ZIP (l1,([] :β list)) = ([] :(α # β) list)) ∧ ∀(x1 :α) (l1 :α list) (x2 :β) (l2 :β list). ZIP (x1::l1,x2::l2) = (x1,x2)::ZIP (l1,l2)
splitp_def=(∀(P :α -> bool). SPLITP P ([] :α list) = (([] :α list),([] :α list))) ∧ ∀(P :α -> bool) (x :α) (l :α list). SPLITP P (x::l) = if P x then (([] :α list),x::l) else (x::FST (SPLITP P l),SND (SPLITP P l))
compile_prog_main_binding=case SPLITP (λ(x :α decl). case x of Function fi => fi.name = «main» | Decl v9 v10 v11 => F | (ExnDecl v12 v13 :α decl) => F | (Name v14 v15 :α decl) => F) (prog :α decl list) of (([] :α decl list),ys) => ys | (v6::v7,([] :α decl list)) => Function <|name := «main»; inline := F; export := F; params := ([] :(mlstring # shape) list); body := (Return (Const (0w :α word) :α panLang$exp) :α panLang$prog); return := One|> ::v6::v7 | (v6::v7,v8::v9) => v8::v6::v7 ++ v9
