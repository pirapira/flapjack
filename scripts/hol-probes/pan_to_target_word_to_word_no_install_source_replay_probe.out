word_to_word_compile_no_install_no_alloc_replay_statement=compile wconf aconf progs0 = (col,progs) ∧ ALL_DISTINCT (MAP FST progs0) ∧ no_mt_code (fromAList progs0) ∧ no_install_code (fromAList progs0) ⇒ no_install_code (fromAList progs) ∧ (no_alloc_code (fromAList progs0) ⇒ no_alloc_code (fromAList progs))
word_to_word_compile_no_install_no_alloc_replay_hypotheses=0
word_to_word_compile_no_install_no_alloc_replay_typed=compile (wconf :config) (aconf :α asm_config) (progs0 :(num # num # α prog) list) = ((col :num sptree$num_map option list),(progs :(num # num # α prog) list)) ∧ ALL_DISTINCT (MAP (FST :num # num # α prog -> num) progs0) ∧ no_mt_code (fromAList progs0) ∧ no_install_code (fromAList progs0) ⇒ no_install_code (fromAList progs) ∧ (no_alloc_code (fromAList progs0) ⇒ no_alloc_code (fromAList progs))
