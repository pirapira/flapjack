state_rel_imp_semantics_statement=∀(t :(α, β, 'ffi) wordSem$state) (start :mlstring) (s :(α, 'ffi) panSem$state) (pan_code :α decl list) (heap_len :α word) (globals_size :num) (c :architecture). (∀(addr' :α word). addr' ∈ s.memaddrs ⇒ (t.memory addr' :α word_loc) = wlab_wloc (s.memory addr' :α word_lab)) ∧ no_labels t.memory t.mdomain ∧ start = «main» ∧ globals_size = (let (dec_shs :shape list) = dec_shapes pan_code; (struct_ctxt :(mlstring # struct_info) list option) = decs_stcnames ([] :(mlstring # struct_info) list) pan_code in (SUM (MAP (size_of_sh_with_ctxt (THE struct_ctxt)) dec_shs) :num)) ∧ distinct_params (functions pan_code) ∧ t.mdomain = s.memaddrs ∪ addresses s.top_addr globals_size ∧ t.sh_mdomain = s.sh_memaddrs ∧ (t.be ⇔ s.be) ∧ t.ffi = s.ffi ∧ ALOOKUP (fmap_to_alist t.store) CurrHeap = SOME (Word s.base_addr :α word_loc) ∧ ALOOKUP (fmap_to_alist t.store) HeapLength = SOME (Word heap_len :α word_loc) ∧ s.top_addr = s.base_addr + (2w :α word) * heap_len − (bytes_in_word :α word) * (n2w globals_size :α word) ∧ ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions pan_code)) ∧ byte_aligned s.top_addr ∧ globals_allocatable s pan_code ∧ s.code = (FEMPTY :mlstring |-> (mlstring # shape) list # α panLang$prog # shape) ∧ t.code = fromAList (compile_prog c pan_code :(num # num # α prog) list) ∧ s.globals = (FEMPTY :mlstring |-> α panSem$v) ∧ s.locals = (FEMPTY :mlstring |-> α panSem$v) ∧ size_of_eids pan_code < dimword (:α) ∧ s.eshapes = (FEMPTY :mlstring |-> shape) ∧ lookup (0 :num) t.locals = SOME (Loc (1 :num) (0 :num) :α word_loc) ∧ good_dimindex (:α) ∧ semantics_decls s start pan_code ≠ Fail ⇒ (semantics t first_name :behaviour) = semantics_decls s start pan_code
state_rel_imp_semantics_proved=T
state_rel_imp_semantics_types=(t :(α, β, 'ffi) wordSem$state)::(α, β, 'ffi) wordSem$state;(start :mlstring)::mlstring;(s :(α, 'ffi) panSem$state)::(α, 'ffi) panSem$state;(pan_code :α decl list)::α decl list;(heap_len :α word)::α word;(globals_size :num)::num;(c :architecture)::architecture
