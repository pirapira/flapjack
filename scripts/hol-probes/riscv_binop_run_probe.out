native_and_types=:riscv_state ; stv : :riscv_state, rs2v : :word5, rs1v : :word5, rdv : :word5
native_or_clause=Run (ArithR (OR (rdv,rs1v,rs2v))) stv = write'GPR (GPR rs1v stv ‖ GPR rs2v stv,rdv) stv
