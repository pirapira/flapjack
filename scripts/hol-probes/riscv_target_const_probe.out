riscv_encoder_correct_const_statement=∀s2 s1 r ms c. asm_step riscv_target.config s1 (Inst (Const r c)) s2 ∧ target_state_rel riscv_target s1 ms ⇒ ∃n. ∀env. interference_ok env (riscv_target.proj s1.mem_domain) ⇒ (let pcs = all_pcs (LENGTH (riscv_target.config.encode (Inst (Const r c)))) s1.pc in asserts n (λk s. env (n − k) (riscv_target.next s)) ms (λms'. riscv_target.state_ok ms' ∧ (∀pc. pc ∈ pcs 0 ⇒ riscv_target.get_byte ms' pc = riscv_target.get_byte ms pc) ∧ riscv_target.get_pc ms' ∈ pcs riscv_target.config.code_alignment) (λms'. target_state_rel riscv_target s2 ms') ∧ asserts2 (n + 1) (λk. env (n + 1 − k)) riscv_target.next ms (λms1 ms2. ∀x. x ∉ s1.mem_domain ⇒ riscv_target.get_byte ms1 x = riscv_target.get_byte ms2 x))
riscv_encoder_correct_const_types=s2 : :64 asm_state, s1 : :64 asm_state, r : :num, ms : :riscv_state, c : :word64
riscv_encoder_correct_const_hypotheses=0
riscv_encoder_correct_const_proved=T
