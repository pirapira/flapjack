stack_asm_name_comp_statement=∀i p. ((stack_asm_name c (comp i p) ⇔ stack_asm_name c p) ∧ (stack_asm_name c (comp_top i p) ⇔ stack_asm_name c p)) ∧ (stack_asm_remove c (comp i p) ⇔ stack_asm_remove c p) ∧ (stack_asm_remove c (comp_top i p) ⇔ stack_asm_remove c p)
stack_asm_name_comp_statement_typed=∀(i :num sptree$num_map) (p :α prog). ((stack_asm_name (c :α asm_config) (comp i p :α prog) ⇔ stack_asm_name c p) ∧ (stack_asm_name c (comp_top i p) ⇔ stack_asm_name c p)) ∧ (stack_asm_remove c (comp i p :α prog) ⇔ stack_asm_remove c p) ∧ (stack_asm_remove c (comp_top i p) ⇔ stack_asm_remove c p)
stack_asm_name_comp_statement_types=(i :num sptree$num_map)::num sptree$num_map;(p :α prog)::α prog;(c :α asm_config)::α asm_config;
stack_alloc_stack_asm_convs_statement=(EVERY (λ(n,p). stack_asm_name c p) (compile prog) ⇔ EVERY (λ(n,p). stack_asm_name c p) prog) ∧ (EVERY (λ(n,p). stack_asm_remove c p) (compile prog) ⇔ EVERY (λ(n,p). stack_asm_remove c p) prog)
stack_alloc_stack_asm_convs_statement_typed=(EVERY (λ((n :num),(p :α prog)). stack_asm_name (c :α asm_config) p) (compile (prog :(num # α prog) list) :(num # α prog) list) ⇔ EVERY (λ((n :num),(p :α prog)). stack_asm_name c p) prog) ∧ (EVERY (λ((n :num),(p :α prog)). stack_asm_remove c p) (compile prog :(num # α prog) list) ⇔ EVERY (λ((n :num),(p :α prog)). stack_asm_remove c p) prog)
stack_alloc_stack_asm_convs_statement_types=(prog :(num # α prog) list)::(num # α prog) list;(c :α asm_config)::α asm_config;
