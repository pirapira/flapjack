stack_remove_comp_stack_asm_name_statement=∀jump off k p. stack_asm_name c p ∧ stack_asm_remove c p ∧ addr_offset_ok c 0w ∧ good_dimindex (:α) ∧ (∀n. n ≤ max_stack_alloc ⇒ c.valid_imm (INL Sub) (n2w (n * (dimindex (:α) DIV 8))) ∧ c.valid_imm (INL Add) (n2w (n * (dimindex (:α) DIV 8)))) ∧ (∀s. addr_offset_ok c (store_offset s)) ∧ reg_name (k + 2) c ∧ reg_name (k + 1) c ∧ reg_name k c ∧ k ≠ 0 ∧ off = c.addr_offset ⇒ stack_asm_name c (comp jump off k p)
stack_remove_comp_stack_asm_name_statement_typed=∀(jump :bool) (off :α word # α word) (k :num) (p :α stackLang$prog). stack_asm_name (c :α asm_config) p ∧ stack_asm_remove c p ∧ addr_offset_ok c (0w :α word) ∧ good_dimindex (:α) ∧ (∀(n :num). n ≤ max_stack_alloc ⇒ c.valid_imm (INL Sub :binop + cmp) (n2w (n * (dimindex (:α) DIV (8 :num))) :α word) ∧ c.valid_imm (INL Add :binop + cmp) (n2w (n * (dimindex (:α) DIV (8 :num))) :α word)) ∧ (∀(s :store_name). addr_offset_ok c (store_offset s :α word)) ∧ reg_name (k + (2 :num)) c ∧ reg_name (k + (1 :num)) c ∧ reg_name k c ∧ k ≠ (0 :num) ∧ off = c.addr_offset ⇒ stack_asm_name c (comp jump off k p :α stackLang$prog)
stack_remove_comp_stack_asm_name_statement_types=(jump :bool)::bool;(off :α word # α word)::α word # α word;(k :num)::num;(p :α stackLang$prog)::α stackLang$prog;(c :α asm_config)::α asm_config;
stack_remove_stack_asm_name_statement=EVERY (λ(n,p). stack_asm_name c p) prog ∧ EVERY (λ(n,p). stack_asm_remove c p) prog ∧ addr_offset_ok c 0w ∧ good_dimindex (:α) ∧ (∀n. n ≤ max_stack_alloc ⇒ c.valid_imm (INL Sub) (n2w (n * (dimindex (:α) DIV 8))) ∧ c.valid_imm (INL Add) (n2w (n * (dimindex (:α) DIV 8)))) ∧ c.valid_imm (INL Add) 4w ∧ c.valid_imm (INL Add) 8w ∧ (∀s. addr_offset_ok c (store_offset s)) ∧ reg_name 7 c ∧ reg_name (k + 2) c ∧ reg_name (k + 1) c ∧ reg_name k c ∧ k ≠ 0 ⇒ EVERY (λ(n,p). stack_asm_name c p) (compile jump c.addr_offset gen_gc max_heap k start prog)
stack_remove_stack_asm_name_statement_typed=EVERY (λ((n :num),(p :α stackLang$prog)). stack_asm_name (c :α asm_config) p) (prog :(num # α stackLang$prog) list) ∧ EVERY (λ((n :num),(p :α stackLang$prog)). stack_asm_remove c p) prog ∧ addr_offset_ok c (0w :α word) ∧ good_dimindex (:α) ∧ (∀(n :num). n ≤ max_stack_alloc ⇒ c.valid_imm (INL Sub :binop + cmp) (n2w (n * (dimindex (:α) DIV (8 :num))) :α word) ∧ c.valid_imm (INL Add :binop + cmp) (n2w (n * (dimindex (:α) DIV (8 :num))) :α word)) ∧ c.valid_imm (INL Add :binop + cmp) (4w :α word) ∧ c.valid_imm (INL Add :binop + cmp) (8w :α word) ∧ (∀(s :store_name). addr_offset_ok c (store_offset s :α word)) ∧ reg_name (7 :num) c ∧ reg_name ((k :num) + (2 :num)) c ∧ reg_name (k + (1 :num)) c ∧ reg_name k c ∧ k ≠ (0 :num) ⇒ EVERY (λ((n :num),(p :α stackLang$prog)). stack_asm_name c p) (compile (jump :bool) c.addr_offset (gen_gc :bool) (max_heap :num) k (start :num) prog :(num # α stackLang$prog) list)
stack_remove_stack_asm_name_statement_types=(start :num)::num;(max_heap :num)::num;(gen_gc :bool)::bool;(jump :bool)::bool;(k :num)::num;(prog :(num # α stackLang$prog) list)::(num # α stackLang$prog) list;(c :α asm_config)::α asm_config;
