full_make_init_def_statement=∀(stack_conf :stack_to_lab$config) (data_conf :data_to_word$config) (max_heap :num) (sp :num) (offset :α word # α word) (bitmaps :α word list) (code :(num # α prog) list) (s4 :(α, β, γ) labSem$state) (save_regs :num -> bool) (data_sp :num) (coracle :num -> β # (num # α prog) list # α word list). full_make_init stack_conf data_conf max_heap sp offset bitmaps code s4 save_regs data_sp coracle = (let (ggc :bool) = is_gen_gc data_conf.gc_kind; (jump :bool) = stack_conf.jump; (code1 :(num # α prog) list) = (compile data_conf (compile code :(num # α prog) list) :(num # α prog) list); (code2 :(num # α prog) list) = (compile jump offset ggc max_heap sp InitGlobals_location code1 :(num # α prog) list); (code3 :α prog sptree$num_map) = fromAList (compile stack_conf.reg_names code2 :(num # α prog) list); (coracle1 :num -> β # (num # α prog) list # α word list) = ((I :β -> β) ## MAP (prog_comp :num # α prog -> num # α prog) ## (I :α word list -> α word list)) ∘ coracle; (coracle2 :num -> β # (num # α prog) list # α word list) = ((I :β -> β) ## MAP (prog_comp jump offset sp :num # α prog -> num # α prog) ## (I :α word list -> α word list)) ∘ coracle1; (coracle3 :num -> β # (num # α prog) list # α word list) = ((I :β -> β) ## (compile stack_conf.reg_names :(num # α prog) list -> (num # α prog) list) ## (I :α word list -> α word list)) ∘ coracle2; (s3 :(α, β, γ) stackSem$state) = (make_init code3 coracle3 (MAP (find_name stack_conf.reg_names) [(2 :num); (3 :num); (4 :num)]) save_regs s4 :(α, β, γ) stackSem$state); (s2 :(α, β, γ) stackSem$state) = (make_init stack_conf.reg_names (fromAList code2) coracle2 s3 :(α, β, γ) stackSem$state); (s1 :(α, β, γ) stackSem$state) = make_init_any ggc max_heap bitmaps data_sp coracle1 jump offset sp (fromAList code1) s2 in ((make_init data_conf (fromAList code) coracle s1 :(α, β, γ) stackSem$state),make_init_opt ggc max_heap bitmaps data_sp coracle1 jump offset sp (fromAList code1) s2))
full_make_init_buffer_statement=(FST (full_make_init (a :stack_to_lab$config) (b :data_to_word$config) (c :num) (d :num) (e :α word # α word) (f :α word list) (g :(num # α prog) list) (h :(α, β, γ) labSem$state) (i :num -> bool) (j :num) (k :num -> β # (num # α prog) list # α word list))).code_buffer.buffer = ([] :word8 list) ∧ (FST (full_make_init a b c d e f g h i j k)).data_buffer.buffer = ([] :α word list)
full_make_init_ffi_statement=(FST (full_make_init (a :stack_to_lab$config) (b :data_to_word$config) (c :num) (d :num) (e :β word # β word) (f :β word list) (g :(num # β prog) list) (h :(β, γ, α) labSem$state) (i :num -> bool) (j :num) (k :num -> γ # (num # β prog) list # β word list))).ffi = h.ffi
full_make_init_compile_statement=(FST (full_make_init (a :stack_to_lab$config) (b :data_to_word$config) (c :num) (d :num) (e :β word # β word) (f :β word list) (g :(num # β prog) list) (h :(β, α, γ) labSem$state) (i :num -> bool) (j :num) (k :num -> α # (num # β prog) list # β word list))).compile = (λ(c :α). (λ(p :(num # β prog) list). (h.compile c (MAP (prog_to_section :num # β prog -> β sec) (MAP (prog_comp a.reg_names :num # β prog -> num # β prog) (MAP (prog_comp a.jump e d :num # β prog -> num # β prog) p))) :(word8 list # α) option)) ∘ MAP (prog_comp :num # β prog -> num # β prog))
full_make_init_type=:stack_to_lab$config -> data_to_word$config -> num -> num -> α word # α word -> α word list -> (num # α prog) list -> (α, β, γ) labSem$state -> (num -> bool) -> num -> (num -> β # (num # α prog) list # α word list) -> (α, β, γ) stackSem$state # (α, β, γ) stackSem$state option
