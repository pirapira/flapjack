flatten_labels_statement=∀t m n p cs bs l x y. flatten t m n p cs bs = (l,x,y) ∧ EVERY (sec_label_ok n) (append l) ⇒ BIGUNION (IMAGE line_get_labels (set (append l))) ⊆ set (MAP (λl. (n,l)) (cs ++ bs)) ∪ sec_get_code_labels (Section n (append l)) ∪ get_code_labels m
flatten_labels_statement_typed=∀(t :bool) (m :α prog) (n :num) (p :num) (cs :num list) (bs :num list) (l :α line app_list) (x :bool) (y :num). flatten t m n p cs bs = (l,x,y) ∧ EVERY (sec_label_ok n :α line -> bool) (append l) ⇒ BIGUNION (IMAGE (line_get_labels :α line -> num # num -> bool) (set (append l))) ⊆ set (MAP (λ(l :num). (n,l)) (cs ++ bs)) ∪ sec_get_code_labels (Section n (append l)) ∪ (get_code_labels m :num # num -> bool)
