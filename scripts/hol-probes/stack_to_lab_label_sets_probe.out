complex_flatten_labels_statement=∀t p n m cs bs. (let pp = set (append (FST (flatten t p n m cs bs))) in BIGUNION (IMAGE line_get_labels pp) ⊆ (n,0) INSERT (n,if t ∧ ∃p1 p2. p = Seq p1 p2 then 1 else 0) INSERT set (MAP (λl. (n,l)) (cs ++ bs)) ∪ IMAGE (λn2. (n,n2)) (BIGUNION (IMAGE line_get_code_labels pp)) ∪ complex_get_code_labels p)
complex_flatten_labels_statement_typed=∀(t :bool) (p :α prog) (n :num) (m :num) (cs :num list) (bs :num list). (let (pp :α line -> bool) = set (append (FST (flatten t p n m cs bs))) in BIGUNION (IMAGE (line_get_labels :α line -> num # num -> bool) pp) ⊆ (n,(0 :num)) INSERT (n,if t ∧ ∃(p1 :α prog) (p2 :α prog). p = Seq p1 p2 then (1 :num) else (0 :num)) INSERT set (MAP (λ(l :num). (n,l)) (cs ++ bs)) ∪ IMAGE (λ(n2 :num). (n,n2)) (BIGUNION (IMAGE (line_get_code_labels :α line -> num -> bool) pp)) ∪ complex_get_code_labels p)
