unreachLabels1_typed=∀(p2 :α prog) (p1 :α prog). set (extract_labels (SimpSeq p1 p2)) ⊆ set (extract_labels (Seq p1 p2))
unreachLabels1_proved=T
unreachLabels1_hypotheses=0
unreachLabels2_typed=∀(p1 :α prog) (p2 :α prog). set (extract_labels (Seq_assoc_right p1 p2)) ⊆ set (extract_labels p1) ∪ set (extract_labels p2)
unreachLabels2_proved=T
unreachLabels2_hypotheses=0
unreachLabels3_typed=∀(p :α prog). set (extract_labels (remove_unreach p)) ⊆ set (extract_labels p)
unreachLabels3_proved=T
unreachLabels3_hypotheses=0
unreachLabels4_typed=∀(p1 :α prog) (p2 :α prog) (x :num # num). MEM x (extract_labels (Seq_assoc_right p1 p2)) ⇒ MEM x (extract_labels p1) ∨ MEM x (extract_labels p2)
unreachLabels4_proved=T
unreachLabels4_hypotheses=0
unreachLabels5_typed=∀(p1 :α prog) (p2 :α prog). ALL_DISTINCT (extract_labels p1 ++ extract_labels p2) ⇒ ALL_DISTINCT (extract_labels (Seq_assoc_right p1 p2))
unreachLabels5_proved=T
unreachLabels5_hypotheses=0
unreachLabels6_typed=∀(p :α prog). ALL_DISTINCT (extract_labels p) ⇒ ALL_DISTINCT (extract_labels (remove_unreach p))
unreachLabels6_proved=T
unreachLabels6_hypotheses=0
unreachLabels7_typed=∀(q :α prog). labels_rel (extract_labels q) (extract_labels (remove_unreach q))
unreachLabels7_proved=T
unreachLabels7_hypotheses=0
