add_to_data_aux_correct_statement=∀data s r i p w data' p'. data_inv data s ∧ lookup r data.to_canonical = NONE ∧ add_to_data_aux data r i p = (data',p') ∧ evaluate (p,s) = (NONE,set_var r w s) ∧ (∀v. lookup listCmp i data.instrs_mem = SOME v ⇒ get_var v s = SOME w) ∧ (¬EVEN r ⇒ data_inv (data with <|instrs_mem := insert listCmp i r (data with to_canonical := insert r r data.to_canonical).instrs_mem; to_canonical := insert r r data.to_canonical|>) (set_var r w s)) ⇒ evaluate (p',s) = (NONE,set_var r w s) ∧ data_inv data' (set_var r w s)
add_to_data_aux_correct_hypotheses=0
add_to_data_const_correct_statement=∀data s r w data' p'. data_inv data s ∧ lookup r data.to_canonical = NONE ∧ ¬EVEN r ∧ add_to_data_const data r w = (data',p') ⇒ evaluate (p',s) = (NONE,set_var r (Word w) s) ∧ data_inv data' (set_var r (Word w) s)
add_to_data_const_correct_hypotheses=0
add_to_data_LocValue_correct_statement=∀data s r l data' p'. data_inv data s ∧ lookup r data.to_canonical = NONE ∧ l ∈ domain s.code ∧ add_to_data_aux data r [48; l] (LocValue r l) = (data',p') ⇒ evaluate (p',s) = (NONE,set_var r (Loc l 0) s) ∧ data_inv data' (set_var r (Loc l 0) s)
add_to_data_LocValue_correct_hypotheses=0
add_to_data_OpCurrHeap_correct_statement=∀data s b r1 r2 r2' w data' p'. data_inv data s ∧ lookup r1 data.to_canonical = NONE ∧ r2' = canonicalRegs' r1 data r2 ∧ ¬EVEN r2 ∧ r2 ≠ r1 ∧ word_exp s (Op b [Var r2; Lookup CurrHeap]) = SOME w ∧ add_to_data_aux (register_read data r2') r1 (OpCurrHeapToNumList b r2') (OpCurrHeap b r1 r2) = (data',p') ⇒ evaluate (p',s) = (NONE,set_var r1 w s) ∧ data_inv data' (set_var r1 w s)
add_to_data_OpCurrHeap_correct_hypotheses=0
add_to_data_Arith_correct_statement=∀data s a a' r w data' p'. data_inv data s ∧ lookup r data.to_canonical = NONE ∧ a' = canonicalArith data a ∧ can_mem_arith a' ∧ ¬MEM r (arithReads a') ∧ r = firstRegOfArith a ∧ evaluate (Inst (Arith a),s) = (NONE,set_var r w s) ∧ add_to_data (register_reads data (arithReads a')) r (Arith a') (Arith a) = (data',p') ⇒ evaluate (p',s) = (NONE,set_var r w s) ∧ data_inv data' (set_var r w s)
add_to_data_Arith_correct_hypotheses=0
add_to_load_aux_correct_statement=∀data s r i p w data' p'. data_inv data s ∧ lookup r data.to_canonical = NONE ∧ add_to_load_aux data r i p = (data',p') ∧ evaluate (p,s) = (NONE,set_var r w s) ∧ (∀v. lookup listCmp i data.loads_mem = SOME v ⇒ get_var v s = SOME w) ∧ (¬EVEN r ⇒ data_inv (data with <|loads_mem := insert listCmp i r (data with to_canonical := insert r r data.to_canonical).loads_mem; to_canonical := insert r r data.to_canonical|>) (set_var r w s)) ⇒ evaluate (p',s) = (NONE,set_var r w s) ∧ data_inv data' (set_var r w s)
add_to_load_aux_correct_hypotheses=0
add_to_load_correct_statement=∀data s op r a a' ofs w data' p'. data_inv data s ∧ lookup r data.to_canonical = NONE ∧ a' = canonicalRegs' r data a ∧ ¬is_store op ∧ ¬EVEN r ∧ ¬EVEN a ∧ a ≠ r ∧ evaluate (Inst (Mem op r (Addr a ofs)),s) = (NONE,set_var r w s) ∧ add_to_load_aux (register_read data a') r (loadToNumList op a' ofs) (Inst (Mem op r (Addr a ofs))) = (data',p') ⇒ evaluate (p',s) = (NONE,set_var r w s) ∧ data_inv data' (set_var r w s)
add_to_load_correct_hypotheses=0
add_to_data_Arith_correct_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (a :α arith) (a' :α arith) (r :num) (w :α word_loc) (data' :knowledge) (p' :α prog). data_inv data s ∧ (lookup r data.to_canonical :num option) = (NONE :num option) ∧ a' = canonicalArith data a ∧ can_mem_arith a' ∧ ¬MEM r (arithReads a') ∧ r = firstRegOfArith a ∧ evaluate ((Inst (Arith a :α inst) :α prog),s) = ((NONE :α result option),set_var r w s) ∧ add_to_data (register_reads data (arithReads a')) r (Arith a' :α inst) (Arith a :α inst) = (data',p') ⇒ evaluate (p',s) = ((NONE :α result option),set_var r w s) ∧ data_inv data' (set_var r w s)
