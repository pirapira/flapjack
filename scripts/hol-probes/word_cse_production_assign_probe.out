assign_source_type=:knowledge -> α prog -> knowledge # α prog
assign_source_definition=⊢ (∀(data :knowledge) (r :num) (rs :(num # num) list). word_cse data (Move r rs :α prog) = (let (data' :knowledge) = canonicalMoveRegs data rs in (data',(Move r rs :α prog)))) ∧ (∀(data :knowledge) (i :α inst). word_cse data (Inst i :α prog) = (let ((data' :knowledge),(p :α prog)) = word_cseInst data i in (data',p))) ∧ (∀(data :knowledge) (r :num) (x :store_name). word_cse data (Get r x :α prog) = (let (data :knowledge) = invalidate_data data r in case ALOOKUP data.gets_mem x of (NONE :num option) => if EVEN r then (data,(Get r x :α prog)) else (data with <|gets_mem := (x,r)::data.gets_mem; to_canonical := (insert r r data.to_canonical :num sptree$num_map); to_latest := (insert r r data.to_latest :num sptree$num_map)|>,(Get r x :α prog)) | SOME k => if EVEN r then (data,(Move (1 :num) [(r,lookup_any k data.to_latest k)] :α prog)) else (data with <|to_canonical := (insert r k data.to_canonical :num sptree$num_map); to_latest := (insert k r data.to_latest :num sptree$num_map)|>,(Move (1 :num) [(r,lookup_any k data.to_latest k)] :α prog)))) ∧ (∀(data :knowledge) (x :store_name) (e :α exp). word_cse data (Set x e :α prog) = if x = CurrHeap then (empty_data,(Set x e :α prog)) else (let (new_gets_mem :(store_name # num) list) = FILTER (λ((m :store_name),(n :num)). m ≠ x) data.gets_mem in case dest_Var e of (NONE :num option) => (data with gets_mem := new_gets_mem,(Set x e :α prog)) | SOME v => if EVEN v then (data with gets_mem := new_gets_mem,(Set x e :α prog)) else (data with <|gets_mem := (x,canonicalRegs data v)::new_gets_mem; to_canonical := (insert v (lookup_any v data.to_canonical v) data.to_canonical :num sptree$num_map)|>,(Set x e :α prog)))) ∧ (∀(data :knowledge) (p :α prog). word_cse data (MustTerminate p) = (let ((data' :knowledge),(p' :α prog)) = word_cse data p in (data',MustTerminate p'))) ∧ (∀(data :knowledge) (ret :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) (dest :num option) (args :num list) (handler :(num # α prog # num # num) option). word_cse data (Call ret dest args handler :α prog) = (empty_data,(Call ret dest args handler :α prog))) ∧ (∀(data :knowledge) (p1 :α prog) (p2 :α prog). word_cse data (Seq p1 p2) = (let ((data1 :knowledge),(p1' :α prog)) = word_cse data p1; ((data2 :knowledge),(p2' :α prog)) = word_cse data1 p2 in (data2,Seq p1' p2'))) ∧ (∀(data :knowledge) (c :cmp) (r1 :num) (r2 :α reg_imm) (p1 :α prog) (p2 :α prog). word_cse data (If c r1 r2 p1 p2 :α prog) = (let ((data1 :knowledge),(p1' :α prog)) = word_cse data p1; ((data2 :knowledge),(p2' :α prog)) = word_cse data p2 in (merge_data data1 data2,(If c r1 r2 p1' p2' :α prog)))) ∧ (∀(data :knowledge) (b :binop) (r1 :num) (r2 :num). word_cse data (OpCurrHeap b r1 r2 :α prog) = (let (data :knowledge) = invalidate_data data r1 in if EVEN r2 ∨ r2 = r1 then (data,(OpCurrHeap b r1 r2 :α prog)) else (let (r2' :num) = canonicalRegs' r1 data r2; (pL :num list) = OpCurrHeapToNumList b r2' in add_to_data_aux (register_read data r2') r1 pL (OpCurrHeap b r1 r2 :α prog)))) ∧ (∀(data :knowledge) (r :num) (l :num). word_cse data (LocValue r l :α prog) = (let (data :knowledge) = invalidate_data data r in add_to_data_aux data r [(48 :num); l] (LocValue r l :α prog))) ∧ (∀(data :knowledge). word_cse data (Skip :α prog) = (data,(Skip :α prog))) ∧ (∀(data :knowledge) (e :α exp) (r :num). word_cse data (Store e r :α prog) = (data with loads_mem := (empty :(num list, num) balanced_map),(Store e r :α prog))) ∧ (∀(data :knowledge) (r :num) (e :α exp). word_cse data (Assign r e) = (data,Assign r e)) ∧ (∀(data :knowledge) (r :num). word_cse data (Raise r :α prog) = (data,(Raise r :α prog))) ∧ (∀(data :knowledge) (r1 :num) (r2 :num list). word_cse data (Return r1 r2 :α prog) = (data,(Return r1 r2 :α prog))) ∧ (∀(data :knowledge). word_cse data (Tick :α prog) = (data,(Tick :α prog))) ∧ (∀(data :knowledge) (r :num) (m :sptree$num_set # sptree$num_set). word_cse data (Alloc r m :α prog) = (empty_data,(Alloc r m :α prog))) ∧ (∀(data :knowledge) (p :num) (l :num) (dp :num) (dl :num) (m :sptree$num_set # sptree$num_set). word_cse data (Install p l dp dl m :α prog) = (empty_data,(Install p l dp dl m :α prog))) ∧ (∀(data :knowledge) (r1 :num) (r2 :num). word_cse data (CodeBufferWrite r1 r2 :α prog) = (data,(CodeBufferWrite r1 r2 :α prog))) ∧ (∀(data :knowledge) (r1 :num) (r2 :num). word_cse data (DataBufferWrite r1 r2 :α prog) = (data,(DataBufferWrite r1 r2 :α prog))) ∧ (∀(data :knowledge) (s :mlstring) (p1 :num) (l1 :num) (p2 :num) (l2 :num) (m :sptree$num_set # sptree$num_set). word_cse data (FFI s p1 l1 p2 l2 m :α prog) = (empty_data,(FFI s p1 l1 p2 l2 m :α prog))) ∧ (∀(data :knowledge) (r1 :num) (r2 :num) (r3 :num) (r4 :num) (payload :(bool # α word) list). word_cse data (StoreConsts r1 r2 r3 r4 payload :α prog) = (let (data :knowledge) = invalidate_regs data [r1; r2; r3; r4] in (data with loads_mem := (empty :(num list, num) balanced_map),(StoreConsts r1 r2 r3 r4 payload :α prog)))) ∧ (∀(data :knowledge) (op :memop) (r :num) (exp :α exp). word_cse data (ShareInst op r exp) = (let (data :knowledge) = if is_store op then data else invalidate_data data r in (data,ShareInst op r exp))) ∧ (∀(data :knowledge) (names :sptree$num_set) (c :α prog) (exit_names :sptree$num_set). word_cse data (Loop names c exit_names :α prog) = (let ((_0 :knowledge),(c' :α prog)) = word_cse empty_data c in (empty_data,(Loop names c' exit_names :α prog)))) ∧ (∀(data :knowledge) (k :num). word_cse data (Break k :α prog) = (data,(Break k :α prog))) ∧ ∀(data :knowledge) (k :num). word_cse data (Continue k :α prog) = (data,(Continue k :α prog))
