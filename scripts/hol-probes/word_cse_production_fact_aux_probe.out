aux_data_definition=⊢ ∀(data :knowledge) (r :num) (i :num list) (x :α prog). add_to_data_aux data r i x = case (lookup listCmp i data.instrs_mem :num option) of (NONE :num option) => if EVEN r then (data,x) else (data with <|instrs_mem := (insert listCmp i r data.instrs_mem :(num list, num) balanced_map); to_canonical := (insert r r data.to_canonical :num sptree$num_map); to_latest := (insert r r data.to_latest :num sptree$num_map)|>,x) | SOME r' => (let (k :num) = lookup_any r' data.to_latest r' in if EVEN r then (data,(Move (0 :num) [(r,k)] :α prog)) else (data with <|to_canonical := (insert r r' data.to_canonical :num sptree$num_map); to_latest := (insert r' r data.to_latest :num sptree$num_map)|>,(Move (0 :num) [(r,k)] :α prog)))
aux_load_definition=⊢ ∀(data :knowledge) (r :num) (i :num list) (x :α prog). add_to_load_aux data r i x = case (lookup listCmp i data.loads_mem :num option) of (NONE :num option) => if EVEN r then (data,x) else (data with <|loads_mem := (insert listCmp i r data.loads_mem :(num list, num) balanced_map); to_canonical := (insert r r data.to_canonical :num sptree$num_map); to_latest := (insert r r data.to_latest :num sptree$num_map)|>,x) | SOME r' => (let (k :num) = lookup_any r' data.to_latest r' in if EVEN r then (data,(Move (0 :num) [(r,k)] :α prog)) else (data with <|to_canonical := (insert r r' data.to_canonical :num sptree$num_map); to_latest := (insert r' r data.to_latest :num sptree$num_map)|>,(Move (0 :num) [(r,k)] :α prog)))
aux_data_type=:knowledge -> num -> num list -> α prog -> knowledge # α prog
aux_load_type=:knowledge -> num -> num list -> α prog -> knowledge # α prog
