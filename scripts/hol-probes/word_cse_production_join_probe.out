join_type=:knowledge -> knowledge -> knowledge
join_definition=⊢ ∀(d1 :knowledge) (d2 :knowledge). merge_data d1 d2 = <|to_canonical := inter_eq d1.to_canonical d2.to_canonical; to_latest := (LN :num sptree$num_map); gets_mem := FILTER (λ((x :store_name),(v :num)). ALOOKUP d2.gets_mem x = SOME v) d1.gets_mem; instrs_mem := bm_inter_eq d1.instrs_mem d2.instrs_mem; loads_mem := bm_inter_eq d1.loads_mem d2.loads_mem|>
join_wf_definition=⊢ ∀(data :knowledge). wf_data (:α) data ⇔ (∀(r :num) (v :num). (lookup r data.to_canonical :num option) = SOME v ⇒ (lookup v data.to_canonical :num option) = SOME v ∧ ODD r ∧ ODD v) ∧ (∀(r :num) (v :num). (lookup r data.to_latest :num option) = SOME v ⇒ r ∈ (domain data.to_canonical :num -> bool) ∧ v ∈ (domain data.to_canonical :num -> bool)) ∧ (∀(k :num list) (v :num). (lookup listCmp k data.instrs_mem :num option) = SOME v ⇒ (lookup v data.to_canonical :num option) = SOME v) ∧ (∀(a :α arith) (v :num). (lookup listCmp (instToNumList (Arith a :α inst)) data.instrs_mem :num option) = SOME v ⇒ in_names_set a data.to_canonical ∧ can_mem_arith a) ∧ (∀(op :binop) (src :num) (v :num). (lookup listCmp (OpCurrHeapToNumList op src) data.instrs_mem :num option) = SOME v ⇒ (lookup src data.to_canonical :num option) = SOME src) ∧ (∀(x :store_name) (v :num). ALOOKUP data.gets_mem x = SOME v ⇒ (lookup v data.to_canonical :num option) = SOME v) ∧ ALL_DISTINCT (MAP (FST :store_name # num -> store_name) data.gets_mem) ∧ invariant listCmp data.instrs_mem ∧ (∀(k :num list) (v :num). (lookup listCmp k data.loads_mem :num option) = SOME v ⇒ (lookup v data.to_canonical :num option) = SOME v) ∧ (∀(op :memop) (a :num) (ofs :α word) (v :num). (lookup listCmp (loadToNumList op a ofs) data.loads_mem :num option) = SOME v ⇒ (lookup a data.to_canonical :num option) = SOME a) ∧ invariant listCmp data.loads_mem
join_wf_preservation=⊢ ∀(p :α prog) (data :knowledge). wf_data (:α) data ⇒ wf_data (:α) (FST (word_cse data p))
join_fields=([SOME 11; NONE; NONE; NONE],[NONE; NONE],[SOME 11; NONE; NONE; NONE],[SOME 11; NONE; NONE; NONE],[SOME 11; NONE; NONE; NONE])
join_empty=T
join_duplicate_boundary=(SOME 11,SOME 33,F)
