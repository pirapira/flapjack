memory_source_type=:knowledge -> α inst -> knowledge # α prog
memory_source_definition=⊢ word_cseInst (data :knowledge) (Skip :α inst) = (data,(Inst (Skip :α inst) :α prog)) ∧ word_cseInst data (Const (r :num) (w :α word) :α inst) = (let (data :knowledge) = invalidate_data data r in if EVEN r then (data,(Inst (Const r w :α inst) :α prog)) else add_to_data_const data r w) ∧ word_cseInst data (Arith (a' :α arith) :α inst) = (let (r :num) = firstRegOfArith a'; (data :knowledge) = invalidate_regs data (arithWrites a'); (a'' :α arith) = canonicalArith data a'; (rds :num list) = arithReads a'' in if can_mem_arith a'' ∧ ¬MEM r rds then add_to_data (register_reads data rds) r (Arith a'' :α inst) (Arith a' :α inst) else (data,(Inst (Arith a' :α inst) :α prog))) ∧ word_cseInst data (Mem (op :memop) r (Addr (a :num) (ofs :α word))) = (if is_store op then (data with loads_mem := (empty :(num list, num) balanced_map),(Inst (Mem op r (Addr a ofs)) :α prog)) else (let (data :knowledge) = invalidate_data data r in if EVEN r ∨ EVEN a ∨ a = r then (data,(Inst (Mem op r (Addr a ofs)) :α prog)) else (let (a'' :num) = canonicalRegs' r data a in add_to_load_aux (register_read data a'') r (loadToNumList op a'' ofs) (Inst (Mem op r (Addr a ofs)) :α prog)))) ∧ word_cseInst data (FP (fp :fp) :α inst) = (invalidate_regs data (fpWrites fp),(Inst (FP fp :α inst) :α prog))
memory_inst_caller_clause=∀(data :knowledge) (i :α inst). word_cse data (Inst i :α prog) = (let ((data' :knowledge),(p :α prog)) = word_cseInst data i in (data',p))
memory_wf_definition=⊢ ∀(data :knowledge). wf_data (:α) data ⇔ (∀(r :num) (v :num). (lookup r data.to_canonical :num option) = SOME v ⇒ (lookup v data.to_canonical :num option) = SOME v ∧ ODD r ∧ ODD v) ∧ (∀(r :num) (v :num). (lookup r data.to_latest :num option) = SOME v ⇒ r ∈ (domain data.to_canonical :num -> bool) ∧ v ∈ (domain data.to_canonical :num -> bool)) ∧ (∀(k :num list) (v :num). (lookup listCmp k data.instrs_mem :num option) = SOME v ⇒ (lookup v data.to_canonical :num option) = SOME v) ∧ (∀(a :α arith) (v :num). (lookup listCmp (instToNumList (Arith a :α inst)) data.instrs_mem :num option) = SOME v ⇒ in_names_set a data.to_canonical ∧ can_mem_arith a) ∧ (∀(op :binop) (src :num) (v :num). (lookup listCmp (OpCurrHeapToNumList op src) data.instrs_mem :num option) = SOME v ⇒ (lookup src data.to_canonical :num option) = SOME src) ∧ (∀(x :store_name) (v :num). ALOOKUP data.gets_mem x = SOME v ⇒ (lookup v data.to_canonical :num option) = SOME v) ∧ ALL_DISTINCT (MAP (FST :store_name # num -> store_name) data.gets_mem) ∧ invariant listCmp data.instrs_mem ∧ (∀(k :num list) (v :num). (lookup listCmp k data.loads_mem :num option) = SOME v ⇒ (lookup v data.to_canonical :num option) = SOME v) ∧ (∀(op :memop) (a :num) (ofs :α word) (v :num). (lookup listCmp (loadToNumList op a ofs) data.loads_mem :num option) = SOME v ⇒ (lookup a data.to_canonical :num option) = SOME a) ∧ invariant listCmp data.loads_mem
