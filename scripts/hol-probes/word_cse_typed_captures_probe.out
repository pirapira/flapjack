wordToNum_def_typed=∀(w :α word). wordToNum w = w2n w
shiftToNum_def_typed=shiftToNum Lsl = (40 :num) ∧ shiftToNum Lsr = (41 :num) ∧ shiftToNum Asr = (42 :num) ∧ shiftToNum Ror = (43 :num)
arithOpToNum_def_typed=arithOpToNum Add = (35 :num) ∧ arithOpToNum Sub = (36 :num) ∧ arithOpToNum And = (37 :num) ∧ arithOpToNum Or = (38 :num) ∧ arithOpToNum Xor = (39 :num)
regImmToNumList_def_typed=(∀(r :num). regImmToNumList (Reg r :α reg_imm) = [(33 :num); r + (100 :num)]) ∧ ∀(w :α word). regImmToNumList (Imm w) = [(34 :num); wordToNum w]
arithToNumList_def_typed=(∀(op :binop) (r1 :num) (r2 :num) (ri :α reg_imm). arithToNumList (Binop op r1 r2 ri) = [(25 :num); arithOpToNum op; r2 + (100 :num)] ++ regImmToNumList ri) ∧ (∀(r1 :num) (r2 :num) (r3 :num) (r4 :num). arithToNumList (LongMul r1 r2 r3 r4 :α arith) = [(26 :num); r3 + (100 :num); r4 + (100 :num)]) ∧ (∀(r1 :num) (r2 :num) (r3 :num) (r4 :num) (r5 :num). arithToNumList (LongDiv r1 r2 r3 r4 r5 :α arith) = [(27 :num); r3 + (100 :num); r4 + (100 :num); r5 + (100 :num)]) ∧ (∀(s :ast$shift) (r1 :num) (r2 :num) (ri :α reg_imm). arithToNumList (Shift s r1 r2 ri :α arith) = [(28 :num); shiftToNum s; r2 + (100 :num)] ++ regImmToNumList ri) ∧ (∀(r1 :num) (r2 :num) (r3 :num). arithToNumList (Div r1 r2 r3 :α arith) = [(29 :num); r2 + (100 :num); r3 + (100 :num)]) ∧ (∀(r1 :num) (r2 :num) (r3 :num) (r4 :num). arithToNumList (AddCarry r1 r2 r3 r4 :α arith) = [(30 :num); r2 + (100 :num); r3 + (100 :num)]) ∧ (∀(r1 :num) (r2 :num) (r3 :num) (r4 :num). arithToNumList (AddOverflow r1 r2 r3 r4 :α arith) = [(31 :num); r2 + (100 :num); r3 + (100 :num)]) ∧ ∀(r1 :num) (r2 :num) (r3 :num) (r4 :num). arithToNumList (SubOverflow r1 r2 r3 r4 :α arith) = [(32 :num); r2 + (100 :num); r3 + (100 :num)]
memOpToNum_def_typed=memOpToNum Load = (21 :num) ∧ memOpToNum Load8 = (22 :num) ∧ memOpToNum Load16 = (46 :num) ∧ memOpToNum Load32 = (44 :num) ∧ memOpToNum Store = (23 :num) ∧ memOpToNum Store8 = (47 :num) ∧ memOpToNum Store16 = (24 :num) ∧ memOpToNum Store32 = (45 :num)
loadToNumList_def_typed=∀(op :memop) (a :num) (ofs :α word). loadToNumList op a ofs = [memOpToNum op; a + (100 :num); wordToNum ofs]
fpToNumList_def_typed=(∀(r1 :num) (r2 :num) (r3 :num). fpToNumList (FPLess r1 r2 r3) = [(5 :num); r2 + (100 :num); r3 + (100 :num)]) ∧ (∀(r1 :num) (r2 :num) (r3 :num). fpToNumList (FPLessEqual r1 r2 r3) = [(6 :num); r2 + (100 :num); r3 + (100 :num)]) ∧ (∀(r1 :num) (r2 :num) (r3 :num). fpToNumList (FPEqual r1 r2 r3) = [(7 :num); r2 + (100 :num); r3 + (100 :num)]) ∧ (∀(r1 :num) (r2 :num). fpToNumList (FPAbs r1 r2) = [(8 :num); r2 + (100 :num)]) ∧ (∀(r1 :num) (r2 :num). fpToNumList (FPNeg r1 r2) = [(9 :num); r2 + (100 :num)]) ∧ (∀(r1 :num) (r2 :num). fpToNumList (FPSqrt r1 r2) = [(10 :num); r2 + (100 :num)]) ∧ (∀(r1 :num) (r2 :num) (r3 :num). fpToNumList (FPAdd r1 r2 r3) = [(11 :num); r2 + (100 :num); r3 + (100 :num)]) ∧ (∀(r1 :num) (r2 :num) (r3 :num). fpToNumList (FPSub r1 r2 r3) = [(12 :num); r2 + (100 :num); r3 + (100 :num)]) ∧ (∀(r1 :num) (r2 :num) (r3 :num). fpToNumList (FPMul r1 r2 r3) = [(13 :num); r2 + (100 :num); r3 + (100 :num)]) ∧ (∀(r1 :num) (r2 :num) (r3 :num). fpToNumList (FPDiv r1 r2 r3) = [(14 :num); r2 + (100 :num); r3 + (100 :num)]) ∧ (∀(r1 :num) (r2 :num) (r3 :num). fpToNumList (FPFma r1 r2 r3) = [(15 :num); r1 + (100 :num); r2 + (100 :num); r3 + (100 :num)]) ∧ (∀(r1 :num) (r2 :num). fpToNumList (FPMov r1 r2) = [(16 :num); r2 + (100 :num)]) ∧ (∀(r1 :num) (r2 :num) (r3 :num). fpToNumList (FPMovToReg r1 r2 r3) = [(17 :num); r2 + (100 :num); r3 + (100 :num)]) ∧ (∀(r1 :num) (r2 :num) (r3 :num). fpToNumList (FPMovFromReg r1 r2 r3) = [(18 :num); r2 + (100 :num); r3 + (100 :num)]) ∧ (∀(r1 :num) (r2 :num). fpToNumList (FPToInt r1 r2) = [(19 :num); r2 + (100 :num)]) ∧ ∀(r1 :num) (r2 :num). fpToNumList (FPFromInt r1 r2) = [(20 :num); r2 + (100 :num)]
instToNumList_def_typed=instToNumList (Const (r :num) (w :α word) :α inst) = [(2 :num); wordToNum w] ∧ instToNumList (Arith (a :α arith) :α inst) = (3 :num)::arithToNumList a ∧ instToNumList (FP (fp :fp) :α inst) = (4 :num)::fpToNumList fp ∧ instToNumList (Skip :α inst) = [(1 :num)] ∧ instToNumList (Mem (v3 :memop) (v4 :num) (v5 :α addr)) = [(1 :num)]
OpCurrHeapToNumList_def_typed=∀(op :binop) (r2 :num). OpCurrHeapToNumList op r2 = [(0 :num); arithOpToNum op; r2 + (100 :num)]
firstRegOfArith_def_typed=(∀(v0 :binop) (r :num) (v1 :num) (v2 :α reg_imm). firstRegOfArith (Binop v0 r v1 v2) = r) ∧ (∀(v3 :ast$shift) (r :num) (v4 :num) (v5 :α reg_imm). firstRegOfArith (Shift v3 r v4 v5 :α arith) = r) ∧ (∀(r :num) (v6 :num) (v7 :num). firstRegOfArith (Div r v6 v7 :α arith) = r) ∧ (∀(r :num) (v8 :num) (v9 :num) (v10 :num). firstRegOfArith (LongMul r v8 v9 v10 :α arith) = r) ∧ (∀(r :num) (v11 :num) (v12 :num) (v13 :num) (v14 :num). firstRegOfArith (LongDiv r v11 v12 v13 v14 :α arith) = r) ∧ (∀(r :num) (v15 :num) (v16 :num) (v17 :num). firstRegOfArith (AddCarry r v15 v16 v17 :α arith) = r) ∧ (∀(r :num) (v18 :num) (v19 :num) (v20 :num). firstRegOfArith (AddOverflow r v18 v19 v20 :α arith) = r) ∧ ∀(r :num) (v21 :num) (v22 :num) (v23 :num). firstRegOfArith (SubOverflow r v21 v22 v23 :α arith) = r
arithWrites_def_typed=(∀(v0 :binop) (r :num) (v1 :num) (v2 :α reg_imm). arithWrites (Binop v0 r v1 v2) = [r]) ∧ (∀(v3 :ast$shift) (r :num) (v4 :num) (v5 :α reg_imm). arithWrites (Shift v3 r v4 v5 :α arith) = [r]) ∧ (∀(r :num) (v6 :num) (v7 :num). arithWrites (Div r v6 v7 :α arith) = [r]) ∧ (∀(r1 :num) (r2 :num) (v8 :num) (v9 :num). arithWrites (LongMul r1 r2 v8 v9 :α arith) = [r1; r2]) ∧ (∀(r1 :num) (r2 :num) (v10 :num) (v11 :num) (v12 :num). arithWrites (LongDiv r1 r2 v10 v11 v12 :α arith) = [r1; r2]) ∧ (∀(r1 :num) (v13 :num) (v14 :num) (r4 :num). arithWrites (AddCarry r1 v13 v14 r4 :α arith) = [r1; r4]) ∧ (∀(r1 :num) (v15 :num) (v16 :num) (r4 :num). arithWrites (AddOverflow r1 v15 v16 r4 :α arith) = [r1; r4]) ∧ ∀(r1 :num) (v17 :num) (v18 :num) (r4 :num). arithWrites (SubOverflow r1 v17 v18 r4 :α arith) = [r1; r4]
arithReads_def_typed=arithReads (Binop (v0 :binop) (v1 :num) (r2 :num) (Reg (r3 :num) :α reg_imm)) = [r2; r3] ∧ arithReads (Binop (v2 :binop) (v3 :num) r2 (Imm (v4 :α word))) = [r2] ∧ arithReads (Shift (v5 :ast$shift) (v6 :num) r2 (Reg r3 :α reg_imm) :α arith) = [r2; r3] ∧ arithReads (Shift (v7 :ast$shift) (v8 :num) r2 (Imm (v9 :α word)) :α arith) = [r2] ∧ arithReads (Div (v10 :num) r2 r3 :α arith) = [r2; r3] ∧ arithReads (LongMul (v11 :num) (v12 :num) r3 (r4 :num) :α arith) = [r3; r4] ∧ arithReads (LongDiv (v13 :num) (v14 :num) r3 r4 (r5 :num) :α arith) = [r3; r4; r5] ∧ arithReads (AddCarry (v15 :num) r2 r3 r4 :α arith) = [r2; r3; r4] ∧ arithReads (AddOverflow (v16 :num) r2 r3 (v17 :num) :α arith) = [r2; r3] ∧ arithReads (SubOverflow (v18 :num) r2 r3 (v19 :num) :α arith) = [r2; r3]
fpWrites_def_typed=fpWrites (FPLess (r :num) (v0 :num) (v1 :num)) = [r] ∧ fpWrites (FPLessEqual r (v2 :num) (v3 :num)) = [r] ∧ fpWrites (FPEqual r (v4 :num) (v5 :num)) = [r] ∧ fpWrites (FPMovToReg (r1 :num) (r2 :num) (v6 :num)) = [r1; r2] ∧ fpWrites (FPAbs (v16 :num) (v17 :num)) = ([] :num list) ∧ fpWrites (FPNeg (v18 :num) (v19 :num)) = ([] :num list) ∧ fpWrites (FPSqrt (v20 :num) (v21 :num)) = ([] :num list) ∧ fpWrites (FPAdd (v22 :num) (v23 :num) (v24 :num)) = ([] :num list) ∧ fpWrites (FPSub (v25 :num) (v26 :num) (v27 :num)) = ([] :num list) ∧ fpWrites (FPMul (v28 :num) (v29 :num) (v30 :num)) = ([] :num list) ∧ fpWrites (FPDiv (v31 :num) (v32 :num) (v33 :num)) = ([] :num list) ∧ fpWrites (FPFma (v34 :num) (v35 :num) (v36 :num)) = ([] :num list) ∧ fpWrites (FPMov (v37 :num) (v38 :num)) = ([] :num list) ∧ fpWrites (FPMovFromReg (v42 :num) (v43 :num) (v44 :num)) = ([] :num list) ∧ fpWrites (FPToInt (v45 :num) (v46 :num)) = ([] :num list) ∧ fpWrites (FPFromInt (v47 :num) (v48 :num)) = ([] :num list)
can_mem_arith_def_typed=(can_mem_arith (Binop (v0 :binop) (v1 :num) (r1 :num) (Reg (r2 :num) :α reg_imm)) ⇔ ODD r1 ∧ ODD r2) ∧ (can_mem_arith (Binop (v2 :binop) (v3 :num) r1 (Imm (v4 :α word))) ⇔ ODD r1) ∧ (can_mem_arith (Div (v5 :num) r1 r2 :α arith) ⇔ ODD r1 ∧ ODD r2) ∧ (can_mem_arith (Shift (v6 :ast$shift) (v7 :num) (r :num) (Imm (v8 :α word)) :α arith) ⇔ ODD r) ∧ (can_mem_arith (Shift (v13 :ast$shift) (v14 :num) (v15 :num) (Reg (v77 :num) :α reg_imm) :α arith) ⇔ F) ∧ (can_mem_arith (LongMul (v20 :num) (v21 :num) (v22 :num) (v23 :num) :α arith) ⇔ F) ∧ (can_mem_arith (LongDiv (v24 :num) (v25 :num) (v26 :num) (v27 :num) (v28 :num) :α arith) ⇔ F) ∧ (can_mem_arith (AddCarry (v29 :num) (v30 :num) (v31 :num) (v32 :num) :α arith) ⇔ F) ∧ (can_mem_arith (AddOverflow (v33 :num) (v34 :num) (v35 :num) (v36 :num) :α arith) ⇔ F) ∧ (can_mem_arith (SubOverflow (v37 :num) (v38 :num) (v39 :num) (v40 :num) :α arith) ⇔ F)
is_store_def_typed=(is_store Load ⇔ F) ∧ (is_store Load8 ⇔ F) ∧ (is_store Load16 ⇔ F) ∧ (is_store Load32 ⇔ F) ∧ (is_store Store ⇔ T) ∧ (is_store Store8 ⇔ T) ∧ (is_store Store16 ⇔ T) ∧ (is_store Store32 ⇔ T)
wordToNum_unique_typed=∀(c1 :α word) (c2 :α word). wordToNum c1 = wordToNum c2 ⇔ c1 = c2
arithOpToNum_eq_typed=∀(op1 :binop) (op2 :binop). arithOpToNum op1 = arithOpToNum op2 ⇔ op1 = op2
memOpToNum_eq_typed=∀(op1 :memop) (op2 :memop). memOpToNum op1 = memOpToNum op2 ⇔ op1 = op2
shiftToNum_eq_typed=∀(s1 :ast$shift) (s2 :ast$shift). shiftToNum s1 = shiftToNum s2 ⇔ s1 = s2
arith_keys_eq_typed=∀(a1 :α arith) (a2 :α arith). can_mem_arith a1 ∧ arithToNumList a1 = arithToNumList a2 ⇒ can_mem_arith a2 ∧ arithReads a2 = arithReads a1 ∧ ∀(s :(α, γ, 'ffi) state) (w :α word_loc). evaluate ((Inst (Arith a1 :α inst) :α prog),s) = ((NONE :α result option),set_var (firstRegOfArith a1) w s) ⇒ evaluate ((Inst (Arith a2 :α inst) :α prog),s) = ((NONE :α result option),set_var (firstRegOfArith a2) w s)
evaluate_load_any_dest_typed=∀(op :memop) (r0 :num) (a :num) (ofs :α word) (w :α word_loc) (s :(α, β, γ) state) (r :num). ¬is_store op ∧ evaluate ((Inst (Mem op r0 (Addr a ofs)) :α prog),s) = ((NONE :α result option),set_var r0 w s) ⇒ evaluate ((Inst (Mem op r (Addr a ofs)) :α prog),s) = ((NONE :α result option),set_var r w s)
evaluate_load_set_var_typed=∀(op :memop) (r :num) (a :num) (ofs :α word) (n :num) (u :α word_loc) (w :α word_loc) (s :(α, β, γ) state). ¬is_store op ∧ a ≠ n ⇒ (evaluate ((Inst (Mem op r (Addr a ofs)) :α prog),set_var n u s) = ((NONE :α result option),set_var r w (set_var n u s)) ⇔ evaluate ((Inst (Mem op r (Addr a ofs)) :α prog),s) = ((NONE :α result option),set_var r w s))
evaluate_arith_set_var_typed=∀(a :α arith) (r :num) (u :α word_loc) (w :α word_loc) (s :(α, β, γ) state). can_mem_arith a ∧ ¬MEM r (arithReads a) ⇒ (evaluate ((Inst (Arith a :α inst) :α prog),set_var r u s) = ((NONE :α result option),set_var (firstRegOfArith a) w (set_var r u s)) ⇔ evaluate ((Inst (Arith a :α inst) :α prog),s) = ((NONE :α result option),set_var (firstRegOfArith a) w s))
listCmp_def_typed=(∀(tl2 :num list) (tl1 :num list) (hd2 :num) (hd1 :num). listCmp (hd1::tl1) (hd2::tl2) = if hd1 = hd2 then listCmp tl1 tl2 else if hd1 > hd2 then Greater else Less) ∧ listCmp ([] :num list) ([] :num list) = Equal ∧ (∀(tl1 :num list) (hd1 :num). listCmp (hd1::tl1) ([] :num list) = Greater) ∧ ∀(tl2 :num list) (hd2 :num). listCmp ([] :num list) (hd2::tl2) = Less
listCmpEq_correct_typed=∀(L1 :num list) (L2 :num list). listCmp L1 L2 = Equal ⇔ L1 = L2
antisym_listCmp_typed=∀(x :num list) (y :num list). listCmp x y = Greater ⇔ listCmp y x = Less
transit_listCmp_typed=∀(x :num list) (y :num list) (z :num list). listCmp x y = Less ∧ listCmp y z = Less ⇒ listCmp x z = Less
knowledge_to_canonical_type=:knowledge -> num sptree$num_map
knowledge_to_latest_type=:knowledge -> num sptree$num_map
knowledge_gets_mem_type=:knowledge -> (store_name # num) list
knowledge_instrs_mem_type=:knowledge -> (num list, num) balanced_map
knowledge_loads_mem_type=:knowledge -> (num list, num) balanced_map
empty_data_def_typed=empty_data = <|to_canonical := (LN :num sptree$num_map); to_latest := (LN :num sptree$num_map); gets_mem := ([] :(store_name # num) list); instrs_mem := (empty :(num list, num) balanced_map); loads_mem := (empty :(num list, num) balanced_map)|>
keep_data_def_typed=∀(canon :α sptree$num_map) (write_to_reg :num). keep_data canon write_to_reg ⇔ IS_NONE (lookup write_to_reg canon :α option)
invalidate_data_def_typed=∀(data :knowledge) (write_to_reg :num). invalidate_data data write_to_reg = if keep_data data.to_canonical write_to_reg then data else empty_data
invalidate_regs_def_typed=(∀(data :knowledge). invalidate_regs data ([] :num list) = data) ∧ ∀(data :knowledge) (r :num) (rs :num list). invalidate_regs data (r::rs) = invalidate_regs (invalidate_data data r) rs
register_read_def_typed=∀(data :knowledge) (r :num). register_read data r = if ¬EVEN r ∧ keep_data data.to_canonical r then data with to_canonical := (insert r r data.to_canonical :num sptree$num_map) else data
register_reads_def_typed=(∀(data :knowledge). register_reads data ([] :num list) = data) ∧ ∀(data :knowledge) (r :num) (rs :num list). register_reads data (r::rs) = register_reads (register_read data r) rs
canonicalRegs_def_typed=∀(data :knowledge) (r :num). canonicalRegs data r = lookup_any r data.to_canonical r
canonicalRegs_prime_def_typed=∀(avoid :num) (data :knowledge) (r :num). canonicalRegs' avoid data r = (let (n :num) = canonicalRegs data r in if n = avoid then r else n)
canonicalMultRegs_def_typed=∀(data :knowledge) (regs :num list). canonicalMultRegs data regs = MAP (canonicalRegs data) regs
map_insert_def_typed=(∀(m :α sptree$num_map). map_insert ([] :(num # α) list) m = m) ∧ ∀(y :α) (xs :(num # α) list) (x :num) (m :α sptree$num_map). map_insert ((x,y)::xs) m = (insert x y (map_insert xs m) :α sptree$num_map)
canonicalMoveRegs_def_typed=∀(data :knowledge) (moves :(num # num) list). canonicalMoveRegs data moves = (let (data :knowledge) = register_reads data (MAP (SND :num # num -> num) moves) in if EVERY (keep_data data.to_canonical) (MAP (FST :num # num -> num) moves) then (let (xs :(num # num) list) = FILTER (λ((a :num),(b :num)). ¬EVEN a ∧ ¬EVEN b) moves; (ys :(num # num) list) = MAP (λ((a :num),(b :num)). (a,canonicalRegs data b)) xs; (to_c :num sptree$num_map) = map_insert ys data.to_canonical; (zs :(num # num) list) = MAP (λ((a :num),(b :num)). (b,a)) ys; (to_l :num sptree$num_map) = map_insert zs data.to_latest in data with <|to_canonical := to_c; to_latest := to_l|>) else empty_data)
canonicalImmReg_def_typed=(∀(data :knowledge) (r :num). canonicalImmReg data (Reg r :α reg_imm) = (Reg (canonicalRegs data r) :α reg_imm)) ∧ ∀(data :knowledge) (w :α word). canonicalImmReg data (Imm w) = Imm w
canonicalImmReg_prime_def_typed=(∀(avoid :num) (data :knowledge) (r :num). canonicalImmReg' avoid data (Reg r :α reg_imm) = (Reg (canonicalRegs' avoid data r) :α reg_imm)) ∧ ∀(avoid :num) (data :knowledge) (w :α word). canonicalImmReg' avoid data (Imm w) = Imm w
canonicalArith_def_typed=(∀(data :knowledge) (op :binop) (r1 :num) (r2 :num) (r3 :α reg_imm). canonicalArith data (Binop op r1 r2 r3) = Binop op r1 (canonicalRegs' r1 data r2) (canonicalImmReg' r1 data r3)) ∧ (∀(data :knowledge) (s :ast$shift) (r1 :num) (r2 :num) (ri :α reg_imm). canonicalArith data (Shift s r1 r2 ri :α arith) = (Shift s r1 (canonicalRegs' r1 data r2) (canonicalImmReg' r1 data ri) :α arith)) ∧ (∀(data :knowledge) (r1 :num) (r2 :num) (r3 :num). canonicalArith data (Div r1 r2 r3 :α arith) = (Div r1 (canonicalRegs data r2) (canonicalRegs data r3) :α arith)) ∧ (∀(data :knowledge) (r1 :num) (r2 :num) (r3 :num) (r4 :num). canonicalArith data (LongMul r1 r2 r3 r4 :α arith) = (LongMul r1 r2 (canonicalRegs data r3) (canonicalRegs data r4) :α arith)) ∧ (∀(data :knowledge) (r1 :num) (r2 :num) (r3 :num) (r4 :num) (r5 :num). canonicalArith data (LongDiv r1 r2 r3 r4 r5 :α arith) = (LongDiv r1 r2 (canonicalRegs data r3) (canonicalRegs data r4) (canonicalRegs data r5) :α arith)) ∧ (∀(data :knowledge) (r1 :num) (r2 :num) (r3 :num) (r4 :num). canonicalArith data (AddCarry r1 r2 r3 r4 :α arith) = (AddCarry r1 (canonicalRegs' r1 data r2) (canonicalRegs' r1 data r3) r4 :α arith)) ∧ (∀(data :knowledge) (r1 :num) (r2 :num) (r3 :num) (r4 :num). canonicalArith data (AddOverflow r1 r2 r3 r4 :α arith) = (AddOverflow r1 (canonicalRegs' r1 data r2) (canonicalRegs' r1 data r3) r4 :α arith)) ∧ ∀(data :knowledge) (r1 :num) (r2 :num) (r3 :num) (r4 :num). canonicalArith data (SubOverflow r1 r2 r3 r4 :α arith) = (SubOverflow r1 (canonicalRegs' r1 data r2) (canonicalRegs' r1 data r3) r4 :α arith)
canonicalFp_def_typed=(∀(data :knowledge) (r1 :num) (r2 :num) (r3 :num). canonicalFp data (FPLess r1 r2 r3) = FPLess r1 (canonicalRegs data r2) (canonicalRegs data r3)) ∧ (∀(data :knowledge) (r1 :num) (r2 :num) (r3 :num). canonicalFp data (FPLessEqual r1 r2 r3) = FPLessEqual r1 (canonicalRegs data r2) (canonicalRegs data r3)) ∧ (∀(data :knowledge) (r1 :num) (r2 :num) (r3 :num). canonicalFp data (FPEqual r1 r2 r3) = FPEqual r1 (canonicalRegs data r2) (canonicalRegs data r3)) ∧ (∀(data :knowledge) (r1 :num) (r2 :num). canonicalFp data (FPAbs r1 r2) = FPAbs r1 (canonicalRegs data r2)) ∧ (∀(data :knowledge) (r1 :num) (r2 :num). canonicalFp data (FPNeg r1 r2) = FPNeg r1 (canonicalRegs data r2)) ∧ (∀(data :knowledge) (r1 :num) (r2 :num). canonicalFp data (FPSqrt r1 r2) = FPSqrt r1 (canonicalRegs data r2)) ∧ (∀(data :knowledge) (r1 :num) (r2 :num) (r3 :num). canonicalFp data (FPAdd r1 r2 r3) = FPAdd r1 (canonicalRegs data r2) (canonicalRegs data r3)) ∧ (∀(data :knowledge) (r1 :num) (r2 :num) (r3 :num). canonicalFp data (FPSub r1 r2 r3) = FPSub r1 (canonicalRegs data r2) (canonicalRegs data r3)) ∧ (∀(data :knowledge) (r1 :num) (r2 :num) (r3 :num). canonicalFp data (FPMul r1 r2 r3) = FPMul r1 (canonicalRegs data r2) (canonicalRegs data r3)) ∧ (∀(data :knowledge) (r1 :num) (r2 :num) (r3 :num). canonicalFp data (FPDiv r1 r2 r3) = FPDiv r1 (canonicalRegs data r2) (canonicalRegs data r3)) ∧ (∀(data :knowledge) (r1 :num) (r2 :num) (r3 :num). canonicalFp data (FPFma r1 r2 r3) = FPFma r1 (canonicalRegs data r2) (canonicalRegs data r3)) ∧ (∀(data :knowledge) (r1 :num) (r2 :num). canonicalFp data (FPMov r1 r2) = FPMov r1 (canonicalRegs data r2)) ∧ (∀(data :knowledge) (r1 :num) (r2 :num) (r3 :num). canonicalFp data (FPMovToReg r1 r2 r3) = FPMovToReg r1 (canonicalRegs data r2) (canonicalRegs data r3)) ∧ (∀(data :knowledge) (r1 :num) (r2 :num) (r3 :num). canonicalFp data (FPMovFromReg r1 r2 r3) = FPMovFromReg r1 (canonicalRegs data r2) (canonicalRegs data r3)) ∧ (∀(data :knowledge) (r1 :num) (r2 :num). canonicalFp data (FPToInt r1 r2) = FPToInt r1 (canonicalRegs data r2)) ∧ ∀(data :knowledge) (r1 :num) (r2 :num). canonicalFp data (FPFromInt r1 r2) = FPFromInt r1 (canonicalRegs data r2)
dest_Var_def_typed=dest_Var (Var (v :num) :α exp) = SOME v ∧ dest_Var (Const (v1 :α word) :α exp) = (NONE :num option) ∧ dest_Var (Lookup (v3 :store_name) :α exp) = (NONE :num option) ∧ dest_Var (Load (v4 :α exp) :α exp) = (NONE :num option) ∧ dest_Var (Op (v5 :binop) (v6 :α exp list)) = (NONE :num option) ∧ dest_Var (Shift (v7 :ast$shift) (v8 :α exp) (v9 :α exp) :α exp) = (NONE :num option)
add_to_data_aux_def_typed=∀(data :knowledge) (r :num) (i :num list) (x :α prog). add_to_data_aux data r i x = case (lookup listCmp i data.instrs_mem :num option) of (NONE :num option) => if EVEN r then (data,x) else (data with <|instrs_mem := (insert listCmp i r data.instrs_mem :(num list, num) balanced_map); to_canonical := (insert r r data.to_canonical :num sptree$num_map); to_latest := (insert r r data.to_latest :num sptree$num_map)|>,x) | SOME r' => (let (k :num) = lookup_any r' data.to_latest r' in if EVEN r then (data,(Move (0 :num) [(r,k)] :α prog)) else (data with <|to_canonical := (insert r r' data.to_canonical :num sptree$num_map); to_latest := (insert r' r data.to_latest :num sptree$num_map)|>,(Move (0 :num) [(r,k)] :α prog)))
add_to_load_aux_def_typed=∀(data :knowledge) (r :num) (i :num list) (x :α prog). add_to_load_aux data r i x = case (lookup listCmp i data.loads_mem :num option) of (NONE :num option) => if EVEN r then (data,x) else (data with <|loads_mem := (insert listCmp i r data.loads_mem :(num list, num) balanced_map); to_canonical := (insert r r data.to_canonical :num sptree$num_map); to_latest := (insert r r data.to_latest :num sptree$num_map)|>,x) | SOME r' => (let (k :num) = lookup_any r' data.to_latest r' in if EVEN r then (data,(Move (0 :num) [(r,k)] :α prog)) else (data with <|to_canonical := (insert r r' data.to_canonical :num sptree$num_map); to_latest := (insert r' r data.to_latest :num sptree$num_map)|>,(Move (0 :num) [(r,k)] :α prog)))
add_to_data_const_def_typed=∀(data :knowledge) (r :num) (w :α word). add_to_data_const data r w = (let (i :num list) = instToNumList (Const r w :α inst) in case (lookup listCmp i data.instrs_mem :num option) of (NONE :num option) => (data with <|instrs_mem := (insert listCmp i r data.instrs_mem :(num list, num) balanced_map); to_canonical := (insert r r data.to_canonical :num sptree$num_map); to_latest := (insert r r data.to_latest :num sptree$num_map)|>,(Inst (Const r w :α inst) :α prog)) | SOME r' => (data with <|to_canonical := (insert r r' data.to_canonical :num sptree$num_map); to_latest := (insert r' r data.to_latest :num sptree$num_map)|>,(Inst (Const r w :α inst) :α prog)))
bm_inter_eq_acc_def_typed=(∀(m2 :(num list, α) balanced_map) (acc :(num list, α) balanced_map). bm_inter_eq_acc m2 (Tip :(num list, α) balanced_map) acc = acc) ∧ ∀(m2 :(num list, α) balanced_map) (n :num) (k :num list) (v :α) (l :(num list, α) balanced_map) (r :(num list, α) balanced_map) (acc :(num list, α) balanced_map). bm_inter_eq_acc m2 (Bin n k v l r) acc = bm_inter_eq_acc m2 l (bm_inter_eq_acc m2 r (if (lookup listCmp k m2 :α option) = SOME v then (insert listCmp k v acc :(num list, α) balanced_map) else acc))
bm_inter_eq_def_typed=∀(m1 :(num list, α) balanced_map) (m2 :(num list, α) balanced_map). bm_inter_eq m1 m2 = bm_inter_eq_acc m2 m1 (empty :(num list, α) balanced_map)
merge_data_def_typed=∀(d1 :knowledge) (d2 :knowledge). merge_data d1 d2 = <|to_canonical := inter_eq d1.to_canonical d2.to_canonical; to_latest := (LN :num sptree$num_map); gets_mem := FILTER (λ((x :store_name),(v :num)). ALOOKUP d2.gets_mem x = SOME v) d1.gets_mem; instrs_mem := bm_inter_eq d1.instrs_mem d2.instrs_mem; loads_mem := bm_inter_eq d1.loads_mem d2.loads_mem|>
in_names_set_def_typed=∀(a :α arith) (tc :num sptree$num_map). in_names_set a tc ⇔ EVERY (λ(r :num). (lookup r tc :num option) = SOME r) (arithReads a)
TotOrd_listCmp_typed=TotOrd listCmp
good_cmp_listCmp_typed=good_cmp listCmp
invariant_bm_inter_eq_typed=∀(m1 :(num list, α) balanced_map) (m2 :(num list, α) balanced_map). invariant listCmp m1 ∧ invariant listCmp m2 ⇒ invariant listCmp (bm_inter_eq m1 m2)
wf_data_def_typed=∀(data :knowledge). wf_data (:α) data ⇔ (∀(r :num) (v :num). (lookup r data.to_canonical :num option) = SOME v ⇒ (lookup v data.to_canonical :num option) = SOME v ∧ ODD r ∧ ODD v) ∧ (∀(r :num) (v :num). (lookup r data.to_latest :num option) = SOME v ⇒ r ∈ (domain data.to_canonical :num -> bool) ∧ v ∈ (domain data.to_canonical :num -> bool)) ∧ (∀(k :num list) (v :num). (lookup listCmp k data.instrs_mem :num option) = SOME v ⇒ (lookup v data.to_canonical :num option) = SOME v) ∧ (∀(a :α arith) (v :num). (lookup listCmp (instToNumList (Arith a :α inst)) data.instrs_mem :num option) = SOME v ⇒ in_names_set a data.to_canonical ∧ can_mem_arith a) ∧ (∀(op :binop) (src :num) (v :num). (lookup listCmp (OpCurrHeapToNumList op src) data.instrs_mem :num option) = SOME v ⇒ (lookup src data.to_canonical :num option) = SOME src) ∧ (∀(x :store_name) (v :num). ALOOKUP data.gets_mem x = SOME v ⇒ (lookup v data.to_canonical :num option) = SOME v) ∧ ALL_DISTINCT (MAP (FST :store_name # num -> store_name) data.gets_mem) ∧ invariant listCmp data.instrs_mem ∧ (∀(k :num list) (v :num). (lookup listCmp k data.loads_mem :num option) = SOME v ⇒ (lookup v data.to_canonical :num option) = SOME v) ∧ (∀(op :memop) (a :num) (ofs :α word) (v :num). (lookup listCmp (loadToNumList op a ofs) data.loads_mem :num option) = SOME v ⇒ (lookup a data.to_canonical :num option) = SOME a) ∧ invariant listCmp data.loads_mem
lookup_bm_inter_eq_typed=∀(m1 :(num list, α) balanced_map) (m2 :(num list, α) balanced_map) (k :num list) (v :α). invariant listCmp m1 ∧ invariant listCmp m2 ⇒ ((lookup listCmp k (bm_inter_eq m1 m2) :α option) = SOME v ⇔ (lookup listCmp k m1 :α option) = SOME v ∧ (lookup listCmp k m2 :α option) = SOME v)
firstRegOfArith_canonicalArith_typed=∀(data :knowledge) (a :α arith). firstRegOfArith (canonicalArith data a) = firstRegOfArith a
lookup_listCmp_empty_typed=(lookup listCmp (k :num list) (empty :(num list, α) balanced_map) :α option) = (NONE :α option)
invariant_listCmp_empty_typed=invariant listCmp (empty :(num list, α) balanced_map)
register_read_simps_typed=(register_read (data :knowledge) (r :num)).instrs_mem = data.instrs_mem ∧ (register_read data r).to_latest = data.to_latest ∧ (register_read data r).gets_mem = data.gets_mem ∧ (register_read data r).loads_mem = data.loads_mem
register_reads_simps_typed=∀(rs :num list) (data :knowledge). (register_reads data rs).instrs_mem = data.instrs_mem ∧ (register_reads data rs).to_latest = data.to_latest ∧ (register_reads data rs).gets_mem = data.gets_mem ∧ (register_reads data rs).loads_mem = data.loads_mem
lookup_register_read_typed=(lookup (x :num) (register_read (data :knowledge) (r :num)).to_canonical :num option) = if x = r ∧ ¬EVEN r ∧ (lookup r data.to_canonical :num option) = (NONE :num option) then SOME r else (lookup x data.to_canonical :num option)
lookup_register_reads_typed=∀(rs :num list) (data :knowledge) (x :num). (lookup x (register_reads data rs).to_canonical :num option) = if MEM x rs ∧ ¬EVEN x ∧ (lookup x data.to_canonical :num option) = (NONE :num option) then SOME x else (lookup x data.to_canonical :num option)
sem_inv_def_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state). sem_inv data s ⇔ (∀(r :num) (v :num). (lookup r data.to_canonical :num option) = SOME v ⇒ get_var r s = get_var v s) ∧ (∀(r :num) (v :num). (lookup r data.to_latest :num option) = SOME v ⇒ get_var r s = get_var v s) ∧ (∀(n :num) (c :α word) (v :num). (lookup listCmp (instToNumList (Const n c :α inst)) data.instrs_mem :num option) = SOME v ⇒ (lookup v s.locals :α word_loc option) = SOME (Word c)) ∧ (∀(a :α arith) (v :num). (lookup listCmp (instToNumList (Arith a :α inst)) data.instrs_mem :num option) = SOME v ⇒ ∃(w :α word_loc). get_var v s = SOME w ∧ evaluate ((Inst (Arith a :α inst) :α prog),s) = ((NONE :α result option),set_var (firstRegOfArith a) w s)) ∧ (∀(op :binop) (src :num) (v :num). (lookup listCmp (OpCurrHeapToNumList op src) data.instrs_mem :num option) = SOME v ⇒ ∃(w :α word_loc). (word_exp s (Op op [(Var src :α exp); (Lookup CurrHeap :α exp)]) :α word_loc option) = SOME w ∧ get_var v s = SOME w) ∧ (∀(l :num) (v :num). (lookup listCmp [(48 :num); l] data.instrs_mem :num option) = SOME v ⇒ (lookup v s.locals :α word_loc option) = SOME (Loc l (0 :num) :α word_loc)) ∧ (∀(x :store_name) (v :num). ALOOKUP data.gets_mem x = SOME v ⇒ ∃(w :α word_loc). FLOOKUP s.store x = SOME w ∧ get_var v s = SOME w) ∧ ∀(op :memop) (a :num) (ofs :α word) (v :num). ¬is_store op ∧ (lookup listCmp (loadToNumList op a ofs) data.loads_mem :num option) = SOME v ⇒ ∃(w :α word_loc). get_var v s = SOME w ∧ ∀(r :num). evaluate ((Inst (Mem op r (Addr a ofs)) :α prog),s) = ((NONE :α result option),set_var r w s)
data_inv_def_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state). data_inv data s ⇔ wf_data (:α) data ∧ sem_inv data s
data_inv_empty_typed=∀(s :(α, β, γ) state). data_inv empty_data s
canonicalRegs_correct_typed=∀(data :knowledge) (r :num) (s :(α, β, γ) state). data_inv data s ⇒ get_var (canonicalRegs data r) s = get_var r s
canonicalRegs_prime_correct_typed=∀(a :num) (data :knowledge) (r :num) (s :(α, β, γ) state). data_inv data s ⇒ get_var (canonicalRegs' a data r) s = get_var r s
canonicalRegs_correct_bis_typed=∀(data :knowledge) (r :num) (s :(α, β, γ) state). data_inv data s ⇒ (lookup (canonicalRegs data r) s.locals :α word_loc option) = (lookup r s.locals :α word_loc option)
wf_data_empty_typed=wf_data (:α) empty_data
wf_data_loads_wipe_typed=∀(data :knowledge). wf_data (:α) data ⇒ wf_data (:α) (data with loads_mem := (empty :(num list, num) balanced_map))
wf_data_invalidate_typed=∀(data :knowledge) (r :num). wf_data (:α) data ⇒ wf_data (:α) (invalidate_data data r)
wf_data_invalidate_regs_typed=∀(rs :num list) (data :knowledge). wf_data (:α) data ⇒ wf_data (:α) (invalidate_regs data rs)
wf_data_insert_to_canonical_typed=∀(data :knowledge) (x :num) (y :num). wf_data (:α) data ∧ (lookup x data.to_canonical :num option) = (NONE :num option) ∧ (lookup y (insert x y data.to_canonical :num sptree$num_map) :num option) = SOME y ∧ ODD x ∧ ODD y ⇒ wf_data (:α) (data with to_canonical := (insert x y data.to_canonical :num sptree$num_map))
wf_data_insert_to_latest_typed=∀(data :knowledge) (x :num) (y :num). wf_data (:α) data ∧ x ∈ (domain data.to_canonical :num -> bool) ∧ y ∈ (domain data.to_canonical :num -> bool) ⇒ wf_data (:α) (data with to_latest := (insert x y data.to_latest :num sptree$num_map))
wf_data_register_read_typed=∀(data :knowledge) (r :num). wf_data (:α) data ⇒ wf_data (:α) (register_read data r)
wf_data_register_reads_typed=∀(rs :num list) (data :knowledge). wf_data (:α) data ⇒ wf_data (:α) (register_reads data rs)
wf_add_to_data_const_typed=∀(data :knowledge) (r :num) (w :α word) (data' :knowledge) (p' :α prog). wf_data (:α) data ∧ (lookup r data.to_canonical :num option) = (NONE :num option) ∧ ¬EVEN r ∧ add_to_data_const data r w = (data',p') ⇒ wf_data (:α) data'
wf_add_to_load_aux_typed=∀(data :knowledge) (r :num) (i :num list) (p :α prog) (data' :knowledge) (p' :α prog). wf_data (:α) data ∧ (lookup r data.to_canonical :num option) = (NONE :num option) ∧ add_to_load_aux data r i p = (data',p') ∧ (¬EVEN r ⇒ wf_data (:α) (data with <|loads_mem := (insert listCmp i r (data with to_canonical := (insert r r data.to_canonical :num sptree$num_map)).loads_mem :(num list, num) balanced_map); to_canonical := (insert r r data.to_canonical :num sptree$num_map)|>)) ⇒ wf_data (:α) data'
wf_data_merge_typed=∀(d1 :knowledge) (d2 :knowledge). wf_data (:α) d1 ∧ wf_data (:α) d2 ⇒ wf_data (:α) (merge_data d1 d2)
wf_canonicalMoveRegs_typed=∀(data :knowledge) (rs :(num # num) list). wf_data (:α) data ⇒ wf_data (:α) (canonicalMoveRegs data rs)
word_cseInst_def_typed=word_cseInst (data :knowledge) (Skip :α inst) = (data,(Inst (Skip :α inst) :α prog)) ∧ word_cseInst data (Const (r :num) (w :α word) :α inst) = (let (data :knowledge) = invalidate_data data r in if EVEN r then (data,(Inst (Const r w :α inst) :α prog)) else add_to_data_const data r w) ∧ word_cseInst data (Arith (a' :α arith) :α inst) = (let (r :num) = firstRegOfArith a'; (data :knowledge) = invalidate_regs data (arithWrites a'); (a'' :α arith) = canonicalArith data a'; (rds :num list) = arithReads a'' in if can_mem_arith a'' ∧ ¬MEM r rds then add_to_data (register_reads data rds) r (Arith a'' :α inst) (Arith a' :α inst) else (data,(Inst (Arith a' :α inst) :α prog))) ∧ word_cseInst data (Mem (op :memop) r (Addr (a :num) (ofs :α word))) = (if is_store op then (data with loads_mem := (empty :(num list, num) balanced_map),(Inst (Mem op r (Addr a ofs)) :α prog)) else (let (data :knowledge) = invalidate_data data r in if EVEN r ∨ EVEN a ∨ a = r then (data,(Inst (Mem op r (Addr a ofs)) :α prog)) else (let (a'' :num) = canonicalRegs' r data a in add_to_load_aux (register_read data a'') r (loadToNumList op a'' ofs) (Inst (Mem op r (Addr a ofs)) :α prog)))) ∧ word_cseInst data (FP (fp :fp) :α inst) = (invalidate_regs data (fpWrites fp),(Inst (FP fp :α inst) :α prog))
word_cse_def_typed=(∀(data :knowledge) (r :num) (rs :(num # num) list). word_cse data (Move r rs :α prog) = (let (data' :knowledge) = canonicalMoveRegs data rs in (data',(Move r rs :α prog)))) ∧ (∀(data :knowledge) (i :α inst). word_cse data (Inst i :α prog) = (let ((data' :knowledge),(p :α prog)) = word_cseInst data i in (data',p))) ∧ (∀(data :knowledge) (r :num) (x :store_name). word_cse data (Get r x :α prog) = (let (data :knowledge) = invalidate_data data r in case ALOOKUP data.gets_mem x of (NONE :num option) => if EVEN r then (data,(Get r x :α prog)) else (data with <|gets_mem := (x,r)::data.gets_mem; to_canonical := (insert r r data.to_canonical :num sptree$num_map); to_latest := (insert r r data.to_latest :num sptree$num_map)|>,(Get r x :α prog)) | SOME k => if EVEN r then (data,(Move (1 :num) [(r,lookup_any k data.to_latest k)] :α prog)) else (data with <|to_canonical := (insert r k data.to_canonical :num sptree$num_map); to_latest := (insert k r data.to_latest :num sptree$num_map)|>,(Move (1 :num) [(r,lookup_any k data.to_latest k)] :α prog)))) ∧ (∀(data :knowledge) (x :store_name) (e :α exp). word_cse data (Set x e :α prog) = if x = CurrHeap then (empty_data,(Set x e :α prog)) else (let (new_gets_mem :(store_name # num) list) = FILTER (λ((m :store_name),(n :num)). m ≠ x) data.gets_mem in case dest_Var e of (NONE :num option) => (data with gets_mem := new_gets_mem,(Set x e :α prog)) | SOME v => if EVEN v then (data with gets_mem := new_gets_mem,(Set x e :α prog)) else (data with <|gets_mem := (x,canonicalRegs data v)::new_gets_mem; to_canonical := (insert v (lookup_any v data.to_canonical v) data.to_canonical :num sptree$num_map)|>,(Set x e :α prog)))) ∧ (∀(data :knowledge) (p :α prog). word_cse data (MustTerminate p) = (let ((data' :knowledge),(p' :α prog)) = word_cse data p in (data',MustTerminate p'))) ∧ (∀(data :knowledge) (ret :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) (dest :num option) (args :num list) (handler :(num # α prog # num # num) option). word_cse data (Call ret dest args handler :α prog) = (empty_data,(Call ret dest args handler :α prog))) ∧ (∀(data :knowledge) (p1 :α prog) (p2 :α prog). word_cse data (Seq p1 p2) = (let ((data1 :knowledge),(p1' :α prog)) = word_cse data p1; ((data2 :knowledge),(p2' :α prog)) = word_cse data1 p2 in (data2,Seq p1' p2'))) ∧ (∀(data :knowledge) (c :cmp) (r1 :num) (r2 :α reg_imm) (p1 :α prog) (p2 :α prog). word_cse data (If c r1 r2 p1 p2 :α prog) = (let ((data1 :knowledge),(p1' :α prog)) = word_cse data p1; ((data2 :knowledge),(p2' :α prog)) = word_cse data p2 in (merge_data data1 data2,(If c r1 r2 p1' p2' :α prog)))) ∧ (∀(data :knowledge) (b :binop) (r1 :num) (r2 :num). word_cse data (OpCurrHeap b r1 r2 :α prog) = (let (data :knowledge) = invalidate_data data r1 in if EVEN r2 ∨ r2 = r1 then (data,(OpCurrHeap b r1 r2 :α prog)) else (let (r2' :num) = canonicalRegs' r1 data r2; (pL :num list) = OpCurrHeapToNumList b r2' in add_to_data_aux (register_read data r2') r1 pL (OpCurrHeap b r1 r2 :α prog)))) ∧ (∀(data :knowledge) (r :num) (l :num). word_cse data (LocValue r l :α prog) = (let (data :knowledge) = invalidate_data data r in add_to_data_aux data r [(48 :num); l] (LocValue r l :α prog))) ∧ (∀(data :knowledge). word_cse data (Skip :α prog) = (data,(Skip :α prog))) ∧ (∀(data :knowledge) (e :α exp) (r :num). word_cse data (Store e r :α prog) = (data with loads_mem := (empty :(num list, num) balanced_map),(Store e r :α prog))) ∧ (∀(data :knowledge) (r :num) (e :α exp). word_cse data (Assign r e) = (data,Assign r e)) ∧ (∀(data :knowledge) (r :num). word_cse data (Raise r :α prog) = (data,(Raise r :α prog))) ∧ (∀(data :knowledge) (r1 :num) (r2 :num list). word_cse data (Return r1 r2 :α prog) = (data,(Return r1 r2 :α prog))) ∧ (∀(data :knowledge). word_cse data (Tick :α prog) = (data,(Tick :α prog))) ∧ (∀(data :knowledge) (r :num) (m :sptree$num_set # sptree$num_set). word_cse data (Alloc r m :α prog) = (empty_data,(Alloc r m :α prog))) ∧ (∀(data :knowledge) (p :num) (l :num) (dp :num) (dl :num) (m :sptree$num_set # sptree$num_set). word_cse data (Install p l dp dl m :α prog) = (empty_data,(Install p l dp dl m :α prog))) ∧ (∀(data :knowledge) (r1 :num) (r2 :num). word_cse data (CodeBufferWrite r1 r2 :α prog) = (data,(CodeBufferWrite r1 r2 :α prog))) ∧ (∀(data :knowledge) (r1 :num) (r2 :num). word_cse data (DataBufferWrite r1 r2 :α prog) = (data,(DataBufferWrite r1 r2 :α prog))) ∧ (∀(data :knowledge) (s :mlstring) (p1 :num) (l1 :num) (p2 :num) (l2 :num) (m :sptree$num_set # sptree$num_set). word_cse data (FFI s p1 l1 p2 l2 m :α prog) = (empty_data,(FFI s p1 l1 p2 l2 m :α prog))) ∧ (∀(data :knowledge) (r1 :num) (r2 :num) (r3 :num) (r4 :num) (payload :(bool # α word) list). word_cse data (StoreConsts r1 r2 r3 r4 payload :α prog) = (let (data :knowledge) = invalidate_regs data [r1; r2; r3; r4] in (data with loads_mem := (empty :(num list, num) balanced_map),(StoreConsts r1 r2 r3 r4 payload :α prog)))) ∧ (∀(data :knowledge) (op :memop) (r :num) (exp :α exp). word_cse data (ShareInst op r exp) = (let (data :knowledge) = if is_store op then data else invalidate_data data r in (data,ShareInst op r exp))) ∧ (∀(data :knowledge) (names :sptree$num_set) (c :α prog) (exit_names :sptree$num_set). word_cse data (Loop names c exit_names :α prog) = (let ((_0 :knowledge),(c' :α prog)) = word_cse empty_data c in (empty_data,(Loop names c' exit_names :α prog)))) ∧ (∀(data :knowledge) (k :num). word_cse data (Break k :α prog) = (data,(Break k :α prog))) ∧ ∀(data :knowledge) (k :num). word_cse data (Continue k :α prog) = (data,(Continue k :α prog))
word_common_subexp_elim_def_typed=∀(prog :α prog). word_common_subexp_elim prog = (let ((_0 :knowledge),(new_prog :α prog)) = word_cse empty_data prog in new_prog)
word_cse_wf_data_typed=∀(p :α prog) (data :knowledge). wf_data (:α) data ⇒ wf_data (:α) (FST (word_cse data p))
canonicalArith_correct_typed=∀(data :knowledge) (s :(α, β, γ) state) (a :α arith). data_inv data s ⇒ inst (Arith (canonicalArith data a) :α inst) s = inst (Arith a :α inst) s
data_inv_locals_typed=∀(s :(α, β, γ) state). s with locals := s.locals = s
wf_data_untracked_typed=∀(data :knowledge) (n :num). wf_data (:α) data ∧ (lookup n data.to_canonical :num option) = (NONE :num option) ⇒ (∀(r :num) (v :num). (lookup r data.to_canonical :num option) = SOME v ⇒ r ≠ n ∧ v ≠ n) ∧ (∀(r :num) (v :num). (lookup r data.to_latest :num option) = SOME v ⇒ r ≠ n ∧ v ≠ n) ∧ (∀(k :num list) (v :num). (lookup listCmp k data.instrs_mem :num option) = SOME v ⇒ v ≠ n) ∧ (∀(a :α arith) (v :num). (lookup listCmp (instToNumList (Arith a :α inst)) data.instrs_mem :num option) = SOME v ⇒ ¬MEM n (arithReads a) ∧ can_mem_arith a) ∧ (∀(op :binop) (src :num) (v :num). (lookup listCmp (OpCurrHeapToNumList op src) data.instrs_mem :num option) = SOME v ⇒ src ≠ n) ∧ (∀(x :store_name) (v :num). ALOOKUP data.gets_mem x = SOME v ⇒ v ≠ n) ∧ (∀(k :num list) (v :num). (lookup listCmp k data.loads_mem :num option) = SOME v ⇒ v ≠ n) ∧ ∀(op :memop) (a :num) (ofs :α word) (v :num). (lookup listCmp (loadToNumList op a ofs) data.loads_mem :num option) = SOME v ⇒ a ≠ n
data_inv_set_var_typed=∀(data :knowledge) (s :(α, β, γ) state) (n :num) (v :α word_loc). (lookup n data.to_canonical :num option) = (NONE :num option) ⇒ (data_inv data (set_var n v s) ⇔ data_inv data s)
data_inv_unset_var_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (n :num). (lookup n data.to_canonical :num option) = (NONE :num option) ⇒ (data_inv data (unset_var n s) ⇔ data_inv data s)
not_seen_data_inv_alist_insert_typed=∀(data :knowledge) (s :(α, β, γ) state) (l :α word_loc sptree$num_map) (r :num) (v :α word_loc). (lookup r data.to_canonical :num option) = (NONE :num option) ⇒ data_inv data (s with locals := l) ⇒ data_inv data (s with locals := (insert r v l :α word_loc sptree$num_map))
data_inv_memory_typed=∀(data :knowledge) (s :(α, β, γ) state) (m :α word -> α word_loc). data_inv data s ⇒ data_inv (data with loads_mem := (empty :(num list, num) balanced_map)) (s with memory := m)
empty_data_loads_wipe_typed=empty_data with loads_mem := (empty :(num list, num) balanced_map) = empty_data
lookup_empty_data_typed=(lookup (r :num) empty_data.to_canonical :num option) = (NONE :num option)
data_inv_merge_l_typed=∀(d1 :knowledge) (d2 :knowledge) (s :(α, γ, 'ffi) state). wf_data (:α) d1 ∧ wf_data (:α) d2 ∧ sem_inv d1 s ⇒ data_inv (merge_data d1 d2) s
data_inv_merge_r_typed=∀(d1 :knowledge) (d2 :knowledge) (s :(α, γ, 'ffi) state). wf_data (:α) d1 ∧ wf_data (:α) d2 ∧ sem_inv d2 s ⇒ data_inv (merge_data d1 d2) s
data_inv_insert_to_canonical_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (x :num) (y :num). data_inv data s ∧ (lookup x data.to_canonical :num option) = (NONE :num option) ∧ (lookup y (insert x y data.to_canonical :num sptree$num_map) :num option) = SOME y ∧ ODD x ∧ ODD y ∧ get_var x s = get_var y s ⇒ data_inv (data with to_canonical := (insert x y data.to_canonical :num sptree$num_map)) s
data_inv_insert_to_latest_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (x :num) (y :num). data_inv data s ∧ x ∈ (domain data.to_canonical :num -> bool) ∧ y ∈ (domain data.to_canonical :num -> bool) ∧ get_var x s = get_var y s ⇒ data_inv (data with to_latest := (insert x y data.to_latest :num sptree$num_map)) s
data_inv_register_read_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (r :num). data_inv data s ⇒ data_inv (register_read data r) s
data_inv_register_reads_typed=∀(rs :num list) (data :knowledge) (s :(α, γ, 'ffi) state). data_inv data s ⇒ data_inv (register_reads data rs) s
data_inv_set_fp_var_typed=∀(data :knowledge) (v :num) (x :word64) (s :(α, γ, 'ffi) state). data_inv data (set_fp_var v x s) ⇔ data_inv data s
data_inv_set_vars_typed=∀(xs :num list) (ys :α word_loc list) (data :knowledge) (s :(α, γ, 'ffi) state). EVERY (λ(x :num). (lookup x data.to_canonical :num option) = (NONE :num option)) xs ⇒ (data_inv data (set_vars xs ys s) ⇔ data_inv data s)
evaluate_Move1_typed=∀(pri :num) (r :num) (k :num) (w :α word_loc) (s :(α, γ, 'ffi) state). get_var k s = SOME w ⇒ evaluate ((Move pri [(r,k)] :α prog),s) = ((NONE :α result option),set_var r w s)
add_to_data_aux_correct_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (r :num) (i :num list) (p :α prog) (w :α word_loc) (data' :knowledge) (p' :α prog). data_inv data s ∧ (lookup r data.to_canonical :num option) = (NONE :num option) ∧ add_to_data_aux data r i p = (data',p') ∧ evaluate (p,s) = ((NONE :α result option),set_var r w s) ∧ (∀(v :num). (lookup listCmp i data.instrs_mem :num option) = SOME v ⇒ get_var v s = SOME w) ∧ (¬EVEN r ⇒ data_inv (data with <|instrs_mem := (insert listCmp i r (data with to_canonical := (insert r r data.to_canonical :num sptree$num_map)).instrs_mem :(num list, num) balanced_map); to_canonical := (insert r r data.to_canonical :num sptree$num_map)|>) (set_var r w s)) ⇒ evaluate (p',s) = ((NONE :α result option),set_var r w s) ∧ data_inv data' (set_var r w s)
add_to_data_const_correct_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (r :num) (w :α word) (data' :knowledge) (p' :α prog). data_inv data s ∧ (lookup r data.to_canonical :num option) = (NONE :num option) ∧ ¬EVEN r ∧ add_to_data_const data r w = (data',p') ⇒ evaluate (p',s) = ((NONE :α result option),set_var r (Word w) s) ∧ data_inv data' (set_var r (Word w) s)
add_to_data_LocValue_correct_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (r :num) (l :num) (data' :knowledge) (p' :α prog). data_inv data s ∧ (lookup r data.to_canonical :num option) = (NONE :num option) ∧ l ∈ (domain s.code :num -> bool) ∧ add_to_data_aux data r [(48 :num); l] (LocValue r l :α prog) = (data',p') ⇒ evaluate (p',s) = ((NONE :α result option),set_var r (Loc l (0 :num) :α word_loc) s) ∧ data_inv data' (set_var r (Loc l (0 :num) :α word_loc) s)
add_to_data_OpCurrHeap_correct_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (b :binop) (r1 :num) (r2 :num) (r2' :num) (w :α word_loc) (data' :knowledge) (p' :α prog). data_inv data s ∧ (lookup r1 data.to_canonical :num option) = (NONE :num option) ∧ r2' = canonicalRegs' r1 data r2 ∧ ¬EVEN r2 ∧ r2 ≠ r1 ∧ (word_exp s (Op b [(Var r2 :α exp); (Lookup CurrHeap :α exp)]) :α word_loc option) = SOME w ∧ add_to_data_aux (register_read data r2') r1 (OpCurrHeapToNumList b r2') (OpCurrHeap b r1 r2 :α prog) = (data',p') ⇒ evaluate (p',s) = ((NONE :α result option),set_var r1 w s) ∧ data_inv data' (set_var r1 w s)
add_to_load_aux_correct_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (r :num) (i :num list) (p :α prog) (w :α word_loc) (data' :knowledge) (p' :α prog). data_inv data s ∧ (lookup r data.to_canonical :num option) = (NONE :num option) ∧ add_to_load_aux data r i p = (data',p') ∧ evaluate (p,s) = ((NONE :α result option),set_var r w s) ∧ (∀(v :num). (lookup listCmp i data.loads_mem :num option) = SOME v ⇒ get_var v s = SOME w) ∧ (¬EVEN r ⇒ data_inv (data with <|loads_mem := (insert listCmp i r (data with to_canonical := (insert r r data.to_canonical :num sptree$num_map)).loads_mem :(num list, num) balanced_map); to_canonical := (insert r r data.to_canonical :num sptree$num_map)|>) (set_var r w s)) ⇒ evaluate (p',s) = ((NONE :α result option),set_var r w s) ∧ data_inv data' (set_var r w s)
add_to_load_correct_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (op :memop) (r :num) (a :num) (a' :num) (ofs :α word) (w :α word_loc) (data' :knowledge) (p' :α prog). data_inv data s ∧ (lookup r data.to_canonical :num option) = (NONE :num option) ∧ a' = canonicalRegs' r data a ∧ ¬is_store op ∧ ¬EVEN r ∧ ¬EVEN a ∧ a ≠ r ∧ evaluate ((Inst (Mem op r (Addr a ofs)) :α prog),s) = ((NONE :α result option),set_var r w s) ∧ add_to_load_aux (register_read data a') r (loadToNumList op a' ofs) (Inst (Mem op r (Addr a ofs)) :α prog) = (data',p') ⇒ evaluate (p',s) = ((NONE :α result option),set_var r w s) ∧ data_inv data' (set_var r w s)
