reInst op v (Var temp :α exp))) | Op Add (exp'::(Shift v42 v43 v44 :α exp)::v26) => (let (prog :α prog) = inst_select_exp c temp temp exp in Seq prog (ShareInst op v (Var temp :α exp))) | Op Sub v15 => (let (prog :α prog) = inst_select_exp c temp temp exp in Seq prog (ShareInst op v (Var temp :α exp))) | Op And v15 => (let (prog :α prog) = inst_select_exp c temp temp exp in Seq prog (ShareInst op v (Var temp :α exp))) | Op Or v15 => (let (prog :α prog) = inst_select_exp c temp temp exp in Seq prog (ShareInst op v (Var temp :α exp))) | Op Xor v15 => (let (prog :α prog) = inst_select_exp c temp temp exp in Seq prog (ShareInst op v (Var temp :α exp))) | (Shift v16 v17 v18 :α exp) => (let (prog :α prog) = inst_select_exp c temp temp exp in Seq prog (ShareInst op v (Var temp :α exp))))) ∧ (∀(temp :num) (ri :α reg_imm) (r1 :num) (cmp :cmp) (c2 :α prog) (c1 :α prog) (c :α asm_config). inst_select c temp (If cmp r1 ri c1 c2 :α prog) = (If cmp r1 ri (inst_select c temp c1) (inst_select c temp c2) :α prog)) ∧ (∀(temp :num) (ret :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) (handler :(num # α prog # num # num) option) (dest :num option) (c :α asm_config) (args :num list). inst_select c temp (Call ret dest args handler :α prog) = (let (retsel :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) = case ret of (NONE :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) => (NONE :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) | SOME (n,names,ret_handler,l1,l2) => SOME (n,names,inst_select c temp ret_handler,l1,l2); (handlersel :(num # α prog # num # num) option) = case handler of (NONE :(num # α prog # num # num) option) => (NONE :(num # α prog # num # num) option) | SOME (n,h,l1,l2) => SOME (n,inst_select c temp h,l1,l2) in (Call retsel dest args handlersel :α prog))) ∧ (∀(temp :num) (names :sptree$num_set) (exit_names :sptree$num_set) (c :α asm_config) (body :α prog). inst_select c temp (Loop names body exit_names :α prog) = (Loop names (inst_select c temp body) exit_names :α prog)) ∧ (∀(temp :num) (c :α asm_config). inst_select c temp (Skip :α prog) = (Skip :α prog)) ∧ (∀(v8 :num) (v19 :(num # num) list) (temp :num) (c :α asm_config). inst_select c temp (Move v8 v19 :α prog) = (Move v8 v19 :α prog)) ∧ (∀(v20 :α inst) (temp :num) (c :α asm_config). inst_select c temp (Inst v20 :α prog) = (Inst v20 :α prog)) ∧ (∀(v29 :store_name) (v28 :num) (temp :num) (c :α asm_config). inst_select c temp (Get v28 v29 :α prog) = (Get v28 v29 :α prog)) ∧ (∀(v62 :sptree$num_set # sptree$num_set) (v61 :num) (temp :num) (c :α asm_config). inst_select c temp (Alloc v61 v62 :α prog) = (Alloc v61 v62 :α prog)) ∧ (∀(v67 :(bool # α word) list) (v66 :num) (v65 :num) (v64 :num) (v63 :num) (temp :num) (c :α asm_config). inst_select c temp (StoreConsts v63 v64 v65 v66 v67 :α prog) = (StoreConsts v63 v64 v65 v66 v67 :α prog)) ∧ (∀(v68 :num) (temp :num) (c :α asm_config). inst_select c temp (Raise v68 :α prog) = (Raise v68 :α prog)) ∧ (∀(v70 :num list) (v69 :num) (temp :num) (c :α asm_config). inst_select c temp (Return v69 v70 :α prog) = (Return v69 v70 :α prog)) ∧ (∀(v71 :num) (temp :num) (c :α asm_config). inst_select c temp (Break v71 :α prog) = (Break v71 :α prog)) ∧ (∀(v72 :num) (temp :num) (c :α asm_config). inst_select c temp (Continue v72 :α prog) = (Continue v72 :α prog)) ∧ (∀(temp :num) (c :α asm_config). inst_select c temp (Tick :α prog) = (Tick :α prog)) ∧ (∀(v75 :num) (v74 :num) (v73 :binop) (temp :num) (c :α asm_config). inst_select c temp (OpCurrHeap v73 v74 v75 :α prog) = (OpCurrHeap v73 v74 v75 :α prog)) ∧ (∀(v77 :num) (v76 :num) (temp :num) (c :α asm_config). inst_select c temp (LocValue v76 v77 :α prog) = (LocValue v76 v77 :α prog)) ∧ (∀(v82 :sptree$num_set # sptree$num_set) (v81 :num) (v80 :num) (v79 :num) (v78 :num) (temp :num) (c :α asm_config). inst_select c temp (Install v78 v79 v80 v81 v82 :α prog) = (Install v78 v79 v80 v81 v82 :α prog)) ∧