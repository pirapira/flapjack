compCorrectMove_typed=∀(s :(α, num # γ, 'ffi) state) (move_priority :num) (move_pairs :(num # num) list) (ac :α asm_config) (k :num) (f :num) (f' :num) (res :α wordSem$result option) (s1 :(α, num # γ, 'ffi) state) (t :(α, γ, 'ffi) stackSem$state) (bs :α word app_list) (n :num) (bs' :α word app_list) (n' :num) (sprog :α stackLang$prog) (lens :num list). (evaluate ((Move move_priority move_pairs :α prog),s) :α wordSem$result option # (α, num # γ, 'ffi) state) = (res,s1) ∧ res ≠ SOME (Error :α wordSem$result) ∧ state_rel ac k f f' s t lens (0 :num) ∧ post_alloc_conventions k (Move move_priority move_pairs :α prog) ∧ flat_exp_conventions (Move move_priority move_pairs :α prog) ∧ (comp ac F (Move move_priority move_pairs :α prog) (bs,n) (k,f,f') :α stackLang$prog # α word app_list # num) = (sprog,bs',n') ∧ LENGTH (append bs) ≤ n ∧ n − LENGTH (append bs) ≤ LENGTH t.bitmaps ∧ append bs' ≼ DROP (n − LENGTH (append bs)) t.bitmaps ∧ get_labels sprog ⊆ loc_check t.code ∧ max_var (Move move_priority move_pairs :α prog) < (2 :num) * f' + (2 :num) * k ⇒ ∃(ck :num) (t1 :(α, γ, 'ffi) stackSem$state) (res1 :α stackSem$result option). (evaluate (sprog,t with clock := t.clock + ck) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = (res1,t1) ∧ if OPTION_MAP (compile_result :α wordSem$result -> α stackSem$result) res ≠ res1 then res1 = SOME (Halt (Word (2w :α word)) :α stackSem$result) ∧ t1.ffi.io_events ≼ s1.ffi.io_events ∧ the (s1.stack_limit + (1 :num)) s1.stack_max > s1.stack_limit else case res of (NONE :α wordSem$result option) => state_rel ac k f f' s1 t1 lens (0 :num) | SOME (Result v8 ys :α wordSem$result) => state_rel ac k (0 :num) (0 :num) s1 t1 lens (LENGTH ys − (k − (1 :num))) ∧ ∀(i :num). i < LENGTH ys ⇒ if i + (1 :num) < k then FLOOKUP t1.regs (i + (1 :num)) = SOME ys❲i❳ else LLOOKUP (DROP t1.stack_space t1.stack) (LENGTH ys − (i + (1 :num))) = SOME ys❲i❳ | SOME (Exception v10 y :α wordSem$result) => ∃(l0 :(num # α word_loc) list) (l :(num # α word_loc) list). state_rel ac k (0 :num) (0 :num) (push_locals l0 l s1) t1 (LASTN (s.handler + (1 :num)) lens) (0 :num) ∧ s1.locals = union (fromAList l) (fromAList l0) ∧ FLOOKUP t1.regs (1 :num) = SOME y | SOME (Break v12 :α wordSem$result) => state_rel ac k f f' s1 t1 lens (0 :num) | SOME (Continue v13 :α wordSem$result) => state_rel ac k f f' s1 t1 lens (0 :num) | SOME (TimeOut :α wordSem$result) => s1.ffi = t1.ffi ∧ s1.clock = t1.clock | SOME (NotEnoughSpace :α wordSem$result) => s1.ffi = t1.ffi ∧ s1.clock = t1.clock | SOME (FinalFFI v14 :α wordSem$result) => s1.ffi = t1.ffi ∧ s1.clock = t1.clock | SOME (Error :α wordSem$result) => s1.ffi = t1.ffi ∧ s1.clock = t1.clock
