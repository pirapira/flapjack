comp_correct_returning_full_typed=∀(values :num list) (s :(α, num # γ, 'ffi) state) (retCode :α prog) (names :sptree$num_set # sptree$num_set) (l2 :num) (l1 :num) (handler :(num # α prog # num # num) option) (dest :num option) (args :num list) (ac :α asm_config) (k :num) (f :num) (f' :num) (res :α wordSem$result option) (s1 :(α, num # γ, 'ffi) state) (t :(α, γ, 'ffi) stackSem$state) (bs :α word app_list) (n :num) (bs' :α word app_list) (n' :num) (sprog :α stackLang$prog) (lens :num list). (evaluate ((Call (SOME (values,names,retCode,l1,l2)) dest args handler :α prog),s) :α wordSem$result option # (α, num # γ, 'ffi) state) = (res,s1) ∧ res ≠ SOME (Error :α wordSem$result) ∧ state_rel ac k f f' s t lens (0 :num) ∧ post_alloc_conventions k (Call (SOME (values,names,retCode,l1,l2)) dest args handler :α prog) ∧ flat_exp_conventions (Call (SOME (values,names,retCode,l1,l2)) dest args handler :α prog) ∧ (comp ac F (Call (SOME (values,names,retCode,l1,l2)) dest args handler :α prog) (bs,n) (k,f,f') :α stackLang$prog # α word app_list # num) = (sprog,bs',n') ∧ LENGTH (append bs) ≤ n ∧ n − LENGTH (append bs) ≤ LENGTH t.bitmaps ∧ append bs' ≼ DROP (n − LENGTH (append bs)) t.bitmaps ∧ get_labels sprog ⊆ loc_check t.code ∧ max_var (Call (SOME (values,names,retCode,l1,l2)) dest args handler :α prog) < (2 :num) * f' + (2 :num) * k ⇒ ∃(ck :num) (t1 :(α, γ, 'ffi) stackSem$state) (res1 :α stackSem$result option). (evaluate (sprog,t with clock := t.clock + ck) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = (res1,t1) ∧ if OPTION_MAP (compile_result :α wordSem$result -> α stackSem$result) res ≠ res1 then res1 = SOME (Halt (Word (2w :α word)) :α stackSem$result) ∧ t1.ffi.io_events ≼ s1.ffi.io_events ∧ the (s1.stack_limit + (1 :num)) s1.stack_max > s1.stack_limit else case res of (NONE :α wordSem$result option) => state_rel ac k f f' s1 t1 lens (0 :num) | SOME (Result v8 ys :α wordSem$result) => state_rel ac k (0 :num) (0 :num) s1 t1 lens (LENGTH ys − (k − (1 :num))) ∧ ∀(i :nu