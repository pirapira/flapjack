comp_correct_returning_induction_obligation=∀ret dest args handler s. (∀xs v3 args1 v10 prog ss v1 n v6 names v9 ret_handler v11 l1 l2 envs v5 s2 v8 x ys s1. get_vars args s = SOME xs ∧ ¬bad_dest_args dest args ∧ find_code dest (add_ret_loc ret xs) s.code s.stack_size = SOME v3 ∧ v3 = (args1,v10) ∧ v10 = (prog,ss) ∧ ret = SOME v1 ∧ v1 = (n,v6) ∧ v6 = (names,v9) ∧ v9 = (ret_handler,v11) ∧ v11 = (l1,l2) ∧ ¬(domain (FST names) = ∅ ∨ ¬ALL_DISTINCT n) ∧ cut_envs names s.locals = SOME envs ∧ s.clock ≠ 0 ∧ evaluate (prog,call_env args1 ss (push_env envs handler (dec_clock s))) = (v5,s2) ∧ v5 = SOME v8 ∧ v8 = Result x ys ∧ ¬(x ≠ Loc l1 l2 ∨ LENGTH ys ≠ LENGTH n) ∧ pop_env s2 = SOME s1 ∧ domain s1.locals = domain (FST envs) ∪ domain (SND envs) ⇒ ∀k f f' res s1' t bs n' bs' n'' sprog lens. evaluate (ret_handler,set_vars n ys s1) = (res,s1') ∧ res ≠ SOME Error ∧ state_rel ac k f f' (set_vars n ys s1) t lens 0 ∧ post_alloc_conventions k ret_handler ∧ flat_exp_conventions ret_handler ∧ comp ac F ret_handler (bs,n') (k,f,f') = (sprog,bs',n'') ∧ LENGTH (append bs) ≤ n' ∧ n' − LENGTH (append bs) ≤ LENGTH t.bitmaps ∧ append bs' ≼ DROP (n' − LENGTH (append bs)) t.bitmaps ∧ get_labels sprog ⊆ loc_check t.code ∧ max_var ret_handler < 2 * f' + 2 * k ⇒ ∃ck t1 res1. evaluate (sprog,t with clock := t.clock + ck) = (res1,t1) ∧ if OPTION_MAP compile_result res ≠ res1 then res1 = SOME (Halt (Word 2w)) ∧ t1.ffi.io_events ≼ s1'.ffi.io_events ∧ the (s1'.stack_limit + 1) s1'.stack_max > s1'.stack_limit else case res of NONE => state_rel ac k f f' s1' t1 lens 0 | SOME (Result v8 ys) => state_rel ac k 0 0 s1' t1 lens (LENGTH ys − (k − 1)) ∧ ∀i. i < LENGTH ys ⇒ if i + 1 < k then FLOOKUP t1.regs (i + 1) = SOME ys❲i❳ else LLOOKUP (DROP t1.stack_space t1.stack) (LENGTH ys − (i + 1)) = SOME ys❲i❳ | SOME (Exception v10 y) => ∃l0 l. state_rel ac k 0 0 (push_locals l0 l s1') t1 (LASTN ((set_vars n ys s1).handler + 1) lens) 0 ∧ s1'.locals = union (fromAList l) (fromAList l0) ∧ FLOOKUP t1.regs 1 = SOME y | S