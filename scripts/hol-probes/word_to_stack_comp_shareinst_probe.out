comp_correct_shareinst_full_statement=∀ac op v exp s k f f' res s1 t bs n bs' n' sprog lens. evaluate (ShareInst op v exp,s) = (res,s1) ∧ res ≠ SOME Error ∧ state_rel ac k f f' s t lens 0 ∧ post_alloc_conventions k (ShareInst op v exp) ∧ flat_exp_conventions (ShareInst op v exp) ∧ comp ac F (ShareInst op v exp) (bs,n) (k,f,f') = (sprog,bs',n') ∧ LENGTH (append bs) ≤ n ∧ n − LENGTH (append bs) ≤ LENGTH t.bitmaps ∧ append bs' ≼ DROP (n − LENGTH (append bs)) t.bitmaps ∧ get_labels sprog ⊆ loc_check t.code ∧ max_var (ShareInst op v exp) < 2 * f' + 2 * k ⇒ ∃ck t1 res1. evaluate (sprog,t with clock := t.clock + ck) = (res1,t1) ∧ if OPTION_MAP compile_result res ≠ res1 then res1 = SOME (Halt (Word 2w)) ∧ t1.ffi.io_events ≼ s1.ffi.io_events ∧ the (s1.stack_limit + 1) s1.stack_max > s1.stack_limit else case res of NONE => state_rel ac k f f' s1 t1 lens 0 | SOME (Result v8 ys) => state_rel ac k 0 0 s1 t1 lens (LENGTH ys − (k − 1)) ∧ ∀i. i < LENGTH ys ⇒ if i + 1 < k then FLOOKUP t1.regs (i + 1) = SOME ys❲i❳ else LLOOKUP (DROP t1.stack_space t1.stack) (LENGTH ys − (i + 1)) = SOME ys❲i❳ | SOME (Exception v10 y) => ∃l0 l. state_rel ac k 0 0 (push_locals l0 l s1) t1 (LASTN (s.handler + 1) lens) 0 ∧ s1.locals = union (fromAList l) (fromAList l0) ∧ FLOOKUP t1.regs 1 = SOME y | SOME (Break v12) => state_rel ac k f f' s1 t1 lens 0 | SOME (Continue v13) => state_rel ac k f f' s1 t1 lens 0 | SOME TimeOut => s1.ffi = t1.ffi ∧ s1.clock = t1.clock | SOME NotEnoughSpace => s1.ffi = t1.ffi ∧ s1.clock = t1.clock | SOME (FinalFFI v14) => s1.ffi = t1.ffi ∧ s1.clock = t1.clock | SOME Error => s1.ffi = t1.ffi ∧ s1.clock = t1.clock
comp_correct_shareinst_full_proved=T
comp_correct_shareinst_full_hypotheses=0
comp_correct_shareinst_whole_statement=∀v s op exp ac k f f' res s1 t bs n bs' n' sprog lens. evaluate (ShareInst op v exp,s) = (res,s1) ∧ res ≠ SOME Error ∧ state_rel ac k f f' s t lens 0 ∧ post_alloc_conventions k (ShareInst op v exp) ∧ flat_exp_conventions (ShareInst op v exp) ∧ comp ac F (ShareInst op v exp) (bs,n) (k,f,f') = (sprog,bs',n') ∧ LENGTH (append bs) ≤ n ∧ n − LENGTH (append bs) ≤ LENGTH t.bitmaps ∧ append bs' ≼ DROP (n − LENGTH (append bs)) t.bitmaps ∧ get_labels sprog ⊆ loc_check t.code ∧ max_var (ShareInst op v exp) < 2 * f' + 2 * k ⇒ ∃ck t1 res1. evaluate (sprog,t with clock := t.clock + ck) = (res1,t1) ∧ if OPTION_MAP compile_result res ≠ res1 then res1 = SOME (Halt (Word 2w)) ∧ t1.ffi.io_events ≼ s1.ffi.io_events ∧ the (s1.stack_limit + 1) s1.stack_max > s1.stack_limit else case res of NONE => state_rel ac k f f' s1 t1 lens 0 | SOME (Result v8 ys) => state_rel ac k 0 0 s1 t1 lens (LENGTH ys − (k − 1)) ∧ ∀i. i < LENGTH ys ⇒ if i + 1 < k then FLOOKUP t1.regs (i + 1) = SOME ys❲i❳ else LLOOKUP (DROP t1.stack_space t1.stack) (LENGTH ys − (i + 1)) = SOME ys❲i❳ | SOME (Exception v10 y) => ∃l0 l. state_rel ac k 0 0 (push_locals l0 l s1) t1 (LASTN (s.handler + 1) lens) 0 ∧ s1.locals = union (fromAList l) (fromAList l0) ∧ FLOOKUP t1.regs 1 = SOME y | SOME (Break v12) => state_rel ac k f f' s1 t1 lens 0 | SOME (Continue v13) => state_rel ac k f f' s1 t1 lens 0 | SOME TimeOut => s1.ffi = t1.ffi ∧ s1.clock = t1.clock | SOME NotEnoughSpace => s1.ffi = t1.ffi ∧ s1.clock = t1.clock | SOME (FinalFFI v14) => s1.ffi = t1.ffi ∧ s1.clock = t1.clock | SOME Error => s1.ffi = t1.ffi ∧ s1.clock = t1.clock
comp_correct_shareinst_whole_proved=T
comp_correct_shareinst_whole_hypotheses=0
comp_correct_shareinst_full_statement_typed=∀(ac :α asm_config) (op :memop) (v :num) (exp :α exp) (s :(α, num # γ, 'ffi) state) (k :num) (f :num) (f' :num) (res :α wordSem$result option) (s1 :(α, num # γ, 'ffi) state) (t :(α, γ, 'ffi) stackSem$state) (bs :α word app_list) (n :num) (bs' :α word app_list) (n' :num) (sprog :α stackLang$prog) (lens :num list). (evaluate (ShareInst op v exp,s) :α wordSem$result option # (α, num # γ, 'ffi) state) = (res,s1) ∧ res ≠ SOME (Error :α wordSem$result) ∧ state_rel ac k f f' s t lens (0 :num) ∧ post_alloc_conventions k (ShareInst op v exp) ∧ flat_exp_conventions (ShareInst op v exp) ∧ (comp ac F (ShareInst op v exp) (bs,n) (k,f,f') :α stackLang$prog # α word app_list # num) = (sprog,bs',n') ∧ LENGTH (append bs) ≤ n ∧ n − LENGTH (append bs) ≤ LENGTH t.bitmaps ∧ append bs' ≼ DROP (n − LENGTH (append bs)) t.bitmaps ∧ get_labels sprog ⊆ loc_check t.code ∧ max_var (ShareInst op v exp) < (2 :num) * f' + (2 :num) * k ⇒ ∃(ck :num) (t1 :(α, γ, 'ffi) stackSem$state) (res1 :α stackSem$result option). (evaluate (sprog,t with clock := t.clock + ck) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = (res1,t1) ∧ if OPTION_MAP (compile_result :α wordSem$result -> α stackSem$result) res ≠ res1 then res1 = SOME (Halt (Word (2w :α word)) :α stackSem$result) ∧ t1.ffi.io_events ≼ s1.ffi.io_events ∧ the (s1.stack_limit + (1 :num)) s1.stack_max > s1.stack_limit else case res of (NONE :α wordSem$result option) => state_rel ac k f f' s1 t1 lens (0 :num) | SOME (Result v8 ys :α wordSem$result) => state_rel ac k (0 :num) (0 :num) s1 t1 lens (LENGTH ys − (k − (1 :num))) ∧ ∀(i :num). i < LENGTH ys ⇒ if i + (1 :num) < k then FLOOKUP t1.regs (i + (1 :num)) = SOME ys❲i❳ else LLOOKUP (DROP t1.stack_space t1.stack) (LENGTH ys − (i + (1 :num))) = SOME ys❲i❳ | SOME (Exception v10 y :α wordSem$result) => ∃(l0 :(num # α word_loc) list) (l :(num # α word_loc) list). state_rel ac k (0 :num) (0 :num) (push_locals l0 l s1) t1 (LASTN (s.handler + (1 :num)) lens) (0 :num) ∧ s1.locals = union (fromAList l) (fromAList l0) ∧ FLOOKUP t1.regs (1 :num) = SOME y | SOME (Break v12 :α wordSem$result) => state_rel ac k f f' s1 t1 lens (0 :num) | SOME (Continue v13 :α wordSem$result) => state_rel ac k f f' s1 t1 lens (0 :num) | SOME (TimeOut :α wordSem$result) => s1.ffi = t1.ffi ∧ s1.clock = t1.clock | SOME (NotEnoughSpace :α wordSem$result) => s1.ffi = t1.ffi ∧ s1.clock = t1.clock | SOME (FinalFFI v14 :α wordSem$result) => s1.ffi = t1.ffi ∧ s1.clock = t1.clock | SOME (Error :α wordSem$result) => s1.ffi = t1.ffi ∧ s1.clock = t1.clock
state_rel_set_var_k_typed=(state_rel (ac :α asm_config) (k :num) (f :num) (f' :num) (s :(α, num # β, γ) state) (set_var (k + (1 :num)) (v :α word_loc) (t :(α, β, γ) stackSem$state)) (lens :num list) (extra :num) ⇔ state_rel ac k f f' s t lens extra) ∧ (state_rel ac k f f' s (set_var k v t) lens extra ⇔ state_rel ac k f f' s t lens extra)
word_exp_Op_SOME_Word_typed=(word_exp (s :(α, β, γ) state) (Op (op :binop) (wexps :α exp list)) :α word_loc option) = SOME (x :α word_loc) ⇒ ∃(w :α word). x = Word w
flat_exp_conventions_ShareInst_exp_simp_typed=flat_exp_conventions (ShareInst (op :memop) (v :num) (exp :α exp)) ⇒ (∃(ad :num). exp = (Var ad :α exp)) ∨ ∃(ad :num) (offset :α word). exp = Op Add [(Var ad :α exp); (Const offset :α exp)]
word_exp_Op_Add_0_typed=(word_exp (s :(α, β, γ) state) (exp :α exp) :α word_loc option) = SOME (Word (x :α word)) ⇔ (word_exp s (Op Add [exp; (Const (0w :α word) :α exp)]) :α word_loc option) = SOME (Word x)
evaluate_ShareInst_Var_eq_Op_Add_typed=(evaluate (ShareInst (op :memop) (v :num) (Var (ad :num) :α exp),(s :(α, β, γ) state)) :α wordSem$result option # (α, β, γ) state) = (evaluate (ShareInst op v (Op Add [(Var ad :α exp); (Const (0w :α word) :α exp)]),s) :α wordSem$result option # (α, β, γ) state)
share_load_lemma1_typed=(share_inst (op :memop) ((2 :num) * (v :num)) (ad' :α word) (s :(α, num # β, γ) state) :α wordSem$result option # (α, num # β, γ) state) = ((res :α wordSem$result option),(s1 :(α, num # β, γ) state)) ∧ state_rel (ac :α asm_config) (k :num) (f :num) (f' :num) s (t :(α, β, γ) stackSem$state) (lens :num list) (0 :num) ∧ v < f' + k ∧ k ≤ v ∧ (op = Load ∨ op = Load8 ∨ op = Load16 ∨ op = Load32) ∧ res ≠ SOME (Error :α wordSem$result) ⇒ ∃(t1 :(α, β, γ) stackSem$state). sh_mem_op op k ad' t = (OPTION_MAP (compile_result :α wordSem$result -> α stackSem$result) res,t1) ∧ ((∃(f :final_event). res = SOME (FinalFFI f :α wordSem$result) ∧ s1.ffi = t1.ffi ∧ s1.clock = t1.clock) ∨ res = (NONE :α wordSem$result option) ∧ state_rel ac k f f' s1 (t1 with stack := t1.stack❲t1.stack_space + (f + k − (v + (1 :num))) ↦ THE (FLOOKUP t1.regs k)❳) lens (0 :num) ∧ (∃(x :α word_loc). FLOOKUP t1.regs k = SOME x) ∧ t1.stack_space = t.stack_space ∧ LENGTH t1.stack = LENGTH t.stack)
share_load_lemma2_typed=(share_inst (op :memop) ((2 :num) * (v :num)) (ad' :α word) (s :(α, num # β, γ) state) :α wordSem$result option # (α, num # β, γ) state) = ((res :α wordSem$result option),(s1 :(α, num # β, γ) state)) ∧ state_rel (ac :α asm_config) (k :num) (f :num) (f' :num) s (t :(α, β, γ) stackSem$state) (lens :num list) (0 :num) ∧ v < k ∧ (op = Load ∨ op = Load8 ∨ op = Load16 ∨ op = Load32) ∧ res ≠ SOME (Error :α wordSem$result) ⇒ ∃(t1 :(α, β, γ) stackSem$state). sh_mem_op op v ad' t = (OPTION_MAP (compile_result :α wordSem$result -> α stackSem$result) res,t1) ∧ ((∃(f :final_event). res = SOME (FinalFFI f :α wordSem$result) ∧ s1.ffi = t1.ffi ∧ s1.clock = t1.clock) ∨ res = (NONE :α wordSem$result option) ∧ state_rel ac k f f' s1 t1 lens (0 :num))
share_store_lemma1_typed=(share_inst (op :memop) ((2 :num) * (v :num)) (ad' :α word) (s :(α, num # β, γ) state) :α wordSem$result option # (α, num # β, γ) state) = ((res :α wordSem$result option),(s1 :(α, num # β, γ) state)) ∧ state_rel (ac :α asm_config) (k :num) (f :num) (f' :num) s (t :(α, β, γ) stackSem$state) (lens :num list) (0 :num) ∧ ¬(v < k) ∧ (op = Store ∨ op = Store8 ∨ op = Store16 ∨ op = Store32) ∧ res ≠ SOME (Error :α wordSem$result) ⇒ ∃(t1 :(α, β, γ) stackSem$state). sh_mem_op op (k + (1 :num)) ad' (t with regs := t.regs⟨k + (1 :num) ↦ t.stack❲t.stack_space + (f + k − (v + (1 :num)))❳⟩) = (OPTION_MAP (compile_result :α wordSem$result -> α stackSem$result) res,t1) ∧ ((∃(fv :final_event). res = SOME (FinalFFI fv :α wordSem$result) ∧ s1.ffi = t1.ffi ∧ s1.clock = t1.clock) ∨ res = (NONE :α wordSem$result option) ∧ state_rel ac k f f' s1 t1 lens (0 :num))
share_store_lemma2_typed=(share_inst (op :memop) ((2 :num) * (v :num)) (ad' :α word) (s :(α, num # β, γ) state) :α wordSem$result option # (α, num # β, γ) state) = ((res :α wordSem$result option),(s1 :(α, num # β, γ) state)) ∧ state_rel (ac :α asm_config) (k :num) (f :num) (f' :num) s (t :(α, β, γ) stackSem$state) (lens :num list) (0 :num) ∧ v < k ∧ (op = Store ∨ op = Store8 ∨ op = Store16 ∨ op = Store32) ∧ res ≠ SOME (Error :α wordSem$result) ⇒ ∃(t1 :(α, β, γ) stackSem$state). sh_mem_op op v ad' t = (OPTION_MAP (compile_result :α wordSem$result -> α stackSem$result) res,t1) ∧ ((∃(fv :final_event). res = SOME (FinalFFI fv :α wordSem$result) ∧ s1.ffi = t1.ffi ∧ s1.clock = t1.clock) ∨ res = (NONE :α wordSem$result option) ∧ state_rel ac k f f' s1 t1 lens (0 :num))
evaluate_ShareInst_Load_typed=(evaluate (ShareInst (op :memop) ((2 :num) * (v :num)) (Op Add [(Var ((2 :num) * (ad :num)) :α exp); (Const (offset :α word) :α exp)]),(s :(α, num # β, γ) state)) :α wordSem$result option # (α, num # β, γ) state) = ((res :α wordSem$result option),(s1 :(α, num # β, γ) state)) ∧ res ≠ SOME (Error :α wordSem$result) ∧ state_rel (ac :α asm_config) (k :num) (f :num) (f' :num) s (t :(α, β, γ) stackSem$state) (lens :num list) (0 :num) ∧ v < f' + k ∧ ad < f' + k ∧ (op = Load ∨ op = Load8 ∨ op = Load16 ∨ op = Load32) ⇒ ∃(ck :num) (t1 :(α, β, γ) stackSem$state). (evaluate (wShareInst op ((2 :num) * v) (Addr ((2 :num) * ad) offset) (k,f,f'),t with clock := ck + t.clock) :α stackSem$result option # (α, β, γ) stackSem$state) = (OPTION_MAP (compile_result :α wordSem$result -> α stackSem$result) res,t1) ∧ ((∃(fv :final_event). res = SOME (FinalFFI fv :α wordSem$result) ∧ s1.ffi = t1.ffi ∧ s1.clock = t1.clock) ∨ res = (NONE :α wordSem$result option) ∧ state_rel ac k f f' s1 t1 lens (0 :num))
evaluate_ShareInst_Store_typed=(evaluate (ShareInst (op :memop) ((2 :num) * (v :num)) (Op Add [(Var ((2 :num) * (ad :num)) :α exp); (Const (offset :α word) :α exp)]),(s :(α, num # β, γ) state)) :α wordSem$result option # (α, num # β, γ) state) = ((res :α wordSem$result option),(s1 :(α, num # β, γ) state)) ∧ state_rel (ac :α asm_config) (k :num) (f :num) (f' :num) s (t :(α, β, γ) stackSem$state) (lens :num list) (0 :num) ∧ v < f' + k ∧ ad < f' + k ∧ res ≠ SOME (Error :α wordSem$result) ∧ (op = Store ∨ op = Store8 ∨ op = Store16 ∨ op = Store32) ⇒ ∃(ck :num) (t1 :(α, β, γ) stackSem$state). (evaluate (wShareInst op ((2 :num) * v) (Addr ((2 :num) * ad) offset) (k,f,f'),t with clock := ck + t.clock) :α stackSem$result option # (α, β, γ) stackSem$state) = (OPTION_MAP (compile_result :α wordSem$result -> α stackSem$result) res,t1) ∧ ((∃(fv :final_event). res = SOME (FinalFFI fv :α wordSem$result) ∧ s1.ffi = t1.ffi ∧ s1.clock = t1.clock) ∨ res = (NONE :α wordSem$result option) ∧ state_rel ac k f f' s1 t1 lens (0 :num))
evaluate_ShareInst_correct_lemma_typed=(evaluate (ShareInst (op :memop) ((2 :num) * (v :num)) (Op Add [(Var ((2 :num) * (ad :num)) :α exp); (Const (offset :α word) :α exp)]),(s :(α, num # β, γ) state)) :α wordSem$result option # (α, num # β, γ) state) = ((res :α wordSem$result option),(s1 :(α, num # β, γ) state)) ∧ res ≠ SOME (Error :α wordSem$result) ∧ state_rel (ac :α asm_config) (k :num) (f :num) (f' :num) s (t :(α, β, γ) stackSem$state) (lens :num list) (0 :num) ∧ v < f' + k ∧ ad < f' + k ⇒ ∃(ck :num) (t1 :(α, β, γ) stackSem$state). (evaluate (wShareInst op ((2 :num) * v) (Addr ((2 :num) * ad) offset) (k,f,f'),t with clock := ck + t.clock) :α stackSem$result option # (α, β, γ) stackSem$state) = (OPTION_MAP (compile_result :α wordSem$result -> α stackSem$result) res,t1) ∧ (res = (NONE :α wordSem$result option) ∧ state_rel ac k f f' s1 t1 lens (0 :num) ∨ ∃(fv :final_event). res = SOME (FinalFFI fv :α wordSem$result) ∧ s1.ffi = t1.ffi ∧ s1.clock = t1.clock)
