fpToInt_typed=∀(lens :num list) (k :num) (input :num) (f' :num) (f :num) (destination :num) (ac :α asm_config) (s :(α, num # β, γ) state) (t :(α, β, γ) stackSem$state) (s' :(α, num # β, γ) state). inst (FP (FPToInt destination input) :α inst) s = SOME s' ∧ every_var_inst is_phy_var (FP (FPToInt destination input) :α inst) ∧ max_var_inst (FP (FPToInt destination input) :α inst) < (2 :num) * f' + (2 :num) * k ∧ inst_arg_convention (FP (FPToInt destination input) :α inst) ∧ state_rel ac k f f' s t lens (0 :num) ⇒ ∃(t' :(α, β, γ) stackSem$state). (evaluate (wInst (FP (FPToInt destination input) :α inst) (k,f,f'),t) :α stackSem$result option # (α, β, γ) stackSem$state) = ((NONE :α stackSem$result option),t') ∧ state_rel ac k f f' s' t' lens (0 :num) ∧ LENGTH t'.stack = LENGTH t.stack ∧ t'.stack_space = t.stack_space
fpToInt_proved=T
fpToInt_hypotheses=0
