memoryWhole_typed=∀(memory_value_register :num) (memory_opcode :memop) (memory_offset :α word) (memory_base :num) (lens :num list) (k :num) (f' :num) (f :num) (ac :α asm_config) (s :(α, num # β, γ) state) (t :(α, β, γ) stackSem$state) (s' :(α, num # β, γ) state). inst (Mem memory_opcode memory_value_register (Addr memory_base memory_offset)) s = SOME s' ∧ every_var_inst is_phy_var (Mem memory_opcode memory_value_register (Addr memory_base memory_offset)) ∧ max_var_inst (Mem memory_opcode memory_value_register (Addr memory_base memory_offset)) < (2 :num) * f' + (2 :num) * k ∧ inst_arg_convention (Mem memory_opcode memory_value_register (Addr memory_base memory_offset)) ∧ state_rel ac k f f' s t lens (0 :num) ⇒ ∃(t' :(α, β, γ) stackSem$state). (evaluate (wInst (Mem memory_opcode memory_value_register (Addr memory_base memory_offset)) (k,f,f'),t) :α stackSem$result option # (α, β, γ) stackSem$state) = ((NONE :α stackSem$result option),t') ∧ state_rel ac k f f' s' t' lens (0 :num) ∧ LENGTH t'.stack = LENGTH t.stack ∧ t'.stack_space = t.stack_space
