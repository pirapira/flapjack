shiftReg_typed=∀(shift_operator :ast$shift) (shift_input :num) (shift_destination :num) (shift_amount :num) (lens :num list) (k :num) (f' :num) (f :num) (ac :α asm_config) (s :(α, num # β, γ) state) (t :(α, β, γ) stackSem$state) (s' :(α, num # β, γ) state). inst (Arith (Shift shift_operator shift_destination shift_input (Reg shift_amount :α reg_imm) :α arith) :α inst) s = SOME s' ∧ every_var_inst is_phy_var (Arith (Shift shift_operator shift_destination shift_input (Reg shift_amount :α reg_imm) :α arith) :α inst) ∧ max_var_inst (Arith (Shift shift_operator shift_destination shift_input (Reg shift_amount :α reg_imm) :α arith) :α inst) < (2 :num) * f' + (2 :num) * k ∧ inst_arg_convention (Arith (Shift shift_operator shift_destination shift_input (Reg shift_amount :α reg_imm) :α arith) :α inst) ∧ state_rel ac k f f' s t lens (0 :num) ⇒ ∃(t' :(α, β, γ) stackSem$state). (evaluate (wInst (Arith (Shift shift_operator shift_destination shift_input (Reg shift_amount :α reg_imm) :α arith) :α inst) (k,f,f'),t) :α stackSem$result option # (α, β, γ) stackSem$state) = ((NONE :α stackSem$result option),t') ∧ state_rel ac k f f' s' t' lens (0 :num) ∧ LENGTH t'.stack = LENGTH t.stack ∧ t'.stack_space = t.stack_space
shiftReg_proved=T
shiftReg_hypotheses=0
shiftImm_typed=∀(shift_operator :ast$shift) (shift_input :num) (shift_destination :num) (shift_amount :α word) (lens :num list) (k :num) (f' :num) (f :num) (ac :α asm_config) (s :(α, num # β, γ) state) (t :(α, β, γ) stackSem$state) (s' :(α, num # β, γ) state). inst (Arith (Shift shift_operator shift_destination shift_input (Imm shift_amount) :α arith) :α inst) s = SOME s' ∧ every_var_inst is_phy_var (Arith (Shift shift_operator shift_destination shift_input (Imm shift_amount) :α arith) :α inst) ∧ max_var_inst (Arith (Shift shift_operator shift_destination shift_input (Imm shift_amount) :α arith) :α inst) < (2 :num) * f' + (2 :num) * k ∧ inst_arg_convention (Arith (Shift shift_operator shift_destination shift_input (Imm shift_amount) :α arith) :α inst) ∧ state_rel ac k f f' s t lens (0 :num) ⇒ ∃(t' :(α, β, γ) stackSem$state). (evaluate (wInst (Arith (Shift shift_operator shift_destination shift_input (Imm shift_amount) :α arith) :α inst) (k,f,f'),t) :α stackSem$result option # (α, β, γ) stackSem$state) = ((NONE :α stackSem$result option),t') ∧ state_rel ac k f f' s' t' lens (0 :num) ∧ LENGTH t'.stack = LENGTH t.stack ∧ t'.stack_space = t.stack_space
shiftImm_proved=T
