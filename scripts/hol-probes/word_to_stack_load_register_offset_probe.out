loadReg1Offset_typed=∀(x :(num # num) list) (w :α word) (t :(α, γ, 'ffi) stackSem$state) (s :(α, num # γ, 'ffi) state) (r' :num) (r :num) (lens :num list) (k :num) (f' :num) (f :num) (c :α word) (ac :α asm_config). wReg1 r (k,f,f') = (x,r') ∧ EVEN r ∧ (word_exp s (Op Add [(Var r :α exp); (Const c :α exp)]) :α word_loc option) = SOME (Word w) ∧ state_rel ac k f f' s t lens (0 :num) ⇒ ∃(t' :(α, γ, 'ffi) stackSem$state). (evaluate (wStackLoad x (Skip :α stackLang$prog),t) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = ((NONE :α stackSem$result option),t') ∧ t.clock = t'.clock ∧ state_rel ac k f f' s t' lens (0 :num) ∧ LENGTH t'.stack = LENGTH t.stack ∧ t'.stack_space = t.stack_space ∧ r' ≠ k + (1 :num) ∧ (word_exp t' (Op Add [(Var r' :α exp); (Const c :α exp)]) :α word option) = SOME w
loadReg1Offset_proved=T
loadReg1Offset_hypotheses=0
