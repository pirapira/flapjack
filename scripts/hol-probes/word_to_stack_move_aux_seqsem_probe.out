moveAuxSeqsem_statement=∀lens k f' f ac ms s t r. state_rel ac k f f' s t lens 0 ∧ (∀i v. r (SOME i) = SOME v ⇔ get_var (2 * i) s = SOME v) ∧ (∀v. r NONE = SOME v ⇒ get_var (k + 1) t = SOME v) ∧ IS_SOME (get_vars (MAP ($* 2 ∘ THE) (FILTER IS_SOME (MAP SND ms))) s) ∧ (case find_index NONE (MAP SND ms) 0 of NONE => T | SOME i => case find_index NONE (MAP FST ms) 0 of NONE => IS_SOME (r NONE) | SOME j => i ≤ j ⇒ IS_SOME (r NONE)) ∧ EVERY (λ(x,y). ∀a. x = SOME a ∨ y = SOME a ⇒ a < f' + k) ms ∧ ALL_DISTINCT (FILTER IS_SOME (MAP FST ms)) ⇒ ∃t'. evaluate (wMoveAux (MAP (format_var k ## format_var k) ms) (k,f,f'),t) = (NONE,t') ∧ state_rel ac k f f' (set_vars (MAP ($* 2 ∘ THE) (FILTER IS_SOME (MAP FST (REVERSE ms)))) (MAP THE (MAP (seqsem ms r) (FILTER IS_SOME (MAP FST (REVERSE ms))))) s) t' lens 0 ∧ LENGTH t'.stack = LENGTH t.stack ∧ t'.stack_space = t.stack_space
moveAuxSeqsem_proved=T
moveAuxSeqsem_hypotheses=0
moveAuxSeqsem_typed=∀(lens :num list) (k :num) (f' :num) (f :num) (ac :α asm_config) (ms :(num option # num option) list) (s :(α, num # β, γ) state) (t :(α, β, γ) stackSem$state) (r :num option -> α word_loc option). state_rel ac k f f' s t lens (0 :num) ∧ (∀(i :num) (v :α word_loc). r (SOME i) = SOME v ⇔ (get_var ((2 :num) * i) s :α word_loc option) = SOME v) ∧ (∀(v :α word_loc). r (NONE :num option) = SOME v ⇒ (get_var (k + (1 :num)) t :α word_loc option) = SOME v) ∧ IS_SOME (get_vars (MAP ($* (2 :num) ∘ (THE :num option -> num)) (FILTER (IS_SOME :num option -> bool) (MAP (SND :num option # num option -> num option) ms))) s :α word_loc list option) ∧ (case find_index (NONE :num option) (MAP (SND :num option # num option -> num option) ms) (0 :num) of (NONE :num option) => T | SOME i => case find_index (NONE :num option) (MAP (FST :num option # num option -> num option) ms) (0 :num) of (NONE :num option) => IS_SOME (r (NONE :num option)) | SOME j => i ≤ j ⇒ IS_SOME (r (NONE :num option))) ∧ EVERY (λ((x :num option),(y :num option)). ∀(a :num). x = SOME a ∨ y = SOME a ⇒ a < f' + k) ms ∧ ALL_DISTINCT (FILTER (IS_SOME :num option -> bool) (MAP (FST :num option # num option -> num option) ms)) ⇒ ∃(t' :(α, β, γ) stackSem$state). (evaluate ((wMoveAux (MAP (format_var k ## format_var k) ms) (k,f,f') :α stackLang$prog),t) :α stackSem$result option # (α, β, γ) stackSem$state) = ((NONE :α stackSem$result option),t') ∧ state_rel ac k f f' (set_vars (MAP ($* (2 :num) ∘ (THE :num option -> num)) (FILTER (IS_SOME :num option -> bool) (MAP (FST :num option # num option -> num option) (REVERSE ms)))) (MAP (THE :α word_loc option -> α word_loc) (MAP (seqsem ms r) (FILTER (IS_SOME :num option -> bool) (MAP (FST :num option # num option -> num option) (REVERSE ms))))) s) t' lens (0 :num) ∧ LENGTH t'.stack = LENGTH t.stack ∧ t'.stack_space = t.stack_space
