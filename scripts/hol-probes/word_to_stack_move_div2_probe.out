times2_div2_statement=∀moves. windmill moves ∧ EVERY EVEN (MAP FST moves) ∧ EVERY EVEN (MAP SND moves) ⇒ MAP ($* 2 ∘ THE) (FILTER IS_SOME (MAP FST (parmove (MAP (DIV2 ## DIV2) moves)))) = MAP THE (FILTER IS_SOME (MAP FST (parmove moves)))
times2_div2_proved=T
times2_div2_hypotheses=0
parsem_parmove_div2_statement=∀r moves. windmill moves ∧ EVERY EVEN (MAP FST moves) ∧ EVERY EVEN (MAP SND moves) ⇒ MAP (parsem (MAP (SOME ## SOME) (MAP (DIV2 ## DIV2) moves)) r) (FILTER IS_SOME (MAP FST (parmove (MAP (DIV2 ## DIV2) moves)))) = MAP (parsem (MAP (SOME ## SOME) moves) (r ∘ OPTION_MAP DIV2)) (FILTER IS_SOME (MAP FST (parmove moves)))
parsem_parmove_div2_proved=T
parsem_parmove_div2_hypotheses=0
times2_div2_typed=∀(moves :(num # num) list). windmill moves ∧ EVERY EVEN (MAP (FST :num # num -> num) moves) ∧ EVERY EVEN (MAP (SND :num # num -> num) moves) ⇒ MAP ($* (2 :num) ∘ (THE :num option -> num)) (FILTER (IS_SOME :num option -> bool) (MAP (FST :num option # num option -> num option) (parmove (MAP (DIV2 ## DIV2) moves)))) = MAP (THE :num option -> num) (FILTER (IS_SOME :num option -> bool) (MAP (FST :num option # num option -> num option) (parmove moves)))
parsem_parmove_div2_typed=∀(r :num option -> α) (moves :(num # num) list). windmill moves ∧ EVERY EVEN (MAP (FST :num # num -> num) moves) ∧ EVERY EVEN (MAP (SND :num # num -> num) moves) ⇒ MAP (parsem (MAP ((SOME :num -> num option) ## (SOME :num -> num option)) (MAP (DIV2 ## DIV2) moves)) r) (FILTER (IS_SOME :num option -> bool) (MAP (FST :num option # num option -> num option) (parmove (MAP (DIV2 ## DIV2) moves)))) = MAP (parsem (MAP ((SOME :num -> num option) ## (SOME :num -> num option)) moves) (r ∘ OPTION_MAP DIV2)) (FILTER (IS_SOME :num option -> bool) (MAP (FST :num option # num option -> num option) (parmove moves)))
