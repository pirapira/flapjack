wMoveSingle_statement=∀y x v t s lens k f' f ac. state_rel ac k f f' s t lens 0 ∧ (case x of NONE => get_var (k + 1) t = SOME v | SOME x => get_var (x * 2) s = SOME v) ∧ (case y of NONE => T | SOME x => x < f' + k) ⇒ ∃t'. evaluate (wMoveSingle (format_var k y,format_var k x) (k,f,f'),t) = (NONE,t') ∧ state_rel ac k f f' (case y of NONE => s | SOME y => set_var (y * 2) v s) t' lens 0 ∧ (y = NONE ⇒ get_var (k + 1) t' = SOME v) ∧ (y ≠ NONE ⇒ get_var (k + 1) t' = get_var (k + 1) t) ∧ LENGTH t'.stack = LENGTH t.stack ∧ t'.stack_space = t.stack_space
wMoveSingle_proved=T
wMoveSingle_hypotheses=0
wMoveSingle_typed=∀(y :num option) (x :num option) (v :α word_loc) (t :(α, β, γ) stackSem$state) (s :(α, num # β, γ) state) (lens :num list) (k :num) (f' :num) (f :num) (ac :α asm_config). state_rel ac k f f' s t lens (0 :num) ∧ (case x of (NONE :num option) => (get_var (k + (1 :num)) t :α word_loc option) = SOME v | SOME x => (get_var (x * (2 :num)) s :α word_loc option) = SOME v) ∧ (case y of (NONE :num option) => T | SOME x => x < f' + k) ⇒ ∃(t' :(α, β, γ) stackSem$state). (evaluate ((wMoveSingle (format_var k y,format_var k x) (k,f,f') :α stackLang$prog),t) :α stackSem$result option # (α, β, γ) stackSem$state) = ((NONE :α stackSem$result option),t') ∧ state_rel ac k f f' (case y of (NONE :num option) => s | SOME y => set_var (y * (2 :num)) v s) t' lens (0 :num) ∧ (y = (NONE :num option) ⇒ (get_var (k + (1 :num)) t' :α word_loc option) = SOME v) ∧ (y ≠ (NONE :num option) ⇒ (get_var (k + (1 :num)) t' :α word_loc option) = (get_var (k + (1 :num)) t :α word_loc option)) ∧ LENGTH t'.stack = LENGTH t.stack ∧ t'.stack_space = t.stack_space
