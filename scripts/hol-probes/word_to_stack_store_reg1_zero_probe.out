storeReg1Zero_typed=∀(x :(num # num) list) (t_stack_space :num) (t :(α, γ, 'ffi) stackSem$state) (s :(α, num # γ, 'ffi) state) (r' :num) (r :num) (lens :num list) (k :num) (f' :num) (f :num) (c1 :α word_loc) (c :α word_loc) (ac :α asm_config) (LENGTH_t_stack :num). wReg1 r (k,f,f') = (x,r') ∧ EVEN r ∧ r < (2 :num) * f' + (2 :num) * k ∧ state_rel ac k f f' s t lens (0 :num) ∧ LENGTH t.stack = LENGTH_t_stack ∧ t.stack_space = t_stack_space ⇒ ∃(t' :(α, γ, 'ffi) stackSem$state). (evaluate (wStackStore x (Skip :α stackLang$prog),set_var (0 :num) c1 (set_var r' c t)) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = ((NONE :α stackSem$result option),t') ∧ state_rel ac k f f' (set_var (0 :num) c1 (set_var r c s)) t' lens (0 :num) ∧ LENGTH t'.stack = LENGTH_t_stack ∧ t'.stack_space = t_stack_space
storeReg1Zero_proved=T
storeReg1Zero_hypotheses=0
