storeReg2Continuation_typed=∀(x :(num # num) list) (t_stack_space :num) (t :(α, γ, 'ffi) stackSem$state) (s :(α, num # γ, 'ffi) state) (r' :num) (r :num) (lens :num list) (kont :α stackLang$prog) (k :num) (f' :num) (f :num) (c :α word_loc) (ac :α asm_config) (LENGTH_t_stack :num). wReg2 r (k,f,f') = (x,r') ∧ EVEN r ∧ r < (2 :num) * f' + (2 :num) * k ∧ (∃(t' :(α, γ, 'ffi) stackSem$state). (evaluate (kont,t) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = ((NONE :α stackSem$result option),set_var r' c t') ∧ state_rel ac k f f' s t' lens (0 :num) ∧ LENGTH t'.stack = LENGTH_t_stack ∧ t'.stack_space = t_stack_space) ⇒ ∃(t' :(α, γ, 'ffi) stackSem$state). (evaluate (Seq kont (wStackStore x (Skip :α stackLang$prog)),t) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = ((NONE :α stackSem$result option),t') ∧ state_rel ac k f f' (set_var r c s) t' lens (0 :num) ∧ LENGTH t'.stack = LENGTH_t_stack ∧ t'.stack_space = t_stack_space
storeReg2Continuation_proved=T
storeReg2Continuation_hypotheses=0
writeReg2Sequence_typed=∀(t :(α, β, γ) stackSem$state) (r :num) (k :num) (g :num -> α stackLang$prog) (f' :num) (f :num). (evaluate (wRegWrite2 g r (k,f,f'),t) :α stackSem$result option # (α, β, γ) stackSem$state) = (let ((l :(num # num) list),(n :num)) = wReg2 r (k,f,f') in (evaluate (Seq (g n) (wStackStore l (Skip :α stackLang$prog)),t) :α stackSem$result option # (α, β, γ) stackSem$state))
writeReg2Sequence_proved=T
writeReg2Sequence_hypotheses=0
