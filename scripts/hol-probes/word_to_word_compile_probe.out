compile_single=∀two_reg_arith reg_count alg c name_num arg_count prog col_opt.
  compile_single two_reg_arith reg_count alg c
    ((name_num,arg_count,prog),col_opt) =
  (let
     prog = compile_exp prog;
     maxv = max_var prog + 1;
     inst_prog = inst_select c maxv prog;
     ssa_prog = full_ssa_cc_trans arg_count inst_prog;
     rm_ssa_prog = remove_dead_prog ssa_prog;
     cse_prog = word_common_subexp_elim rm_ssa_prog;
     cp_prog = copy_prop cse_prog;
     two_prog = three_to_two_reg_prog two_reg_arith cp_prog;
     unreach_prog = remove_unreach two_prog;
     rm_prog = remove_dead_prog unreach_prog;
     reg_prog = word_alloc name_num c alg reg_count rm_prog col_opt
   in
     (name_num,arg_count,reg_prog))
compile_single_typed=∀(two_reg_arith :bool) (reg_count :num) (alg :num) (c :α asm_config)
    (name_num :num) (arg_count :num) (prog :α prog)
    (col_opt :num sptree$num_map option).
  compile_single two_reg_arith reg_count alg c
    ((name_num,arg_count,prog),col_opt) =
  (let
     (prog :α prog) = compile_exp prog;
     (maxv :num) = max_var prog + (1 :num);
     (inst_prog :α prog) = inst_select c maxv prog;
     (ssa_prog :α prog) = full_ssa_cc_trans arg_count inst_prog;
     (rm_ssa_prog :α prog) = remove_dead_prog ssa_prog;
     (cse_prog :α prog) = word_common_subexp_elim rm_ssa_prog;
     (cp_prog :α prog) = copy_prop cse_prog;
     (two_prog :α prog) = three_to_two_reg_prog two_reg_arith cp_prog;
     (unreach_prog :α prog) = remove_unreach two_prog;
     (rm_prog :α prog) = remove_dead_prog unreach_prog;
     (reg_prog :α prog) = word_alloc name_num c alg reg_count rm_prog col_opt
   in
     (name_num,arg_count,reg_prog))
compile_single_hypotheses=0
full_compile_single=∀two_reg_arith reg_count alg c p.
  full_compile_single two_reg_arith reg_count alg c p =
  (let
     (name_num,arg_count,reg_prog) =
       compile_single two_reg_arith reg_count alg c p
   in
     (name_num,arg_count,remove_must_terminate reg_prog))
full_compile_single_typed=∀(two_reg_arith :bool) (reg_count :num) (alg :num) (c :α asm_config)
    (p :(num # num # α prog) # num sptree$num_map option).
  full_compile_single two_reg_arith reg_count alg c p =
  (let
     ((name_num :num),(arg_count :num),(reg_prog :α prog)) =
       compile_single two_reg_arith reg_count alg c p
   in
     (name_num,arg_count,remove_must_terminate reg_prog))
full_compile_single_hypotheses=0
compile=∀word_conf asm_conf progs.
  compile word_conf asm_conf progs =
  (let
     (two_reg_arith,reg_count) =
       (asm_conf.two_reg_arith,
        asm_conf.reg_count − (5 + LENGTH asm_conf.avoid_regs));
     (n_oracles,col) = next_n_oracle (LENGTH progs) word_conf.col_oracle;
     progs = ZIP (progs,n_oracles)
   in
     (col,
      MAP
        (full_compile_single two_reg_arith reg_count word_conf.reg_alg
           asm_conf) progs))
compile_typed=∀(word_conf :config) (asm_conf :α asm_config)
    (progs :(num # num # α prog) list).
  compile word_conf asm_conf progs =
  (let
     ((two_reg_arith :bool),(reg_count :num)) =
       (asm_conf.two_reg_arith,
        asm_conf.reg_count − ((5 :num) + LENGTH asm_conf.avoid_regs));
     ((n_oracles :num sptree$num_map option list),
        (col :num sptree$num_map option list)) =
       next_n_oracle (LENGTH progs) word_conf.col_oracle;
     (progs :((num # num # α prog) # num sptree$num_map option) list) =
       ZIP (progs,n_oracles)
   in
     (col,
      MAP
        (full_compile_single two_reg_arith reg_count word_conf.reg_alg
           asm_conf) progs))
compile_hypotheses=0
