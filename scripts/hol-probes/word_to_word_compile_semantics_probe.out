panLang_compile_word_to_word_thm_statement=code_rel st.code l ∧ no_install_code st.code ∧ no_alloc_code st.code ∧ no_mt_code st.code ∧ domain st.code = domain l ∧ gc_fun_const_ok st.gc_fun ⇒ ∃perm' clk. (let prog = Call NONE (SOME start) [0] NONE; (res,rst) = evaluate (prog,st with permute := perm') in if res = SOME Error then T else (let (res1,rst1) = evaluate (prog,st with code := l) in res1 = res ∧ rst1.clock = rst.clock ∧ rst1.ffi = rst.ffi ∧ rst1.stack_max = rst.stack_max))
panLang_compile_word_to_word_thm_hypotheses=0
panLang_compile_word_to_word_thm_typed=(code_rel (st :(α, γ, 'ffi) state).code (l :(num # α prog) sptree$num_map) :bool) ∧ no_install_code st.code ∧ no_alloc_code st.code ∧ no_mt_code st.code ∧ (domain st.code :num -> bool) = (domain l :num -> bool) ∧ gc_fun_const_ok st.gc_fun ⇒ ∃(perm' :num -> num -> num) (clk :β). (let (prog :α prog) = (Call (NONE :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) (SOME (start :num)) [(0 :num)] (NONE :(num # α prog # num # num) option) :α prog); ((res :α result option),(rst :(α, γ, 'ffi) state)) = evaluate (prog,st with permute := perm') in if res = SOME (Error :α result) then T else (let ((res1 :α result option),(rst1 :(α, γ, 'ffi) state)) = evaluate (prog,st with code := l) in res1 = res ∧ rst1.clock = rst.clock ∧ rst1.ffi = rst.ffi ∧ rst1.stack_max = rst.stack_max))
word_to_word_compile_semantics_statement=compile wconf acomf wprog0 = (col,wprog) ∧ gc_fun_const_ok s.gc_fun ∧ no_install_code (fromAList wprog0) ∧ no_alloc_code (fromAList wprog0) ∧ no_install_code s.code ∧ no_alloc_code s.code ∧ no_mt_code (fromAList wprog0) ∧ ALL_DISTINCT (MAP FST wprog0) ∧ s.stack = [] ∧ t.code = fromAList wprog ∧ lookup 0 t.locals = SOME (Loc 1 0) ∧ t = s with code := t.code ∧ s.code = fromAList wprog0 ∧ semantics s start ≠ Fail ⇒ semantics s start = semantics t start
word_to_word_compile_semantics_hypotheses=0
word_to_word_compile_semantics_typed=compile (wconf :config) (acomf :α asm_config) (wprog0 :(num # num # α prog) list) = ((col :num sptree$num_map option list),(wprog :(num # num # α prog) list)) ∧ gc_fun_const_ok (s :(α, β, 'ffi) state).gc_fun ∧ no_install_code (fromAList wprog0) ∧ no_alloc_code (fromAList wprog0) ∧ no_install_code s.code ∧ no_alloc_code s.code ∧ no_mt_code (fromAList wprog0) ∧ ALL_DISTINCT (MAP (FST :num # num # α prog -> num) wprog0) ∧ s.stack = ([] :α stack_frame list) ∧ (t :(α, β, 'ffi) state).code = fromAList wprog ∧ (lookup (0 :num) t.locals :α word_loc option) = SOME (Loc (1 :num) (0 :num) :α word_loc) ∧ t = s with code := t.code ∧ s.code = fromAList wprog0 ∧ semantics s (start :num) ≠ Fail ⇒ semantics s start = semantics t start
