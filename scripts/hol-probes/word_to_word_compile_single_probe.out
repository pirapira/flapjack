FST_compile_single_statement=FST (compile_single a b c d e) = FST (FST e)
FST_compile_single_hypotheses=0
FST_compile_single_typed=FST (compile_single (a :bool) (b :num) (c :num) (d :α asm_config) (e :(num # num # α prog) # num sptree$num_map option)) = FST (FST e)
compile_single_lem_statement=∀prog n st. domain st.locals = set (even_list n) ∧ gc_fun_const_ok st.gc_fun ⇒ ∃perm'. (let (res,rst) = evaluate (prog,st with permute := perm'); (_0',_1,cprog) = compile_single t k a c ((name,n,prog),col) in if res = SOME Error then T else (let (res',rcst) = evaluate (cprog,st) in res = res' ∧ word_state_eq_rel rst rcst ∧ case res of NONE => T | SOME (Result v8 v9) => rst.locals = rcst.locals | SOME (Exception v10 v11) => rst.locals = rcst.locals | SOME (Break v12) => T | SOME (Continue v13) => T | SOME TimeOut => rst.locals = rcst.locals | SOME NotEnoughSpace => rst.locals = rcst.locals | SOME (FinalFFI v14) => rst.locals = rcst.locals | SOME Error => rst.locals = rcst.locals))
compile_single_lem_hypotheses=0
compile_single_lem_typed=∀(prog :α prog) (n :num) (st :(α, β, γ) state). (domain st.locals :num -> bool) = set (even_list n) ∧ gc_fun_const_ok st.gc_fun ⇒ ∃(perm' :num -> num -> num). (let ((res :α result option),(rst :(α, β, γ) state)) = evaluate (prog,st with permute := perm'); ((_0' :num),(_1 :num),(cprog :α prog)) = compile_single (t :bool) (k :num) (a :num) (c :α asm_config) (((name :num),n,prog),(col :num sptree$num_map option)) in if res = SOME (Error :α result) then T else (let ((res' :α result option),(rcst :(α, β, γ) state)) = evaluate (cprog,st) in res = res' ∧ word_state_eq_rel rst rcst ∧ case res of (NONE :α result option) => T | SOME (Result v8 v9) => rst.locals = rcst.locals | SOME (Exception v10 v11) => rst.locals = rcst.locals | SOME (Break v12 :α result) => T | SOME (Continue v13 :α result) => T | SOME (TimeOut :α result) => rst.locals = rcst.locals | SOME (NotEnoughSpace :α result) => rst.locals = rcst.locals | SOME (FinalFFI v14 :α result) => rst.locals = rcst.locals | SOME (Error :α result) => rst.locals = rcst.locals))
