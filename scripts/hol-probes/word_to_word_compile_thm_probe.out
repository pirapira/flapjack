compile_word_to_word_thm_statement=code_rel st.code l ∧ domain st.code = domain l ∧ st.compile = (λconf progs. cc conf (MAP (λp. full_compile_single tt kk aa co (p,NONE)) progs)) ∧ coracle = (I ## MAP (λp. full_compile_single tt kk aa co (p,NONE))) ∘ st.compile_oracle ∧ gc_fun_const_ok st.gc_fun ⇒ ∃perm' clk. (let prog = Call NONE (SOME start) [0] NONE; (res,rst) = evaluate (prog,st with permute := perm') in if res = SOME Error then T else (let (res1,rst1) = evaluate (prog,st with <|code := map (I ## remove_must_terminate) l; clock := st.clock + clk; termdep := 0; compile := cc; compile_oracle := coracle|>) in res1 = res ∧ rst1.clock = rst.clock ∧ rst1.ffi = rst.ffi ∧ rst1.stack_max = rst.stack_max))
compile_word_to_word_thm_hypotheses=0
compile_word_to_word_thm_typed=(code_rel (st :(α, γ, 'ffi) state).code (l :(num # α prog) sptree$num_map) :bool) ∧ (domain st.code :num -> bool) = (domain l :num -> bool) ∧ st.compile = (λ(conf :γ) (progs :(num # num # α prog) list). (cc :γ -> (num # num # α prog) list -> (word8 list # α word list # γ) option) conf (MAP (λ(p :num # num # α prog). full_compile_single (tt :bool) (kk :num) (aa :num) (co :α asm_config) (p,(NONE :num sptree$num_map option))) progs)) ∧ (coracle :num -> γ # (num # num # α prog) list) = ((I :γ -> γ) ## MAP (λ(p :num # num # α prog). full_compile_single tt kk aa co (p,(NONE :num sptree$num_map option)))) ∘ st.compile_oracle ∧ gc_fun_const_ok st.gc_fun ⇒ ∃(perm' :num -> num -> num) (clk :num). (let (prog :α prog) = (Call (NONE :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) (SOME (start :num)) [(0 :num)] (NONE :(num # α prog # num # num) option) :α prog); ((res :α result option),(rst :(α, γ, 'ffi) state)) = evaluate (prog,st with permute := perm') in if res = SOME (Error :α result) then T else (let ((res1 :α result option),(rst1 :(α, γ, 'ffi) state)) = evaluate (prog,st with <|code := (map ((I :num -> num) ## (remove_must_terminate :α prog -> α prog)) l :(num # α prog) sptree$num_map); clock := st.clock + clk; termdep := (0 :num); compile := cc; compile_oracle := coracle|>) in res1 = res ∧ rst1.clock = rst.clock ∧ rst1.ffi = rst.ffi ∧ rst1.stack_max = rst.stack_max))
