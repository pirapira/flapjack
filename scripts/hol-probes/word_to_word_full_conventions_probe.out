fullConventions_typed=∀(wc :config) (p :(num # num # α prog) list) (ac :α asm_config). EVERY (λ((_0 :num),(_1 :num),(prg :α prog)). no_share_inst prg ∨ ac.ISA ≠ Ag32) p ⇒ (let ((_2 :num sptree$num_map option list),(progs :(num # num # α prog) list)) = compile wc ac p in MAP (FST :num # num # α prog -> num) progs = MAP (FST :num # num # α prog -> num) p ∧ LIST_REL (labels_rel :(num # num) list -> (num # num) list -> bool) (MAP ((extract_labels :α prog -> (num # num) list) ∘ (SND :num # α prog -> α prog) ∘ (SND :num # num # α prog -> num # α prog)) p) (MAP ((extract_labels :α prog -> (num # num) list) ∘ (SND :num # α prog -> α prog) ∘ (SND :num # num # α prog -> num # α prog)) progs) ∧ EVERY (λ((n :num),(m :num),(prog :α prog)). flat_exp_conventions prog ∧ post_alloc_conventions (ac.reg_count − ((5 :num) + LENGTH ac.avoid_regs)) prog ∧ (EVERY (λ((n :num),(m :num),(prog :α prog)). every_inst (inst_ok_less ac) prog) p ∧ addr_offset_ok ac (0w :α word) ∧ hw_offset_ok ac (0w :α word) ∧ byte_offset_ok ac (0w :α word) ⇒ full_inst_ok_less ac prog) ∧ (ac.two_reg_arith ⇒ every_inst (two_reg_inst :α inst -> bool) prog) ∧ (no_share_inst prog ∨ ac.ISA ≠ Ag32)) progs)
fullConventions_proved=T
fullConventions_hypotheses=0
