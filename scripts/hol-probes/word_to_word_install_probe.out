compile_single_correct_typed=∀(tt :bool) (kk :num) (co :α asm_config) (aa :num) (prog :α prog) (st :(α, γ, 'ffi) state) (l :(num # α prog) sptree$num_map) (coracle :num -> γ # (num # num # α prog) list) (cc :γ -> (num # num # α prog) list -> (word8 list # α word list # γ) option). (code_rel st.code l :bool) ∧ (domain st.code :num -> bool) = (domain l :num -> bool) ∧ st.compile = (λ(conf :γ) (progs :(num # num # α prog) list). cc conf (MAP (λ(p :num # num # α prog). compile_single tt kk aa co (p,(NONE :num sptree$num_map option))) progs)) ∧ coracle = ((I :γ -> γ) ## MAP (λ(p :num # num # α prog). compile_single tt kk aa co (p,(NONE :num sptree$num_map option)))) ∘ st.compile_oracle ∧ gc_fun_const_ok st.gc_fun ⇒ ∃(perm' :num -> num -> num). (let ((res :α result option),(rst :(α, γ, 'ffi) state)) = evaluate (prog,st with permute := perm') in if res = SOME (Error :α result) then T else (let ((res1 :α result option),(rst1 :(α, γ, 'ffi) state)) = evaluate (prog,st with <|code := l; compile_oracle := coracle; compile := cc|>) in res1 = res ∧ (code_rel rst.code rst1.code :bool) ∧ (domain rst.code :num -> bool) = (domain rst1.code :num -> bool) ∧ rst1 = rst with <|code := rst1.code; compile_oracle := ((I :γ -> γ) ## MAP (λ(p :num # num # α prog). compile_single tt kk aa co (p,(NONE :num sptree$num_map option)))) ∘ rst.compile_oracle; compile := cc|>))
