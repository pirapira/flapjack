no_install_no_alloc_compile_single_correct_statement=∀prog st l. code_rel st.code l ∧ no_install prog ∧ no_alloc prog ∧ no_install_code st.code ∧ no_alloc_code st.code ∧ domain st.code = domain l ∧ gc_fun_const_ok st.gc_fun ⇒ ∃perm'. (let (res,rst) = evaluate (prog,st with permute := perm') in if res = SOME Error then T else (let (res1,rst1) = evaluate (prog,st with code := l) in res1 = res ∧ code_rel rst.code rst1.code ∧ domain rst.code = domain rst1.code ∧ rst1 = rst with code := rst1.code))
no_install_no_alloc_compile_single_correct_hypotheses=0
no_install_no_alloc_compile_single_correct_typed=∀(prog :α prog) (st :(α, γ, 'ffi) state) (l :(num # α prog) sptree$num_map). (code_rel st.code l :bool) ∧ no_install prog ∧ no_alloc prog ∧ no_install_code st.code ∧ no_alloc_code st.code ∧ (domain st.code :num -> bool) = (domain l :num -> bool) ∧ gc_fun_const_ok st.gc_fun ⇒ ∃(perm' :num -> num -> num). (let ((res :α result option),(rst :(α, γ, 'ffi) state)) = evaluate (prog,st with permute := perm') in if res = SOME (Error :α result) then T else (let ((res1 :α result option),(rst1 :(α, γ, 'ffi) state)) = evaluate (prog,st with code := l) in res1 = res ∧ (code_rel rst.code rst1.code :bool) ∧ (domain rst.code :num -> bool) = (domain rst1.code :num -> bool) ∧ rst1 = rst with code := rst1.code))
